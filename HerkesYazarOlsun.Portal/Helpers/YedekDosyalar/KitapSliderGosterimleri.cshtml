@*@model List<HerkesYazarOlsun.Model.Entity.Books>*@
@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS;
@using HerkesYazarOlsun.Model.Utils;
@using HerkesYazarOlsun.Model.ViewModel;


<!-- Carousel container -->
<div id="my-pics-@Model.Tip" class="carousel slide" data-ride="carousel" style="width:%100;margin:10px auto;background-color:aliceblue;">

    @{
        int sliderdaGosterilecekKayit = 3;
        int kalan = (@Model.BooksList.Count() % sliderdaGosterilecekKayit);
        int bolum = (@Model.BooksList.Count() / sliderdaGosterilecekKayit);

        int sliderSayisi = (@kalan == 0) ? bolum : (@bolum + 1);
    }

    <!-- Indicators -->
    <ol class="carousel-indicators">
        @for (int i = 0; i < @sliderSayisi; i++)
        {
            @if (i == 0)
            {
                <li data-target="#my-pics-@Model.Tip" data-slide-to="@i" class="active"></li>
            }
            else
            {
                <li data-target="#my-pics-@Model.Tip" data-slide-to="@i"></li>
            }
        }
        @*<li data-target="#my-pics" data-slide-to="0" class="active"></li>
        <li data-target="#my-pics" data-slide-to="1"></li>
        <li data-target="#my-pics" data-slide-to="2"></li>*@
    </ol>

    <!-- Content -->
    <div class="carousel-inner" role="listbox">

        @for (int i = 0; i < @sliderSayisi; i++)
        {
            @if (i == 0)
            {
                <div class="item active">

                    @foreach (var itemVeriler in @Model.BooksList.Where(p => p.ID <= sliderdaGosterilecekKayit).ToList())
                    {
                        var vmBook = ObjectMapper.Map(@itemVeriler, new VM_BOOKS());
                        vmBook.Tip = Model.Tip;
                        @Html.Partial("_CarouselItem",@vmBook)

                    }
                </div>
            }
            else
            {
                <div class="item">

                    @foreach (var itemVeriler in @Model.BooksList.Where(p => p.ID > sliderdaGosterilecekKayit).ToList())
                    {
                        var vmBook = ObjectMapper.Map(@itemVeriler, new VM_BOOKS());
                        vmBook.Tip = Model.Tip;
                        @Html.Partial("_CarouselItem",@vmBook)

                    }
                </div>
            }

        }
    </div>

    <!-- Previous/Next controls -->
    <a class="left carousel-control" href="#my-pics-@Model.Tip" role="button" data-slide="prev">
        <span class="icon-prev" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>

    </a>
    <a class="right carousel-control" href="#my-pics-@Model.Tip" role="button" data-slide="next">
        <span class="icon-next" aria-hidden="true"></span>
        <span class="sr-only">Next</span>

    </a>

    <br />
    <div class="alert alert-success" id="basarili-@Model.Tip" style="display:none;">
        <strong>Başarılı!</strong> Favorilere Eklendi
        <button type="button" class="btn btn-info" onclick='Kapat("@Model.Tip")'>Kapat</button>
    </div>
    <br />
    <div class="alert alert-info" id="uyari-@Model.Tip" style="display:none;">
        <strong>Bilgi!</strong> Favorilere Eklenemedi
        <button type="button" class="btn btn-info" onclick='Kapat("@Model.Tip")'>Kapat</button>
    </div>
    <br />

</div>

<script>
    function Kapat(tip) {
        $("#basarili-" + tip).css("display", "none");
        $("#uyari-" + tip).css("display", "none");
    }
</script>
