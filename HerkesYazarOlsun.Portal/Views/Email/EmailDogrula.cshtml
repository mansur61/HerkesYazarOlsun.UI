@{
    ViewData["Title"] = "Email Doğrulama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 
@using HerkesYazarOlsun.Portal.Controllers;

 

@{
    string tip = "email";
}
<input type="hidden" id="tip" value="@tip" />

@section Styles {
    <link href="~/lib/css/giris_kayit_dogrulama.css" rel="stylesheet" />
}

<section >
    <div class="container">
        <div class="row"> 
            <div class="col-lg-6 mb-4">
                <div id="title-container">
                    <h4>Herkes Yazar Olsun' da,  Email Doğrulama İşlemi</h4>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="login_form_inner register_form_inner">
                    <h3>Email Doğrulama</h3>


                    <div id="register_form" class="row login_form">
                        <div class="col-md-12 form-group">
                            <input type="text" class="form-control" id="email" name="EMAIL" placeholder="Email Adres"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Email Adres'">
                        </div>

                        <div class="col-md-12 form-group">
                            <button type="submit" class="auth-primary-btn flex-fill text-center" onclick="EmailGonder()">Email Gönder</button>
                        </div>
                        <div id="loading" style="display: none; text-align: center;">
                            <img src="https://i.gifer.com/ZZ5H.gif" alt="loading..." style="width: 50px; height: 50px;" />
                        </div>
                    </div>
                    @Html.Partial("_AlertMesaj", @tip)

                </div>
            </div>
        </div>
    </div>
</section>

<div id="otp"></div>

<div style="height:150px"></div>

<script>

    function EmailGonder() {

        var email = $("#email").val();
        var tip = $("#tip").val();
                 $("#loading").css("display", "block");
        $.post("@Url.Action(nameof(EmailController.Gonder), "Email")", {
            "kime": email
        }, function (data) {
            console.log(data);
            if (data.state == 1) {
                        $("#loading").css("display","none");
                $.get("@Url.Action(nameof(EmailController.EmailOtp), "Email")", {
                    "email": email,
                    "emailKod": data.message
                }, function (data) {

                    $("#otp").html(data);
                    $("#modalOtp").modal("show");

                });

            }
            else if (data.state == 3) {
                $("#loading").css("display","none");
                $("#bilgi-" + tip).css("display", "block");
                $("#bilgi-" + tip + " #mesaj").html(data.message);

                $("#basarili-" + tip).css("display", "none");
                $("#uyari-" + tip).css("display", "none");
            }
            else {
                $("#loading").css("display","none");
                $("#uyari-" + tip).css("display", "block");
                $("#bilgi-" + tip).css("display", "none");
                $("#basarili-" + tip).css("display", "none");
                $("#uyari-" + tip + " #mesaj").html(data.message);
            }

        });


    }

</script>