                                </label>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br />
    <div class="text-right mt-3">
        <button type="button" class="btn btn-primary">Değişiklikleri Kaydet</button>&nbsp;
        <button type="button" class="btn btn-info">Kaydetme</button>
    </div>
    <br />
</div>

<script>
    function RenkSec(id) {
        var nodeNameProperty = RenkAdiGetir(id);
        $("#seciim").html(nodeNameProperty);
       
    }
    function RenkAdiGetir(id){
        var nodeNameProperty = "";
        const nodeList = document.querySelectorAll(".renkler");
        for (let i = 0; i < nodeList.length; i++) {
            if (id == i) {
                nodeNameProperty = nodeList[i].name; 
            }
        }
        return nodeNameProperty;
    }


</script>