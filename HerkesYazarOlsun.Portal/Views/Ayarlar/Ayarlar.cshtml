@{
    ViewData["Title"] = "Ayarlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_AYARLAR
@using HerkesYazarOlsun.Portal.Controllers;

<input type="hidden" id="UserDetailId" value="@(Model.UserDetail?.ID ?? 0)" />
<input type="hidden" id="ProfileId" value="@(Model.Profile?.ID ?? 0)" />
<input type="hidden" id="BildirimId" value="@(Model.Bildirim?.ID ?? 0)" />
<input type="hidden" id="loginId" value="@Model.LoginUserId" />

@{
    string tip = "ayarlar";
}
<input type="hidden" id="tip" value="@tip" />

<style>
    /* TAB RENKLERİ */
    .nav-tabs .nav-link {
        color: #495057;
        font-weight: 500;
        border: none;
        border-left: 4px solid transparent;
        border-radius: 0;
    }

    .nav-tabs .nav-link.active {
        background-color: #f8f9fa;
        color: #6fcf97;
        border-left-color: #6fcf97;
        font-weight: 600;
    }

    /* BUTONLAR */
    .btn-green {
        background-color: #6fcf97;
        border-color: #6fcf97;
        color: #fff;
        font-weight: 600;
    }

    .btn-green:hover {
        background-color: #5bbf87;
        border-color: #5bbf87;
    }

    .btn-gray {
        background-color: #adb5bd;
        border-color: #adb5bd;
        color: #fff;
        font-weight: 600;
    }

    .btn-gray:hover {
        background-color: #9aa1a8;
        border-color: #9aa1a8;
    }

    .profile-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 12px;
    }

    .profile-card img {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
    }
</style>

<div class="container my-5">
<form id="form-ayarlar" enctype="multipart/form-data">

<h2 class="fw-bold mb-4">Ayarlar</h2>

<div class="card shadow-sm border-0">
<div class="row g-0">

<!-- SOL TAB -->
<div class="col-md-3 border-end">
<ul class="nav nav-tabs flex-column" role="tablist">

<li class="nav-item">
<a class="nav-link active" data-bs-toggle="tab" href="#general">Genel Ayarlar</a>
</li>

<li class="nav-item">
<a class="nav-link" data-bs-toggle="tab" href="#profil">Profil Ayarları</a>
</li>

<li class="nav-item">
<a class="nav-link" data-bs-toggle="tab" href="#links">Linkler</a>
</li>

<li class="nav-item">
<a class="nav-link" data-bs-toggle="tab" href="#info">Detay Bilgiler</a>
</li>

<li class="nav-item">
<a class="nav-link" data-bs-toggle="tab" href="#notifications">Bildirimler</a>
</li>

</ul>
</div>

<!-- SAĞ İÇERİK -->
<div class="col-md-9">
<div class="tab-content p-4">

<!-- GENEL -->
<div class="tab-pane fade show active" id="general">
<div class="mb-3">
<label class="form-label">Kullanıcı Adı</label>
<input type="text" class="form-control" id="username" value="@Model.User?.USERNAME">
</div>

<div class="mb-3">
<label class="form-label">Adınız</label>
<input type="text" class="form-control" id="name" value="@Model.User?.NAME">
</div>

<div class="mb-3">
<label class="form-label">E-posta</label>
<input type="email" class="form-control" id="email" value="@Model.User?.EMAIL">
</div>

<hr>

<div class="mb-3">
<label class="form-label">Yeni Şifre</label>
<input type="password" class="form-control" id="yeniSifre">
</div>

<div class="mb-3">
<label class="form-label">Yeni Şifre Tekrar</label>
<input type="password" class="form-control" id="yeniSifreTekrar">
</div>
</div>

<!-- PROFİL -->
<div class="tab-pane fade" id="profil">
<div class="profile-card mb-4">
<img src="@(!string.IsNullOrEmpty(Model?.Profile?.ProfilResimURl)
? $"https://herkesyazarolsun.com.tr/Belgeler/{Model.Profile.ProfilResimURl}"
: Url.Content("~/lib/img/user.png"))" />
<strong>@Model.User?.USERNAME</strong>
</div>

<input type="file" class="form-control mb-3" id="proFotoSec">
</div>

<!-- LINKLER -->
<div class="tab-pane fade" id="links">
<input class="form-control mb-3" placeholder="Twitter" id="twt" value="@Model.UserDetail?.TwitterLink">
<input class="form-control mb-3" placeholder="Facebook" id="fcb" value="@Model.UserDetail?.FacebookLink">
<input class="form-control mb-3" placeholder="LinkedIn" id="lkn" value="@Model.UserDetail?.LinkedinLink">
<input class="form-control mb-3" placeholder="Instagram" id="inst" value="@Model.UserDetail?.InstagramLink">
</div>

<!-- DETAY -->
<div class="tab-pane fade" id="info">
<textarea class="form-control mb-3" rows="4" id="hakkinda">@Model.UserDetail?.HAKKINDA</textarea>
<input class="form-control mb-3" placeholder="Telefon" id="tel" value="@Model.UserDetail?.TEL">
<input class="form-control mb-3" placeholder="Web Site" id="website" value="@Model.UserDetail?.WebSite">
</div>

<!-- BİLDİRİMLER -->
<div class="tab-pane fade" id="notifications">
<div class="form-check mb-2">
<input class="form-check-input" type="checkbox" id="yorumchk" checked>
<label class="form-check-label">Yorum bildirimleri</label>
</div>

<div class="form-check">
<input class="form-check-input" type="checkbox" id="takipchk">
<label class="form-check-label">Takip bildirimleri</label>
</div>
</div>

</div>
</div>

</div>
</div>

@Html.Partial("_AlertMesaj", tip)

<div class="d-flex justify-content-end gap-2 mt-4">
<button type="submit" class="btn btn-green px-4">Kaydet</button>
<button type="button" class="btn btn-gray px-4" onclick="Kaydetme()">Kaydetme</button>
</div>

<div id="loading-full" class="text-center mt-3" style="display:none;">
<img src="https://i.gifer.com/ZZ5H.gif" width="40">
</div>

</form>
</div>

<script src="~/js/general.js"></script>
