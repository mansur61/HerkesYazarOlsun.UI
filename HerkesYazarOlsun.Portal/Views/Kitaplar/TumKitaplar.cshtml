@{
    ViewData["Title"] = "Tüm Kitaplar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;
@using HerkesYazarOlsun.Portal.Controllers; 
@using HerkesYazarOlsun.Model.ViewModel;


@if (ViewBag.DevamEdenKitaplar != null && ViewBag.DevamEdenKitaplar)
{
    <h3 style="margin: 50px auto;">Devam Eden Kitaplar</h3>
}
else if (ViewBag.FavoriKitaplar != null && ViewBag.FavoriKitaplar)
{
    <h3 style="margin: 50px auto;">Favori Kitaplar</h3>
}
else if (ViewBag.YayinlananKitaplar != null && ViewBag.YayinlananKitaplar)
{
    <h3 style="margin: 50px auto;">Yayınlanan Kitaplar</h3>
}
else if (ViewBag.BitenKitaplar != null && ViewBag.BitenKitaplar)
{
    <h3 style="margin: 50px auto;">Biten Kitaplar</h3>
}
else
{
    <h3 style="margin: 50px auto;">Tüm Kitaplar</h3>
}

<h6><span>@Model.VMBooksList.Count()</span> Kayıt Var </h6>

<hr />
 
@Html.Partial("_KitapFiltreleme")

@{
    Model.Tip = "tumkitaplar";
}

@Html.Partial("_AlertMesaj",@Model.Tip)
 


<div id="tumkitaplar">
    @{
        Model.kitapSliderYometimAdi = "tumkitaplar";
    }

    @Html.Partial("_KitapSliderItemYonetimleri", Model)

    @{
        int perSlide = Model.sliderdaGosterilecekKayit  ?? ViewBag.SliderdaGosterilecekKayit;

        int total = Model.VMBooksList.Count;
        int sliderSayisi = (int)Math.Ceiling((double)total / perSlide);
        var butons = new  VM_PAGINATION_BUTTON{
                sliderSayisi = sliderSayisi,
                
        };
        Model.vM_PAGINATION_BUTTONS = butons;
    }
    

    @for (int i = 0; i < sliderSayisi; i++)
    {
        var slideModel = new VM_BOOKS_DETAIL
        {
            VMBooksList = Model.VMBooksList
                .Skip(i * perSlide)
                .Take(perSlide)
                .ToList(),
            Tip = Model.Tip,
            isAnaSayfa = Model.isAnaSayfa
        };

        <div class="durum_@Model.vM_PAGINATION_BUTTONS.sliderSayiDivTagName"
            data-index="@i"
            style="display:@(i == 0 ? "block" : "none");">

            <div class="row g-3">
                @foreach (var kitap in slideModel.VMBooksList)
                {
                    <div class="col-md-4 col-sm-6">
                        @Html.Partial("_KitaplarItem", kitap)
                    </div>
                }
            </div>

        </div>
    }

    @Html.Partial("_PaginationButonlar", Model.vM_PAGINATION_BUTTONS)
</div>


<div id="arabutonfiltre"></div>

<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/nice-select/js/jquery.nice-select.min.js"></script>
<script src="~/lib/owlcarousel/dist/owl.carousel.min.js"></script>
<script src="~/js/kitap-arama.js"></script>

<script>

    $("#arabutonfiltre").css("display", "none");
    function Ara() {

        var listelenecek_kayit_sayisi = $("#kayit_sayisi").val();
        console.log(" kitap arama "+listelenecek_kayit_sayisi);
        if(listelenecek_kayit_sayisi == 0){
            return ;
        }


        if (listelenecek_kayit_sayisi == null) {
            listelenecek_kayit_sayisi = 10;
        }

        var kitap_ara = $("#kitap_ara").val();

        $.post("@Url.Action(nameof(KitaplarController.AraButonFiltrelemeKitaplar), "Kitaplar")", {
            "listelenecek_kayit_sayisi": listelenecek_kayit_sayisi,
            "KITAP_ADI": kitap_ara
        }, function (data) {
            if (data) {
                $("#arabutonfiltre").html(data);
                $("#arabutonfiltre").css("display", "block");
                $("#tumkitaplar").css("display", "none");
                 

            } else {
                 
                $("#tumkitaplar").css("display", "block");
                $("#arabutonfiltre").css("display", "block");
            }

        });
    }

</script>





