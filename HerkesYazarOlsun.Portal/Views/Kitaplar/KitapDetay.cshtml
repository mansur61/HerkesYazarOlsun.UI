@{
    ViewData["Title"] = "Kitap Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;

@* @Html.Partial("_Navbar") *@


@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Model.ViewModel
@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}

@{
    bool kitapTamamlamaDurumu = @Model.isTamalama ?? false;
}

<br />

@if (Model != null)
{
    <div class="row">

        <div class="col-md-3">
            @if (@Model.BookModel?.ARKAKAPAKFOTOPATH == "-1")
            {

                <img src="/lib/img/stack-of-books.png" alt="Portfolio 1" style="height:300px" width="200" />
            }
            else
            {
                <img class="img-responsive" src="https://herkesyazarolsun.com.tr/Belgeler/@Model.BookModel.ARKAKAPAKFOTOPATH"
                     alt="Portfolio 1" style="height:300px">
            }

            @{
                Model.BookModel.Stars.isToplam = false;
            }
            <div style="margin-top:10px;text-align:center">
                @Html.Partial("_YildizGoster", @Model.BookModel.Stars)
            </div>

        </div>

        <div class="col-md-9">
            <h3><small>Kitabın Adı </small></h3>
            <small>@Model.BookModel.Name</small>
            <h3><small>Yazılma Tarihi</small></h3>
            <small>@Model.BookModel.CREATE_AT</small>
            <h3><small>Yazarı</small></h3>
            <p><small>@Model.BookModel.User.USERNAME</small></p>
            <h3>Kitap Özeti</h3>
            <p>
                @Html.Raw(Model.BookModel.ONSOZ)

                <br />

            </p>
            @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
            {
                <div class="col-md-12 text-right">
                    <button class="btn btn-warming"><a href="/Kitaplar/KitapGuncelleme?kitap_id=@StringCipher.Encrypt(@Model.BookModel.ID.ToString())">Kitabı Güncelle</a></button>
                    <button class="btn btn-ligth"><a href="/Kitaplar/KitapOku?kitap_id=@StringCipher.Encrypt(@Model.BookModel.ID.ToString())">Kitabı Oku</a></button>
                    @if (!kitapTamamlamaDurumu)
                    {
                        
                        <a class="btn btn-light"
                           href="/Kitaplar/KitapOlustur?kitap_id=@StringCipher.Encrypt(Model.BookModel.ID.ToString())&isYazmayaDevamEt=true&IlgiiSayfaSayisi=@Model.BookModel.BooksPageList?.Count">
                            Yazmaya Devam Et
                        </a>
                    }


                </div>
            }

        </div>

    </div>

    <br />
    @Html.Partial("_KitapDetayMesajBolumleri", @Model)

    <div style="height:150px;"></div>
}
else
{
    <div>Kitap Detay yok</div>
}


