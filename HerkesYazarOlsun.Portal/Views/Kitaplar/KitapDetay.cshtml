@{
    ViewData["Title"] = "Kitap Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAY;

@Html.Partial("_Navbar")

<br />
<br />

@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}

@{
    bool kitapTamamlamaDurumu = @Model.Vm_Book.isTamalama ?? false;
}

<br />

@if (Model != null)
{
    <div class="row">

        <div class="col-md-3">
            @*<img class="img-responsive" src="http://placehold.it/350x260" alt="Portfolio 1" style="height:300px">*@
            <img src="data:image;base64,@Model.Vm_Book.ONKAPAKFOTO" alt="Book Image" style="height:300px;width:215px">
            @{
                Model.Stars.isToplam = false;
            }
            <div style="margin-top:10px;text-align:center">
                @Html.Partial("_YildizGoster", @Model.Stars)
            </div>

        </div>

        <div class="col-md-9">
            <h3><small>Yazılma Tarihi</small></h3>
            <small>@Model.Vm_Book.CREATE_AT</small>
            <h3><small>Yazarı</small></h3>
            <p><small>Mansur Emin Kaya</small></p>
            <h3>Kitap Özeti</h3>
            <p>
                @Model.Vm_Book.ONSOZ

                Lorem Ipsum, dizgi ve baskı endüstrisinde kullanılan mıgır metinlerdir.
                Lorem Ipsum, adı bilinmeyen bir matbaacının bir hurufat numune kitabı oluşturmak üzere bir yazı galerisini alarak karıştırdığı
                1500'lerden beri endüstri standardı sahte metinler olarak kullanılmıştır. Beşyüz yıl boyunca varlığını sürdürmekle kalmamış,
                aynı zamanda pek değişmeden elektronik dizgiye de sıçramıştır. 1960'larda Lorem Ipsum pasajları da içeren Letraset yapraklarının
                yayınlanması ile ve yakın zamanda Aldus PageMaker gibi Lorem Ipsum sürümleri içeren masaüstü yayıncılık yazılımları ile popüler olmuştur.
            </p>
            @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
            {
                <div class="col-md-12 text-right">
                    <button class="btn btn-warming"><a href="/Kitaplar/KitapGuncelleme?kitap_id=@StringCipher.Encrypt(@Model.Vm_Book.ID.ToString())">Kitabı Güncelle</a></button>
                    <button class="btn btn-ligth"><a href="/Kitaplar/KitapOku?kitap_id=@StringCipher.Encrypt(@Model.Vm_Book.ID.ToString())">Kitabı Oku</a></button>
                    @if (!@kitapTamamlamaDurumu)
                    {
                        <button class="btn btn-ligth"><a href="/Kitaplar/KitapOlustur?ID=@Model.Vm_Book.ID">Yazmaya Devam Et</a></button>
                    }

                </div>
            }

        </div>
     
    </div>

    <br />
    @Html.Partial("_KitapDetayMesajBolumleri", @Model)

    <div style="height:150px;"></div>
}
else
{
    <div>Kitap Detay yok</div>
}


