@{
    ViewData["Title"] = "Kitap Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;

@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Model.ViewModel
@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
    bool kitapTamamlamaDurumu = Model?.isTamalama ?? false;
}
<div class="container-fluid pt-5">
<div class="container mt-4">

 <style>
    .ratio {
  position: relative;
  width: 100%;
}

.ratio::before {
  display: block;
  padding-top: var(--bs-aspect-ratio);
  content: "";
}

.ratio-3x4 {
  --bs-aspect-ratio: 133.333333%;
}

 </style>

@if (Model != null)
{
    <div class="row g-4 align-items-start">
<!-- 📕 Kitap Kapak -->
<div class="col-12 col-md-4 col-lg-3 text-center">
    <div class="card shadow-sm">

        @{
            var kapak = Model.BookModel?.ONKAPAKFOTOPATH?.Trim();
            var kapakUrl = (string.IsNullOrEmpty(kapak) || kapak == "-1")
                ? Url.Content("~/lib/img/stack-of-books.png")
                : $"https://herkesyazarolsun.com.tr/Belgeler/{kapak}";
        }

        <div style="
             width:100%;
             height:360px;
             background-image:url('@kapakUrl');
             background-size:cover;
             background-position:center;
             background-repeat:no-repeat;">
        </div>

        @{
            Model.BookModel.Stars.isToplam = false;
        }

        <div class="card-body text-center">
            @Html.Partial("_YildizGoster", Model.BookModel.Stars)
        </div>
    </div>
</div>




        <!-- 📘 Kitap Bilgileri -->
        <div class="col-12 col-md-8 col-lg-9">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h5 class="text-muted mb-1">Kitabın Adı</h5>
                    <h3 class="fw-bold">@Model.BookModel.Name</h3>

                    <hr />

                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <small class="text-muted">Yazılma Tarihi</small>
                            <div>@Model.BookModel.CREATE_AT</div>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted">Yazar</small>
                            <div>@Model.BookModel.User.USERNAME</div>
                        </div>
                    </div>

                    <h5 class="mt-3">Kitap Özeti</h5>
                    <p class="text-muted">
                        @Html.Raw(Model.BookModel.ONSOZ)
                    </p>

                    @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
                    {
                        <div class="d-flex flex-wrap gap-2 mt-4">

                            <a class="btn btn-warning"
                               href="/Kitaplar/KitapGuncelleme?kitap_id=@StringCipher.Encrypt(Model.BookModel.ID.ToString())">
                                Kitabı Güncelle
                            </a>

                            <a class="btn btn-primary"
                               href="/Kitaplar/KitapOku?kitap_id=@StringCipher.Encrypt(Model.BookModel.ID.ToString())">
                                Kitabı Oku
                            </a>

                            @if (!kitapTamamlamaDurumu)
                            {
                                <a class="btn btn-light border"
                                   href="/Kitaplar/KitapOlustur?kitap_id=@StringCipher.Encrypt(Model.BookModel.ID.ToString())&isYazmayaDevamEt=true&IlgiiSayfaSayisi=@Model.BookModel.BooksPageList?.Count">
                                    Yazmaya Devam Et
                                </a>
                            }
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

    <div class="mt-5">
        @Html.Partial("_KitapDetayMesajBolumleri", Model)
    </div>

    <div class="my-5"></div>
}
else
{
    <div class="alert alert-warning text-center">
        Kitap detayı bulunamadı.
    </div>
}

</div></div>
