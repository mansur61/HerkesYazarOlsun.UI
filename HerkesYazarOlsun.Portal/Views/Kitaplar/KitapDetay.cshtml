@{
    ViewData["Title"] = "Kitap Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="~/lib/bootstrap/dist/css/style_kitap_detay.css" rel="stylesheet" />
}

@Html.Partial("_Navbar")
<br />
<br />
@model HerkesYazarOlsun.Model.Entity.Books
<br />
<div class="row">

    <div class="col-md-5">
        <img class="img-responsive" src="~/lib/img/portfolio_1.png" alt="Portfolio 1">
    </div>
    <div class="col-md-2"></div>
    <div class="col-md-5">
        <h3><small>Yazılma Tarihi</small></h3>
        <small>@Model.CREATE_AT</small>
        <h3><small>Yazarı</small></h3>
        <p><small>Mansur Emin Kaya</small></p>
        <h3>Kitap Özeti</h3>
        <p>
            @Model.ONSOZ
        </p>

    </div>

    <div class="col-md-12 text-right">
        <button type="submit" value="submit" class="btn btn-ligth"><a href="/Kitaplar/KitapOku?kitapId=@Model.ID">Kitabı Oku</a></button>
        
    </div>

    

</div>

@Html.Partial("_KitapDetayMesajBolumleri",@Model)

