@{
    ViewData["Title"] = "Kitap Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAY;

@Html.Partial("_Navbar")

<br />
<br />

@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}

@{
    bool kitapTamamlamaDurumu = @Model.Vm_Book.isTamalama ?? false;
}

<br />

@if (Model != null)
{
    <div class="row" >

        <div class="col-md-3" >
            @*<img class="img-responsive" src="http://placehold.it/350x260" alt="Portfolio 1" style="height:300px">*@
            <img src="data:image;base64,@Model.Vm_Book.ONKAPAKFOTO" alt="Book Image" style="height:300px;width:215px">
            @{
                Model.Stars.isToplam = false;
            }
            <div style="margin-top:10px;text-align:center">
                @Html.Partial("_YildizGoster",@Model.Stars)
            </div>

        </div>

        <div class="col-md-5">
            <h3><small>Yazılma Tarihi</small></h3>
            <small>@Model.Vm_Book.CREATE_AT</small>
            <h3><small>Yazarı</small></h3>
            <p><small>Mansur Emin Kaya</small></p>
            <h3>Kitap Özeti</h3>
            <p>
                @Model.Vm_Book.ONSOZ

                Lorem Ipsum, dizgi ve baskı endüstrisinde kullanılan mıgır metinlerdir. 
                Lorem Ipsum, adı bilinmeyen bir matbaacının bir hurufat numune kitabı oluşturmak üzere bir yazı galerisini alarak karıştırdığı
                1500'lerden beri endüstri standardı sahte metinler olarak kullanılmıştır. Beşyüz yıl boyunca varlığını sürdürmekle kalmamış, 
                aynı zamanda pek değişmeden elektronik dizgiye de sıçramıştır. 1960'larda Lorem Ipsum pasajları da içeren Letraset yapraklarının 
                yayınlanması ile ve yakın zamanda Aldus PageMaker gibi Lorem Ipsum sürümleri içeren masaüstü yayıncılık yazılımları ile popüler olmuştur.
            </p>
            @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
            {
                <div class="col-md-12 text-right">
                    <button class="btn btn-warming"><a href="/Kitaplar/KitapGuncelleme?kitapId=@Model.Vm_Book.ID">Kitabı Güncelle</a></button>
                    <button class="btn btn-ligth"><a href="/Kitaplar/KitapOku?kitapId=@Model.Vm_Book.ID">Kitabı Oku</a></button>
                    @if (!@kitapTamamlamaDurumu)
                    {
                        <button class="btn btn-ligth"><a href="/Kitaplar/KitapOlustur?ID=@Model.Vm_Book.ID">Yazmaya Devam Et</a></button>
                    }

                </div>
            }
            
        </div>
        <!-- Bu yapıyı kaldıracağız Yyaına al butonu eklenecek yazarın yazdığı kitaplara -->
        <div class="col-md-4" style="background-color:lightgrey;border-radius:20px;display:none">
            <div>
                <p style="text-align:center;font-size:30px;margin-top:10px">
                    <i class="fa fa-bell" style="color:green"></i> <strong>TEBRİKLER</strong>
                    <i class="fa fa-bell" style="color:green"></i>
                </p>
                <div style="font-size:14px;">
                    <p>
                        <strong>Herkes Yazar Olsun</strong>' da emekleriniz hiçbir zaman boşa çıkmayacaktır.
                        Kitabınızı anlaşmalı olan tüm yayın evlerimizden birine indirimli olarak bizim aracılığımız ile yayınlama hakkı kazandınız.
                    </p>
                    <p>
                        Kitabınızı yayına almak istiyorsanız öncelikle <a href="/Home/Index#sponsorlar">Sponsorlar</a> bağlantısından sponsorlarımızı görebilir,
                        istediğiniz sponsoru inceleyerek belirleyebilirsiniz
                    </p>
                    <p>
                        Belirlediğiniz sponsorlarımız ile anlaşmalı indirimlerimizden anında faydalanabilirsiniz.
                        Bunu için yapmanız gereken <strong>Herkes Yazar Olsun</strong>'un belirlediği <span style="text-decoration:underline">sabit fiyatımızı</span> ödeme sayfasından
                        ödemeniz gerekmektedir.
                    </p>

                    <p>
                        Ödemeniz başarılı olması durumunda açılan ekranda belirlediğiniz sponsoru bizlere mail aracılığıyla iletmeniz gerekmektedir.
                    </p>
                    <p>
                        İlettiğiniz mail doğrultusunda sizlere <span style="text-decoration:underline">kitabınızın incelenip,sponsor kodu temin edilerek</span>  bu kod ile belirlediğiniz sponsorla yayın işlemlerini başlatabileceksiniz.

                    </p>
                    <p>
                        Sponsor kodunuz ve dataylı bilgilerinizi, bize ilettiğiniz mail adresinize 3 iş günü içinde iletilecektir.
                    </p>
                </div>

            </div>

            <div class="text-center" style="margin-top:10px;margin-bottom:10px">

                <button type="button" class="btn btn-light">  <a href="/OdemeSayfasi/Odeme">Ödeme Sayfasına Geç</a>  </button>
            </div>
        </div>

    </div>

  
        @Html.Partial("_KitapDetayMesajBolumleri",@Model)
   
    <div style="height:150px;"></div>
}
else
{
    <div>Kitap Detay yok</div>
}


