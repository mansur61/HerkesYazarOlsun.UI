
@model HerkesYazarOlsun.Model.ViewModel.VM_ALERT;
@using HerkesYazarOlsun.Portal.Controllers;

<div class="modal" id="modalAlert">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="d-flex justify-content-center align-items-center continer">
                <div class="card py-5 px-3" style="width:auto; margin:10px 10px;">
                    <h5 class="m-0">@Model.AlertBaslik</h5>
                    <span class="mobile-text">
                        @Model.AlertAltBaslik
                    </span>
                    <br />
                    <div class="row">

                        <div class="col-md-3">
                            <input type="text" class="form-control" autofocus="" id="kutu1" />
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control" id="kutu2" />
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control" id="kutu3" />
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control" id="kutu4" />
                        </div>

                    </div>
                    <div class="text-center mt-5">
                        <span class="d-block mobile-text" id="countdown"></span>
                        <span class="d-block mobile-text" id="resend"></span>
                    </div>
                </div>


            </div>


            @*<p id="otpmesaj" style="display:none;text-align:center"></p>*@

            <div class="form-actions float-right " style="margin:10px 10px;text-align:center ">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button>

            </div>
        </div>
    </div>
</div>