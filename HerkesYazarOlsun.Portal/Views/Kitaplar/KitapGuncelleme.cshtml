@{
    ViewData["Title"] = "";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.NavbarGoster = false;
}
@using HerkesYazarOlsun.Portal.Controllers;
@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL


@section Styles {
    <style>
        .js #features {
            margin-left: -12000px;
            width: 100%;
        }

        /*#gozukecekMiNavbar,*/
        #gozukecekMiFooter,
        #gozukecekMiFooterCrypt {
            display: none;
        }

        #logout img {
            filter: brightness(1.2);
        }

        #logout {
            background-color: #f6f6f6;
            border: 1px solid #c5c5c5;
            border-radius: 3px;
            padding: 2px;
        }
    </style>
    <link href="~/wowbook/css/style.css" rel="stylesheet" />
    <link href="~/wowbook/css/wow_book.css" rel="stylesheet" />
    <link href="~/wowbook/css/preview.css" rel="stylesheet" />
    <link href="~/css/mobile-reader.css?v=20260929-2" rel="stylesheet" />
}

@{
    Model.IsWowBookEdit = true;
}


@Html.Partial("_WowBookContent", @Model)

@section scripts {
    <script src="~/lib/jquery/jquery.min.js"></script>

    <script src="~/wowbook/wow_book.min.js"></script>

    <script src="~/js/mobile-reader.js?v=20260929-2"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            if (window.matchMedia('(max-width: 768px)').matches) { initMobileReader(); return; }
            var book = $('#features').wowBook({
                height: 500,
                width: 800,
                centeredWhenClosed: true,
                hardcovers: true,
                turnPageDuration: 1000,
                numberedPages: [1, -2],
                controls: {
                    zoomIn: '#zoomin',
                    zoomOut: '#zoomout',
                    next: '#next',
                    back: '#back',
                    first: '#first',
                    last: '#last',
                    slideShow: '#slideshow',
                    flipSound: '#flipsound',
                    thumbnails: '#thumbs',
                    fullscreen: '#fullscreen'
                },
                scaleToFit: "#container",
                thumbnailsPosition: 'bottom',
                flipSoundPath: '@Url.Content("~/wowbook/sound/")',
                onFullscreenError: function () {
                    var msg = "Fullscreen failed.";
                    if (self != top) msg = "The frame is blocking full screen mode.";
                    alert(msg);
                }
            }).css({ 'display': 'none', 'margin': 'auto' }).fadeIn(1000);

            initDesktopReaderNavigation($.wowBook('#features'));

            // Eğer sayfa çevrildiğinde manuel olarak flip sound çalmak istersen
            var flipAudio = document.getElementById("flipSound");
            book.on('turned', function () {
                flipAudio.play();
            });
        });


    </script>

    <script src="~/wowbook/js/plugins.js"></script>
    <script src="~/wowbook/js/script.js"></script>

    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
}
