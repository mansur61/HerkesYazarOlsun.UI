          [{ 'align': [] }],
          ['clean']
        ]
      }
    });

    // Önsöz Editörü
    var onSozQuill = new Quill('#onSozEditor', {
      theme: 'snow',
      placeholder: 'Önsözünüzü buraya yazın...',
      modules: {
        toolbar: [
          [{ 'size': ['small', false, 'large', 'huge'] }], // Font boyutu
          ['bold', 'italic', 'underline', 'strike'],
          [{ 'list': 'ordered' }, { 'list': 'bullet' }],
          ['link', 'image'],
          [{ 'align': [] }],
