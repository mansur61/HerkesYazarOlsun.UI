@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Portal.Controllers;
@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;

@{
    ViewData["Title"] = "Kitap Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.FooterGoster = false;
}
<br />
<br />

<div id="globalSpinner" class="spinner text-center"
     style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
    <i class="fa fa-spinner fa-spin fa-3x"></i>
</div>


@{
    string tip = "kitapekle";
}
<input type="hidden" id="tip" value="@tip" />

@section Styles {
    <!-- richt text için-->
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">


    <link href="~/lib/css/kitap_olustur.css" rel="stylesheet" />
    <link href="~/lib/css/kitap_on_bilgiler.css" rel="stylesheet" />


}
<style>
    #globalSpinner i {
        color: transparent !important;
        background: linear-gradient(45deg, #ff0000, #ffea00);
        -webkit-background-clip: text;
        background-clip: text;
        font-size: 60px !important; /* daha büyük görünür */
        filter: drop-shadow(0 0 8px rgba(255, 0, 0, 0.6));
    }

    #globalSpinner {
        /* Arka plan hafif mavi overlay */
        background: rgba(0, 60, 255, 0.15);
        padding: 20px 25px;
        border-radius: 15px;
    }

</style>

<div class="container d-flex align-items-center min-vh-100">
    <div class="row justify-content-center w-100">
        <!-- TITLE -->
        <div class="col-12 col-lg-4 mb-4">
            <div id="title-container">
                <h2>Herkes Yazar Olsun</h2>
                <p>
                    Siz değerli yazarımız. İçeriğinizi tüm paydaşlarımızla paylaşacağınızdan ötürü mutluluk içirisindeyiz.
                    Bu yolda başarılarınızı temenni ederiz.
                </p>
            </div>
           
        </div>

        <!-- FORM -->
        <div class="col-12 col-lg-7">
            <div class="progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" role="progressbar"
                     style="width: 0%;background-color: #00C9A7;"></div>
            </div>

            <form action="KitapEkle" method="post" enctype="multipart/form-data" id="form-wrapper" class="needs-validation">
                <div id="steps-container">

                    @if (Model.isYazmayaDevamEt.HasValue && !Model.isYazmayaDevamEt.Value)
                    {
                        <div class="step">
                            @Html.Partial("_KitapEkleOnBilgiler", @Model)
                        </div>
                    }

                    <div class="step">
                        <h1>Kitabınızın Sayfalarını Oluşturunuz</h1>
                        <p>
                            Kitapta Yazılan İlgili Sayfa No:
                            <span id="sayfaSayisi" data-value="@Model.IlgiiSayfaSayisi"> 
                                @Model.IlgiiSayfaSayisi
                            </span>
                        </p>

                        <input type="hidden" id="kitapKatdetmeUyariDurumu" value="0">
                        <input type="hidden" id="BOOKSID" value="@ViewBag.BOOK_ID">
                        <input type="hidden" id="BOOKPAGESID" value="@Model.IlgiiSayfaSayisi">

                        <div class="mb-3">
                            <h5>İlgili Sayfayı Yazınız</h5>
                            <div id="help" class="form-text text-info mb-2">1000 karakteri geçmeyiniz.</div>
                            <div class="container-pg border rounded p-1">
                                <div id="sayfaYaziEditor"></div>
                            </div>

                            <textarea id="sayfaYazi" name="SAYFAYAZI" hidden></textarea>
                        </div>
                    </div>

                </div>

                <!-- Buttons -->
                <div id="q-box__buttons">
                    @if (Model.isYazmayaDevamEt.HasValue && Model.isYazmayaDevamEt.Value)
                    {
                        @* <button id="devamet-btn" type="button">Devam Et</button> *@
                        <button id="submit-btn" type="submit">Kaydet</button>
                        if (ViewBag.KitapTamamlamaSayisi >50)
                        {
                            <button id="tamam-btn" type="button">Tamamla</button>
                        }
                        
                    }
                    else
                    {
                        <button id="prev-btn" type="button">Geri</button>
                        <button id="next-btn" type="button">İleri</button>
                        <button id="submit-btn" type="submit">Kaydet</button>
                        @* <button id="tamam-btn" type="button">Tamamla</button> *@
                        if (ViewBag.KitapTamamlamaSayisi > 50)
                        {
                            <button id="tamam-btn" type="button">Tamamla</button>
                        }
                    }
                </div>
                <div>
                    @Html.Partial("_AlertMesaj", "kitapekle")
                </div>
            </form>
        </div>
    </div>
</div>

<div id="preloader-wrapper">
    <div id="preloader"></div>
    <div class="preloader-section section-left"></div>
    <div class="preloader-section section-right"></div>
</div>
<br />
<br />

<div id="alertGoster"></div>

<script src= "~/js/general.js"></script>


@section Scripts {
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>


    <!-- richt text için-->
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <!-- SweetAlert2 JS dosyası ve Bootstrap JS dosyası -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
}
<!--_KitapEkleOnBilgiler rich ext ayarlamaları-->
<script>
    // Arka Kapak
    const arkaKapk = $("#arkaKapakYaziEditor");
    let arkaKapakQuill;

    if (arkaKapk.length > 0) {
        arkaKapakQuill = new Quill('#arkaKapakYaziEditor', {
            theme: 'snow',
            placeholder: 'Kapak yazınızı buraya yazın...',
            modules: {
                toolbar: [
                    [{ 'size': ['small', false, 'large', 'huge'] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    //[  'link','image'],
                    [{ 'align': [] }],
                    ['clean']
                ]
            }
        });
    }

    // Önsöz
    const onsSz = $("#onSozEditor");
    let onSozQuill;

    if (onsSz.length > 0) {
        onSozQuill = new Quill('#onSozEditor', {
            theme: 'snow',
            placeholder: 'Önsözünüzü buraya yazın...',
            modules: {
                toolbar: [
                    [{ 'size': ['small', false, 'large', 'huge'] }],
                    ['bold', 'italic', 'underline', 'strike'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                   //[  'link','image'],
                    [{ 'align': [] }],
                    ['clean']
                ]
            }
        });
    }

    // Form Submit
    if (onsSz.length > 0 && arkaKapk.length > 0) {
        document.querySelector('form')?.addEventListener('submit', function () {
            document.getElementById('arkaKapakYazi').value = arkaKapakQuill.root.innerHTML;
            document.getElementById('onsoz').value = onSozQuill.root.innerHTML;
        });
    }
</script>


<script>
    document.addEventListener('DOMContentLoaded', function () {

        let step = document.getElementsByClassName('step');
        let prevBtn = document.getElementById('prev-btn');
        let tamamBtn = document.getElementById('tamam-btn');
        let nextBtn = document.getElementById('next-btn');
        let submitBtn = document.getElementById('submit-btn');
        let stepCount = step.length;
        let current_step = 0;
        let quill; // Quill değişkenini global tanımlıyoruz
        const hiddenTextarea = document.getElementById('sayfaYazi');

        function initQuill() {
            if (!quill) {
                quill = new Quill('#sayfaYaziEditor', {
                    theme: 'snow',
                    placeholder: 'Sayfanızı buraya yazın...',
                    modules: {
                        toolbar: [
                          [{ 'size': ['small', false, 'large', 'huge'] }], // Font boyutu
                          ['bold', 'italic', 'underline', 'strike'],
                          [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                          [  'image'],
                          [{ 'align': [] }],
                          ['clean']
                        ]
                      }
                });

                quill.on('text-change', () => {
                    hiddenTextarea.value = quill.root.innerHTML;
                });
            } else {
                // Step görünür olduğunda Quill yeniden boyutlandırılıyor
                quill.resize && quill.resize();
                quill.update && quill.update();
            }
        }

        function showStep(index) {
            for (let i = 0; i < stepCount; i++) {
                step[i].style.display = (i === index) ? 'block' : 'none';
            }

            // Eğer Quill editörü bu step içindeyse initialize et
            const editorContainer = document.getElementById('sayfaYaziEditor');
            if (editorContainer && index === 1) { // 2. step index = 1
                initQuill();
            }
             if (editorContainer && index === 0) {
                initQuill();
            }
            //console.log("index ",index);
            var isYazmayaDevamEt = @(Model.isYazmayaDevamEt.HasValue && Model.isYazmayaDevamEt.Value ? "true" : "false");
             console.log("index ",index+ " isYazmayaDevamEt, "+isYazmayaDevamEt);
            // Butonlar
            if (index === 0) {
                if (prevBtn) prevBtn.style.display = 'none';
                if (nextBtn) nextBtn.style.display = 'inline-block';

                if(isYazmayaDevamEt){
                    console.log("true");
                    submitBtn.style.display = 'inline-block';
                    if (tamamBtn) tamamBtn.style.display = 'inline-block';
                }else{
                    console.log("false");
                    submitBtn.style.display = 'none';                    
                    if (tamamBtn) tamamBtn.style.display = 'inline-block';
                }

                
                
               
            } else if (index === stepCount - 1) {
                prevBtn.style.display = 'inline-block';
                nextBtn.style.display = 'none';
                submitBtn.style.display = 'inline-block';
                if (tamamBtn) tamamBtn.style.display = 'inline-block';
                //tamamBtn.style.display = 'inline-block';
            } else {
                prevBtn.style.display = 'inline-block';
                nextBtn.style.display = 'inline-block';
                submitBtn.style.display = 'none';
                tamamBtn.style.display = 'none';
            }

            // Progress bar güncelle
            const progress = (value) => {
                document.getElementsByClassName('progress-bar')[0].style.width = `${value}%`;
            };
            progress((100 / stepCount) * (index + 1));
        }

        // İlk step’i göster
        showStep(current_step);

        if (nextBtn){
            nextBtn.addEventListener('click', () => {
                if (current_step < stepCount - 1) {
                    current_step++;
                    showStep(current_step);
                }
            });
        }

        if (prevBtn){
            prevBtn.addEventListener('click', () => {
                if (current_step > 0) {
                    current_step--;
                    showStep(current_step);
                }
            });
        }
         

    });
</script>

<script>

     function showSpinner() {
         $("#globalSpinner").show();
     }

     function hideSpinner() {
         $("#globalSpinner").hide();
     }

     var quillDosyalari = [];

     var tip = $("#tip").val();

     var spanElement = document.getElementById('sayfaSayisi');
     
     var dataValue = spanElement.getAttribute('data-value');
     

     var isYazmayaDevamEt = @(Model.isYazmayaDevamEt.HasValue && Model.isYazmayaDevamEt.Value ? "true" : "false");
     console.log(" isYazmayaDevamEt" , isYazmayaDevamEt);
     
    // alert("dataValue: " + dataValue + ", isYazmayaDevamEt : "+isYazmayaDevamEt);
      
     var kId = '@StringCipher.Encrypt(ViewBag.BOOK_ID.ToString())';


    $("#tamam-btn").on("click", function () {
         console.log("tamam-btn"  );
         var kategoriBilgisi = $("#kitapKategori").val();
         if(kategoriBilgisi){
             console.log("kategoriBilgisi : " + kategoriBilgisi);
         }

         var kitapId = $("#BOOKSID").val();
         var sayfaYazi = $("#sayfaYazi").val();
           

         Swal.fire({
             title: 'Emin misiniz?',
             text: "Tamamla butonuna basmadan önce değişikliklerinizi Kaydet butonuna basarak kaydetttiğinizden emin olunuz. Yine de Tamamlansın mı?",
             icon: 'question',
             showCancelButton: true,
             confirmButtonText: 'Evet',
             cancelButtonText: 'Hayır',
             customClass: {
                 confirmButton: 'btn btn-primary',
                 cancelButton: 'btn btn-danger'
             }
         }).then((result) => {
             if (result.isConfirmed) {
                    showSpinner();

                  
                     formData.append('BookModel.ID',  kitapId); 
                     formData.append('isWordPDF', false);
                     formData.append('isTamalama', true);
                     formData.append('BookPagesModel.PageWrite', sayfaYazi); 
                     formData.append('BookPagesModel.ID', $("#BOOKPAGESID").val());

                    const base64Images = extractBase64Images(sayfaYazi);

                    let pageFotoNames = [];
                    if (base64Images.length !== 0){
                         base64Images.forEach((img, i) => {
                            let file = base64ToFile(img, "image_" + i + ".png");
                             formData.append(`BookPagesModel.PageFotoList[${i}]`, img);
                            pageFotoNames.push("image_" + i + ".png");
                            formData.append("dosyalar", file);
                            formData.append("BookPagesModel.PageFotoDosyalar", file);
                        });
                        let pageFotos = pageFotoNames.join("||");
                        formData.append("BookPagesModel.PageFoto", pageFotos);
                    }

                 Tamamla(formData);
                 
             } else if (result.dismiss === Swal.DismissReason.cancel) {
                 Swal.fire('Kitap Tamamla', 'Kitap Tamamlama İşleminde sorun oluştu. Bizim ile iletişime geçiniz', 'error');
                 $("#kitapKatdetmeUyariDurumu").val("0");
             }
         });

     });
      
     var kitapOlusturForm = document.getElementById('form-wrapper');

     kitapOlusturForm.addEventListener('submit', function (event) {
         event.preventDefault(); // Formun varsayılan submit işlemini engelle
         //console.log("kitapOlusturForm"  );
         var kitapKatdetmeUyariDurumu = $("#kitapKatdetmeUyariDurumu").val();
         // console.log("kitapKaydet UyariDurumu : " + kitapKatdetmeUyariDurumu);

        if(dataValue == 1){
            var kategoriBilgiId = $("#kitapKategori").val();
            // console.log("kitapKategori : " + kategoriBilgiId);
            var selectlement = document.getElementById('selecData-' + kategoriBilgiId);
            if(!selectlement){
                 BilgiVer(0, "#basarili-", "#bilgi-", "#uyari-", "Kategori Seçilmelidir." );
                 return;
            }
            // data özelliğinden değeri al
            var kategoriAdi = selectlement.getAttribute('data-name');
            // console.log("kategoriAdi : " + kategoriAdi);
            var metinText = "Seçtiğiniz Kategori (" + kategoriAdi + ") 'ye göre minimum sayfa sayısı 50 sayfa ekleme durumu vardır. Ve birkez kaydetme yaptıktan sonra ilgili kategoriyi değiştiremezsiniz. Yine de emin misiniz?";

        }

         if (dataValue == 1 && kitapKatdetmeUyariDurumu == "0") {
             Swal.fire({
                 title: 'Emin misiniz?',
                 text: metinText,
                 icon: 'question',
                 showCancelButton: true,
                 confirmButtonText: 'Evet',
                 cancelButtonText: 'Hayır',
                 customClass: {
                     confirmButton: 'btn btn-primary',
                     cancelButton: 'btn btn-danger'
                 }
             }).then((result) => {
                 if (result.isConfirmed) {
                     var formData = new FormData(this); // FormData nesnesini oluştur
                     var dosyaInputs = kitapOlusturForm.querySelectorAll('input[type="file"]');
                     console.log(dosyaInputs.length);
                     for (var i = 0; i < dosyaInputs.length; i++) {
                         formData.append('dosyalar', dosyaInputs[i].files[0]);
                     }

                     kitapVeIlkSayfasiKaydet(formData);

                 } else if (result.dismiss === Swal.DismissReason.cancel) {
                     // Hayır'a tıklandığında burası çalışır
                     Swal.fire('Kitap Ekleme', 'Ekleyeceğiniz kitabın kategorsini tekrardan belirleyebilirsiniz', 'error');
                     $("#kitapKatdetmeUyariDurumu").val("0");
                 }
             });
         } else {
              var formData = new FormData(this);
             sayfaKaydet(formData);
         }

     });
 

     // eklenen kitaba sayfa eklemede kullanılır
    function sayfaKaydet(formData) {
        var kitapId = $("#BOOKSID").val();
        var sayfaYazi = $("#sayfaYazi").val();
        var sayfaId = $("#BOOKPAGESID").val();
         formData.append('BookModel.ID',  kitapId); 
         formData.append('isWordPDF', false);
         formData.append('isTamalama', false);
         formData.append('BookPagesModel.PageWrite', sayfaYazi); 
         formData.append('BookPagesModel.ID', sayfaId);

        const base64Images = extractBase64Images(sayfaYazi);

        let pageFotoNames = [];
        if (base64Images.length !== 0){
             base64Images.forEach((img, i) => {
                let file = base64ToFile(img, "image_" + i + ".png");
                 formData.append(`BookPagesModel.PageFotoList[${i}]`, img);
                pageFotoNames.push("image_" + i + ".png");
                 formData.append("dosyalar", file);
                formData.append("BookPagesModel.PageFotoDosyalar", file);
            });
            let pageFotos = pageFotoNames.join("||");
            formData.append("BookPagesModel.PageFoto", pageFotos);
        }
         
        showSpinner();
        Gonder(formData);    
    }

     // ilk kitap ve sayfa kaydı diğerleri  farkliVeriGonder() burdan ekle
     function kitapVeIlkSayfasiKaydet(formData) {

         var kitapId = $("#BOOKSID").val();
         //console.log("kitapId:" + kitapId);
         var sayfaId = $("#BOOKPAGESID").val();
         //console.log("sayfaId:" + sayfaId);
         var kitapAdi = $("#kitapAdi").val();
         var onsoz = $("#onsoz").val();
         var arkaKapakYazi = $("#arkaKapakYazi").val();
         var kategori = $("#kitapKategori").val();
         var sayfaYazi = $("#sayfaYazi").val(); 
         var bb = $("#ONKAPAKFOTO").val();

        const base64Images = extractBase64Images(sayfaYazi);
        //console.log("base64Images count:" + base64Images.length+ " bb ", bb);

        if(base64Images.length > 1){
             BilgiVer(0, "#basarili-", "#bilgi-", "#uyari-", "En fazla 1 resim sayfada olabilir." );
             return;
        }
       if( $("#ONKAPAKFOTO").val() == ""){
           BilgiVer(0, "#basarili-", "#bilgi-", "#uyari-", "Lütfen ön kapak fotoğrafını seçin!" );
             return;
       }
       if( $("#ARKAKAPAKFOTO").val() == ""){
           BilgiVer(0, "#basarili-", "#bilgi-", "#uyari-", "Lütfen arka kapak fotoğrafını seçin!" );
             return;
       }

        let pageFotoNames = [];
        if (base64Images.length !== 0){
             base64Images.forEach((img, i) => {
                let file = base64ToFile(img, "image_" + i + ".png");          
                 formData.append(`BookPagesModel.PageFotoList[${i}]`, img); 
                pageFotoNames.push("image_" + i + ".png");
                formData.append("dosyalar", file);
                formData.append("BookPagesModel.PageFotoDosyalar", file);
            });
            let pageFotos = pageFotoNames.join("||");
            formData.append("BookPagesModel.PageFoto", pageFotos);
        }

         formData.append('BookModel.ID',  kitapId == -1 ? 0 :kitapId);
         formData.append('BookModel.Name', kitapAdi);
         formData.append('BookModel.onsoz', onsoz);
         formData.append('BookModel.ARKAKAPAKYAZISI', arkaKapakYazi);
         formData.append('BookModel.CategoriId', kategori);
         formData.append('isWordPDF', false);
         formData.append('BookPagesModel.PageWrite', sayfaYazi);

         formData.append('BookModel.ONKAPAKFOTO', $("#ONKAPAKFOTO").val());
         formData.append('BookModel.ARKAKAPAKFOTO', $("#ARKAKAPAKFOTO").val());
         formData.append('BookModel.ARKAKAPAKFOTOPATH', "ARKAKAPAKFOTOPATH");
         formData.append('BookModel.ONKAPAKFOTOPATH', "ONKAPAKFOTOPATH");

         formData.append('BookPagesModel.ID', sayfaId);
         showSpinner();
         Gonder(formData);      
     }


    function Gonder(formData){ 

           $.ajax({
             url: '/Kitaplar/KitapEkle', // Formun gönderileceği adresi belirtin
             method: 'POST',
             data: formData, // Form verilerini FormData nesnesiyle al
             processData: false,
             contentType: false,
             success: function (response) {
                  hideSpinner();

                 if (response.state == 1) {
                     var mesaj = "";
                     if(dataValue == 1){
                         mesaj = "Kitap ve Sayfası Eklenmiştir.";
                     }else{
                         //mesaj = (mesaj && mesaj.trim() !== "") ? mesaj : "Kitaba Sayfa Eklenmiştir.";
                         mesaj = "Kitaba Sayfa Eklenmiştir.";
                     }
                     BilgiVer(response.state, "#basarili-", "#bilgi-", "#uyari-", mesaj);

                     $("#BOOKSID").val(response.result.bookID);
                     $("#BOOKPAGESID").val(response.result.booksPageID);
                     //console.log("veriGonder BOOKSID: " + $("#BOOKSID").val() + " BOOKPAGESID: " + $("#BOOKPAGESID").val());

                     var intSayi = parseInt(dataValue);
                     $("#sayfaSayisi").html( response.result.booksPageCount);

                     $("#kitapKatdetmeUyariDurumu").val("1");
                     spanElement.setAttribute('data-value', intSayi + 1);
                     var safeId = response.result.bookIdENC;

                      setTimeout(function () {
                          if(safeId) {
                            window.location.href = "/Kitaplar/KitapOlustur?isYazmayaDevamEt=true&kitap_id=" + safeId+"&IlgiiSayfaSayisi="+response.result.booksPageCount;

                          } else {}
                      }, 3000);


                 } else {
                     BilgiVer(response.state, "#basarili-", "#bilgi-", "#uyari-", response.message); 
                 }
             },
               error: function (xhr, status, error) {
                    hideSpinner();
                    console.error("AJAX Hatası:", status, error);
                    $("#kitapKatdetmeUyariDurumu").val("0");

                    var uyariMesaj = "";
                    if(dataValue == 1){
                         uyariMesaj = "Kitap ve  sayfa kaydedilemedi, lütfen tekrar deneyin.";
                     }else{ 
                         uyariMesaj = "Sayfa kaydedilemedi, lütfen tekrar deneyin.";
                     }
                    BilgiVer(0, "#basarili-", "#bilgi-", "#uyari-", uyariMesaj );
                }
         });

    }

    function Tamamla(formData){

           $.ajax({
             url: 'KitabiTamamla', // Formun gönderileceği adresi belirtin
             method: 'POST',
             data: formData, // Form verilerini FormData nesnesiyle al
             processData: false,
             contentType: false,
             success: function (data) {
                  hideSpinner(); 
                if (data.state == 1) {

                    BilgiVer(data.state, "#basarili-", "#bilgi-", "#uyari-", "Kitap Tamamlandı. İlgili kitaba yönlendiriliyorsunuz..");

                    setTimeout(function () {
                    window.location.href = "/Kitaplar/KitapDetay?kitap_id=" + kId.toString();

                    }, 3000);
                } else {
                    BilgiVer(data.state, "#basarili-", "#bilgi-", "#uyari-", data.message);//"Kitap Tamamlanamadı"
                }
             },
               error: function (xhr, status, error) {
                    hideSpinner();
                   Swal.fire('Kitap Tamamla', 'Kitap Tamamlama İşleminde sorun oluştu. Bizim ile iletişime geçiniz', 'error');
                     $("#kitapKatdetmeUyariDurumu").val("0");
                }
         });

    }

     

</script>

