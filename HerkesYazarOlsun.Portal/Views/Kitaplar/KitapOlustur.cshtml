    function veriGonder(formData) {

        var kitapId = $("#BOOKSID").val();
        console.log("kitapId:" + kitapId);
        var sayfaId = $("#BOOKPAGESID").val();
        console.log("sayfaId:" + sayfaId);
        var kitapAdi = $("#kitapAdi").val();
        var onsoz = $("#onsoz").val();
        var arkaKapakYazi = $("#arkaKapakYazi").val();
        var kategori = $("#kitapKategori").val();
        var sayfaYazi = $("#sayfaYazi").val();

        console.log("ONKAPAKFOTO ",$("#ONKAPAKFOTO").val());

        formData.append('BookModel.ID',  kitapId == -1 ? 0 :kitapId);
        formData.append('BookModel.Name', kitapAdi);
        formData.append('BookModel.onsoz', onsoz);
        formData.append('BookModel.ARKAKAPAKYAZISI', arkaKapakYazi);
        formData.append('BookModel.CategoriId', kategori);
        formData.append('isWordPDF', false);
        formData.append('BookPagesModel.PageWrite', sayfaYazi);

        formData.append('BookModel.ONKAPAKFOTO', $("#ONKAPAKFOTO").val());
        formData.append('BookModel.ARKAKAPAKFOTO', $("#ARKAKAPAKFOTO").val());
        formData.append('BookModel.ARKAKAPAKFOTOPATH', "ARKAKAPAKFOTOPATH");
        formData.append('BookModel.ONKAPAKFOTOPATH', "ONKAPAKFOTOPATH");

        formData.append('BookPagesModel.ID', sayfaId);


        $.ajax({
            url: 'KitapEkle', // Formun gönderileceği adresi belirtin
            method: 'POST',
            data: formData, // Form verilerini FormData nesnesiyle al
            processData: false,
            contentType: false,
            success: function (response) {
                console.log('Başarılı dönüş: response', response);
                console.log('Başarılı dönüş: response result ', response.result);
                // Başarılı dönüş sonucunu işleme kodları buraya gelebilir.
                if (response.state == 1) {
                    window.quill.setContents([]);
                    BilgiVer(response.state, "#basarili-", "#bilgi-", "#uyari-", "Kitap ve Sayfası Eklenmiştir.");

                    $("#BOOKSID").val(response.result.bookID);
                    $("#BOOKPAGESID").val(response.result.booksPageID);
                    console.log("veriGonder BOOKSID: " + $("#BOOKSID").val() + " BOOKPAGESID: " + $("#BOOKPAGESID").val());
                    $("#sayfaSayisi").html(response.result.booksPageCount + 1);

                    
                    

                    $("#kitapKatdetmeUyariDurumu").val("1");
                    var intSayi = parseInt(dataValue);
                    spanElement.setAttribute('data', intSayi + 1);

                     if(prevBtn){
                         prevBtn.classList.add('d-none');
                    }
                    window.location.reload();

                } else {
                    BilgiVer(response.state, "#basarili-", "#bilgi-", "#uyari-", response.message);//"Kitap ve Sayfası Eklenemedi."
                }
            },
            error: function (xhr, status, error) {
                console.error('Hata:', error);
                $("#kitapKatdetmeUyariDurumu").val("0");
                // Hata durumunu işleme kodları buraya gelebilir
            }
        });
    }

    function BilgiVer(state, basarili, bilgi, uyari, mesaj) {
        if (state == 1) {
            $(basarili + tip).css("display", "block");
            $(basarili + tip + " #mesaj").html(mesaj);

            $(bilgi + tip).css("display", "none");
            $(uyari + tip).css("display", "none");

            /*setTimeout(function () {
                var link = window.location.href;

                window.location.href = link;
                console.log("link " + link);

                window.location.reload()

            }, 3000);*/
        }
        else if (state == 3) {
            $(bilgi + tip).css("display", "block");
            $(bilgi + tip + " #mesaj").html(mesaj);

            $(basarili + tip).css("display", "none");
            $(uyari + tip).css("display", "none");
        }
        else {
            $(uyari + tip).css("display", "block");
            $(bilgi + tip).css("display", "none");
            $(basarili + tip).css("display", "none");
            $(uyari + tip + " #mesaj").html(mesaj);
        }
    }

    // form.onsubmit = () => {
    //     return false
    // }





</script>

