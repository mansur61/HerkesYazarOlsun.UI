</script>


<script>
    document.addEventListener('DOMContentLoaded', function () {

        let step = document.getElementsByClassName('step');
        let prevBtn = document.getElementById('prev-btn');
        let tamamBtn = document.getElementById('tamam-btn');
        let nextBtn = document.getElementById('next-btn');
        let submitBtn = document.getElementById('submit-btn');
        let stepCount = step.length;
        let current_step = 0;
        let quill; // Quill değişkenini global tanımlıyoruz
        const hiddenTextarea = document.getElementById('sayfaYazi');

        function initQuill() { 
            if (!quill) {
                quill = new Quill('#sayfaYaziEditor', {
                    theme: 'snow',
                    placeholder: 'Sayfanızı buraya yazın...',
                    modules: {
        toolbar: [
          [{ 'size': ['small', false, 'large', 'huge'] }], // Font boyutu
          ['bold', 'italic', 'underline', 'strike'],
          [{ 'list': 'ordered' }, { 'list': 'bullet' }],
          ['link', 'image'],
          [{ 'align': [] }],
          ['clean']
        ]
      }
                });

                quill.on('text-change', () => {
                    hiddenTextarea.value = quill.root.innerHTML;
                });
            } else {
                // Step görünür olduğunda Quill yeniden boyutlandırılıyor
                quill.resize && quill.resize();
                quill.update && quill.update();
            }
        }

        function showStep(index) {
            for (let i = 0; i < stepCount; i++) {
                step[i].style.display = (i === index) ? 'block' : 'none';
            }

            // Eğer Quill editörü bu step içindeyse initialize et
            const editorContainer = document.getElementById('sayfaYaziEditor');
            if (editorContainer && index === 1) { // 2. step index = 1
                initQuill();
            }
             if (editorContainer && index === 0) {
                initQuill();
            }
            console.log("index ",index);
            var isYazmayaDevamEt = @(Model.isYazmayaDevamEt.HasValue && Model.isYazmayaDevamEt.Value ? "true" : "false");

            // Butonlar
            if (index === 0) {

                if (prevBtn) prevBtn.style.display = 'none';
                if (nextBtn) nextBtn.style.display = 'inline-block';
                if (submitBtn) submitBtn.style.display = 'none';
                if (tamamBtn) {
                    if(isYazmayaDevamEt){
                         tamamBtn.style.display = 'inline-block';
                    }else{
                         tamamBtn.style.display = 'none';
                    }

                }
            } else if (index === stepCount - 1) {
                prevBtn.style.display = 'inline-block';
                nextBtn.style.display = 'none';
                submitBtn.style.display = 'inline-block';
                tamamBtn.style.display = 'inline-block';
            } else {
                prevBtn.style.display = 'inline-block';
                nextBtn.style.display = 'inline-block';
                submitBtn.style.display = 'none';
                tamamBtn.style.display = 'none';
            }

            // Progress bar güncelle
            const progress = (value) => {
                document.getElementsByClassName('progress-bar')[0].style.width = `${value}%`;
            };
            progress((100 / stepCount) * (index + 1));
        }

        // İlk step’i göster
        showStep(current_step);
        if (nextBtn){
            nextBtn.addEventListener('click', () => {
                if (current_step < stepCount - 1) {
                    current_step++;
                    showStep(current_step);
                }
            });
        }
                if (prevBtn){
                 prevBtn.addEventListener('click', () => {
                        if (current_step > 0) {
                            current_step--;
                            showStep(current_step);
                        }
                    });
            }



    });
</script>

