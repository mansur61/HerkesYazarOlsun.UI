                        $("#bilgi-" + kitapaktarm).css("display", "none");
                        $("#uyari-" + kitapaktarm).css("display", "none");

                    }
                    else if (response == "") {
                        $("#bilgi-" + kitapaktarm).css("display", "block");
                        $("#bilgi-" + kitapaktarm + " #mesaj").html("hata");

                        $("#basarili-" + kitapaktarm).css("display", "none");
