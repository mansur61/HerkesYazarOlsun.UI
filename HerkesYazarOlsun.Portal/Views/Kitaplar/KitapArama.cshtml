@{
    ViewData["Title"] = "Kitap Arama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{
    <link href="~/lib/owlcarousel/dist/assets/owl.carousel.min.css" rel="stylesheet" />
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;
@using HerkesYazarOlsun.Portal.Controllers;
@using HerkesYazarOlsun.Model.ViewModel;

@{
    int sidebardaGosterilecekKayit = 3;
    int perSlide = sidebardaGosterilecekKayit; 

    int total = Model.VMBooksList.Count;
    int sliderSayisi = (int)Math.Ceiling((double)total / perSlide);
    var butons = new  VM_PAGINATION_BUTTON{
            sliderSayisi = sliderSayisi,
            sliderSayiDivTagName = "arama"
    };
    Model.vM_PAGINATION_BUTTONS = butons; 

    var kitapAramalarModel = new VM_BOOKS_DETAIL
    {
        VMBooksList = Model.VMBooksList.ToList(),  
        sliderdaGosterilecekKayit = perSlide,
        vM_PAGINATION_BUTTONS = butons,
        Tip = "arama",
        isAnaSayfa = false,
    };
}

<style>
    .containerPagination {
        width: 200px;
        height: 100%;
        background: linear-gradient(45deg,#410358,#4700bc);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pagination {
        display: flex;
        align-items: center;
        background: #fff;
        color: #383838;
        padding: 10px 10px;
        border-radius: 6px;
    }

    .containerPagination > ul {
        margin: 20px 30px;
        padding-left: 0;
    }

    .containerPagination > ul li {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        margin: 0 5px;
        width: 45px;
        height: 45px;
        border-radius: 0.25rem;
        font-size: 22px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.3s;
        list-style: none;
    }

    .containerPagination > ul li.active {
        color: #fff;
        background-color: #410358;
    }

    .btn1, .btn2 {
        display: inline-flex;
        align-items: center;
        font-size: 22px;
        font-weight: 500;
        color: #383838;
        background: transparent;
        border: none;
        cursor: pointer;
    }
</style>

<section class="product spad">
    <div class="container">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-lg-4 col-md-5">
                <div class="sidebar">
                    <div class="sidebar__item">
                        <h3>Arama Yapınız</h3>
                        <div class="mb-3"></div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault">
                            <label class="form-check-label" for="flexCheckDefault">
                                2023 te yazılan kitaplar
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="flexCheckDefault2">
                            <label class="form-check-label" for="flexCheckDefault2">
                                2023 ten önce yazılan kitaplar
                            </label>
                        </div>
                    </div>

                    <div class="sidebar__item">
                        <h5>Kategori Seçiniz</h5>
                        <div class="mb-3"></div>
                        <select class="form-select">
                            <option value="1">Hikaye</option>
                            <option value="2">Roman</option>
                            <option value="3" disabled>Şiir</option>
                            <option value="4"></option>
                        </select>
                        <br />
                    </div>

                    <div class="sidebar__item">
                        <h5>Yazar Giriniz</h5>
                        <div class="mb-3"></div>
                        <input type="text" class="form-control mb-2" placeholder="Yazar..." name="yazarAdi">
                    </div>

                    <!-- Slider Sidebar -->
                    @Html.Partial("_SideBarItem", @Model)
                </div>
            </div>

            <!-- Ürünler / Liste -->
            <div class="col-lg-8">
                <div class="filter__item mb-3">
                    <div class="row g-3">
                        <div class="col-lg-4 col-md-5">
                            <div class="mb-3">
                                <span>Sıralama</span>
                                <select class="form-select form-select-sm">
                                    <option value="0">Azalan</option>
                                    <option value="1">Artan</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4">
                            <div class="mb-3">
                                <h6><span>16</span> Products found</h6>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-3">
                            <select class="form-select form-select-sm">
                                <option value="1">İlk 10 Kayıt</option>
                                <option value="1" disabled>İlk 20 Kayıt</option>
                                <option value="1">İlk 30 Kayıt</option>
                                <option value="1">İlk 40 Kayıt</option>
                                <option value="1">İlk 50 Kayıt</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="alert alert-success d-none" id="basarili">
                    <strong>Başarılı!</strong> Favorilere Eklendi
                    <button type="button" class="btn btn-info btn-sm ms-2" onclick='Kapat()'>Kapat</button>
                </div>
                <div class="alert alert-info d-none" id="uyari">
                    <strong>Bilgi!</strong> Favorilere Eklenemedi
                    <button type="button" class="btn btn-info btn-sm ms-2" onclick='Kapat()'>Kapat</button>
                </div>

                <div class="row mt-3" id"kitaparama">
                    @Html.Partial("Kitaplar", @kitapAramalarModel)
                </div>
            </div>
        </div>

        @Html.Partial("_PaginationButonlar", @Model.vM_PAGINATION_BUTTONS)
    </div>
</section>

<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/nice-select/js/jquery.nice-select.min.js"></script>
<script src="~/lib/owlcarousel/dist/owl.carousel.min.js"></script> 

<script>
    function FavorilereEkle(kitapId) {
        $.post("@Url.Action(nameof(KitaplarController.KitabiFavorilereEkle), "Kitaplar")", { "id": kitapId }, function (data) {
            if (data.state == 1) {
                $("#basarili").removeClass("d-none");
            } else {
                $("#uyari").removeClass("d-none");
            }
        });
    }

    function Kapat() {
        $("#basarili, #uyari").addClass("d-none");
    }
</script>
