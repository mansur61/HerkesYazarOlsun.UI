@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL

@{
    Model.kitapSliderYometimAdi = "kitaplar" + Model.profilKitapTuru ?? "";

}


@* @section scripts{
    <script src= "../../wwwroot/lib/bootstrap/dist/js/jquery-1.10.2.js"></script>
} *@

@section Styles {
    <link href="../../wwwroot/lib/bootstrap/dist/css/owl.carousel.min.css" rel="stylesheet" />
    <link href="../../wwwroot/lib/bootstrap/dist/css/kitap_arama_style.css" rel="stylesheet" />



}



@{
    string alertmesajgostermedurumu = Model.Tip;
}


@if (@Model.VMBooksList.Count() > 0)
{
    @* <p>@Model.isAnaSayfa</p> *@

    @Html.Partial("_KitapSliderItemYonetimleri", @Model)

    @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)

    @Html.Partial("Kitaplar", @Model)


    @Html.Partial("_PaginationButonlar", @Model.vM_PAGINATION_BUTTONS)

}
else
{
    <p>Aranan kritere uygun herhangi bir kayıt bulunamadı</p>
}




