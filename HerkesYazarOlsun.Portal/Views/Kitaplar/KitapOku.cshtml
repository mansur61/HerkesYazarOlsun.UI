@{
    ViewData["Title"] = "Kitap Oku";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.NavbarGoster = false;
}
 
@section Styles {
    <style>
        .js #features {
            margin-left: -12000px;
            width: 100%;
        }

        /*#gozukecekMiNavbar,*/
        #gozukecekMiFooter,
        #gozukecekMiFooterCrypt {
            display: none;
        }

        #logout img {
            filter: brightness(1.2);
        }

        #logout {
            background-color: #f6f6f6;
            border: 1px solid #c5c5c5;
            border-radius: 3px;
            padding: 2px;
        }

        /* Mobil scroll düzeltmesi */
        @@media (max-width: 768px) {
            html, body {
                overflow: auto !important;
                -webkit-overflow-scrolling: touch;
                height: auto !important;
            }

            #container {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
                width: 100%;
            }

            #main {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            #features {
                touch-action: pan-y pinch-zoom;
            }
        }
    </style>
    <link href="~/wowbook/css/style.css" rel="stylesheet" />
    <link href="~/wowbook/css/wow_book.css" rel="stylesheet" />
    <link href="~/wowbook/css/preview.css" rel="stylesheet" />
    <link href="~/wowbook/css/handheld.css" rel="stylesheet" />
    <link href="~/wowbook/css/handheld.css?v=2" rel="stylesheet" />

    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL

@Html.Partial("_WowBookContent", @Model)

@section scripts {
    <script src="//ajax.googleapis.com/ajax/libs/jquery/1.9.1/jquery.min.js"></script>
    <script>!window.jQuery && document.write(unescape('%3Cscript src="./js/libs/jquery-1.9.1.min.js"%3E%3C/script%3E'))</script>

    <script src="~/wowbook/wow_book.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            var book = $('#features').wowBook({
                height: 500,
                width: 800,
                centeredWhenClosed: true,
                hardcovers: true,
                turnPageDuration: 1000,
                numberedPages: [1, -2],
                controls: {
                    zoomIn: '#zoomin',
                    zoomOut: '#zoomout',
                    next: '#next',
                    back: '#back',
                    first: '#first',
                    last: '#last',
                    slideShow: '#slideshow',
                    flipSound: '#flipsound',
                    thumbnails: '#thumbs',
                    fullscreen: '#fullscreen'
                },
                scaleToFit: "#container",
                thumbnailsPosition: 'bottom',
                flipSoundPath: '@Url.Content("~/wowbook/sound/")',
                onFullscreenError: function () {
                    var msg = "Fullscreen failed.";
                    if (self != top) msg = "The frame is blocking full screen mode.";
                    alert(msg);
                }
            }).css({ 'display': 'none', 'margin': 'auto' }).fadeIn(1000);

            // Eğer sayfa çevrildiğinde manuel olarak flip sound çalmak istersen
            var flipAudio = document.getElementById("flipSound");
            book.on('turned', function() {
                flipAudio.play();
            });

            // Mobilde wowBook touch engelini kaldır - sayfanın scroll edilebilmesi için
            if (window.innerWidth <= 768) {
                var bookContainer = document.getElementById('container');
                if (bookContainer) {
                    bookContainer.style.overflowX = 'auto';
                    bookContainer.style.webkitOverflowScrolling = 'touch';
                }
                // Touch olaylarının sayfayı scroll etmesine izin ver
                document.getElementById('features').addEventListener('touchstart', function(e) {
                    // Yatay kaydırma için wowBook'a bırak, dikey için sayfanın scroll etmesine izin ver
                    var touch = e.touches[0];
                    this._startY = touch.clientY;
                    this._startX = touch.clientX;
                }, { passive: true });

                document.getElementById('features').addEventListener('touchmove', function(e) {
                    if (!this._startY || !this._startX) return;
                    var diffX = Math.abs(e.touches[0].clientX - this._startX);
                    var diffY = Math.abs(e.touches[0].clientY - this._startY);
                    // Dikey scroll ise sayfanın scroll etmesine izin ver (preventDefault'u çağırma)
                    if (diffY > diffX) {
                        return; // dikey - sayfayı scroll ettir
                    }
                }, { passive: true });
            }
        });
    </script>

    <script src="~/wowbook/js/plugins.js"></script>
    <script src="~/wowbook/js/script.js"></script>
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
}
