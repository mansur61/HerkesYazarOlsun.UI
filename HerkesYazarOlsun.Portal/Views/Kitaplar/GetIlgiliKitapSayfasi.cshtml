@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_PAGES
@using HerkesYazarOlsun.Portal.Controllers;

@{
    string tip = "ilgilisayfaguncelle";
}
<input type="hidden" id="tip" value="@tip" />

@if (Model != null)
{
    <input type="hidden" id="sayfayazi" value="@Model.PageWrite" />
    <input type="hidden" id="sayfaId" value="@Model.ID" />

    @* <div style="background-color:white;overflow:auto;overflow-x: hidden;text-align: justify;height:250px;width:auto;padding-right:15px" id="syfYazi">
        @Model.PageWrite
    </div>*@
    <textarea id="syfYazi" cols="100" rows="30">
        @Model.PageWrite
        </textarea>
    <div style="height:20px"></div>

    <button class="btn btn-warning" onclick="Guncelle()">
        Güncelle
    </button>

    <div style="height:20px"></div>
    @*<div id="sonucula"></div>*@
    @Html.Partial("_AlertMesaj",@tip)

    <div style="height:50px"></div>
}
<script type="text/javascript">
    var guncelleElement = document.getElementById("syfYazi");
    guncelleElement.contentEditable = "true";
    function Guncelle() {
        var kitapSayfa = $("#sayfayazi").val();
        var id = $("#sayfaId").val();
        var tip = $("#tip").val();
        var syfYazi = $("#syfYazi").val();
        $.post("@Url.Action(nameof(KitaplarController.PostBooksPageUpdate), "Kitaplar")", { "ID": id, "PageWrite": syfYazi },
            function (data) {
                if (data.state == 1) {
                    $("#basarili-" + tip).css("display", "block");
                    $("#basarili-" + tip + " #mesaj").html("Güncellendi");

                    $("#bilgi-" + tip).css("display", "none");
                    $("#uyari-" + tip).css("display", "none");
                    
                    setTimeout(function () {
                        var link = window.location.href;

                        window.location.href = link;
                        console.log("link " + link);

                        window.location.reload()

                    }, 3000);
                }
                else if (data.state == 3) {
                    $("#bilgi-" + tip).css("display", "block");
                    $("#bilgi-" + tip + " #mesaj").html("Güncellenemedi");

                    $("#basarili-" + tip).css("display", "none");
                    $("#uyari-" + tip).css("display", "none");
                }
                else {
                    $("#uyari-" + tip).css("display", "block");
                    $("#bilgi-" + tip).css("display", "none");
                    $("#basarili-" + tip).css("display", "none");
                    $("#uyari-" + tip + " #mesaj").html("Güncellenemedi");
                }

            });

    }

    $(document).ready(function () {
        $("#sonucula").css("display", "none");
    });
</script>