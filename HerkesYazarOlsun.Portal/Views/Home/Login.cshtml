@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{

	<link href="~/lib/bootstrap/dist/css/style_aroma_template.css" rel="stylesheet" />
}
<section class="login_box_area section-margin">
	<div class="container">
		<div class="row">
			<div class="col-lg-6">
				<div class="login_box_img">
					<div class="hover">
						<h4>Herkes Yazar Olsun' a Hoşgeldiniz !</h4>
						<p>Giriş ve Kayıt işlemlerinizi gerçekleştiriniz. Sizinle danışmaktan mutluluk duyuyaoruz.</p>
						<a class="button button-account" href="/Home/Register">Kayıt Olunuz</a>
					</div>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="login_form_inner">
					<h3>Giriş Yapınız</h3>
					<form class="row login_form" action="#/" id="contactForm">
						<div class="col-md-12 form-group">
							<input type="text" class="form-control" id="name" name="name" placeholder="Kullanici Adi" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Kullanici Adi'">
						</div>
						<div class="col-md-12 form-group">
							<input type="text" class="form-control" id="name" name="name" placeholder="Şifre" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Şifre'">
						</div>
						<div class="col-md-12 form-group">
							<div class="creat_account">
								<input type="checkbox" id="f-option2" name="selector">
								<label for="f-option2">Oturumumu açık tut</label>
							</div>
						</div>
						<div class="col-md-12 form-group">
							<button type="submit" value="submit" class="button button-login w-100">Giriş Yap</button>
							<a href="#">Şifrenizi mi unuttunuz?</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>

@section scripts{

	<script src="~/lib/bootstrap/dist/js/main_aroma_template.js"></script>
}