@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{

    <link href="~/lib/bootstrap/dist/css/style_aroma_template.css" rel="stylesheet" />
}

@using HerkesYazarOlsun.Portal.Controllers;
@model HerkesYazarOlsun.Model.ViewModel.VM_LOGIN;



<input type="hidden" id="loginicin" value="logingiris" />
@{
    string alertmesajgostermedurumu = "logingiris";
}

<section class="login_box_area section-margin">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="login_box_img">
                    <div class="hover">
                        <h4>Herkes Yazar Olsun' a Hoşgeldiniz !</h4>
                        <p>Giriş ve Kayıt işlemlerinizi gerçekleştiriniz. Sizinle danışmaktan mutluluk duyuyaoruz.</p>
                        <a class="button button-account" href="/Home/Register">Kayıt Olunuz</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="login_form_inner" style="height:auto" >
                    <h3>Giriş Yapınız</h3>
                   
                    @*<form action="@Url.Action(nameof(AccountController.Login), "Account")" ajax-success="onSuccess" 
                             failure="onFailed" ajax="true" ajax-method="POST" id="contactForm" class="row login_form">*@
                    <div id="contactForm" class="row login_form">
                        <div class="col-md-12 form-group">
                            <input type="text" class="form-control" id="email" name="email" placeholder="Email Adresiniz" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Email Adresiniz'">
                        </div>
                        <div class="col-md-12 form-group">
                            <input type="text" class="form-control" id="sifre" name="sifre" placeholder="Şifre" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Şifre'">
                        </div>
                        <div class="col-md-12 form-group">
                            <div class="creat_account">
                                @if(@Model.benihatirla != null)
                                {
                                    @if (@Model.benihatirla == "0")
                                    {
                                        <input type="checkbox" id="hatirla" name="benihatirla" onclick='handleClick(this);' value="false">
                                    }
                                    else
                                    {
                                        <input type="checkbox" id="hatirla" name="benihatirla" onclick='handleClick(this);' checked value="true">
                                    }
                                }
                                else
                                {
                                    <input type="checkbox" id="hatirla" name="benihatirla" onclick='handleClick(this);' value="false">
                                }
                               

                                <label for="f-option2">Oturumumu açık tut</label>
                            </div>
                        </div>
                        <div class="col-md-12 form-group">
                            <button class="button button-login w-100" onclick="Giris()">Giriş Yap</button>
                        @*type="submit"*@
                        <a href="/Home/SifremiUnuttum">Şifrenizi mi unuttunuz?</a>
                        </div>
                    </div>
                    @*</form>*@
                    @Html.Partial("_AlertMesaj",@alertmesajgostermedurumu)
               </div>
            </div>
        </div>
    </div>
</section>

<script>

    var rememberlogin = false;
    if ($("#hatirla").val() == "false") {
        rememberlogin = false;
    }else{
        rememberlogin = true;
    }
   
    var login = $("#loginicin").val();  

    function handleClick(cb) {
        rememberlogin = cb.checked;
        console.log("rememberlogin:" + rememberlogin);
    }

    function onSuccess(data) {

        if (data.state == 1) {
            $("#basarili-" + login).css("display", "block");
            $("#basarili-" + login + " #mesaj").html(data.message);

            $("#bilgi-" + login).css("display", "none");
            $("#uyari-" + login).css("display", "none");

            window.location.href = "/Home/Index";

        }
        else if (data.state == 3) {
            $("#bilgi-" + login).css("display", "block");
            $("#bilgi-" + login + " #mesaj").html(data.message);

            $("#basarili-" + login).css("display", "none");
            $("#uyari-" + login).css("display", "none");
        }
        else {
            $("#uyari-" + login).css("display", "block");
            $("#bilgi-" + login).css("display", "none");
            $("#basarili-" + login).css("display", "none");
            $("#uyari-" + login + " #mesaj").html(data.message);
        }

        //if (data.message != "") {

        //    toastrError(data.message, "Hata!");
        //}
        //else {
        //    window.location.replace(data.redirecturl);
        //}
    }

    function onFailed(data) {
        //toastrError("İşlem Gerçekleşemedi:" + data, "Hata!");
        if (data.state == 3) {
            $("#bilgi-" + login).css("display", "block");
            $("#bilgi-" + login + " #mesaj").html(data.message);

            $("#basarili-" + login).css("display", "none");
            $("#uyari-" + login).css("display", "none");
        }
        else {
            $("#uyari-" + login).css("display", "block");
            $("#bilgi-" + login).css("display", "none");
            $("#basarili-" + login).css("display", "none");
            $("#uyari-" + login + " #mesaj").html(data.message);
        }
    }

    function Giris() {
        var email = $("#email").val();
        var sifre = $("#sifre").val();
       
        $.post("@Url.Action(nameof(AccountController.Login), "Account")", {
            "RememberLogin": rememberlogin,
            "email": email,
            "sifre": sifre,
            "benihatirla": rememberlogin ==  false ? "0" : "1"

        }, function (data) {
            if (data.state == 1) {
                $("#basarili-" + login).css("display", "block");
                $("#basarili-" + login + " #mesaj").html(data.message + " Giriş işlemi Başarılı Anasayfaya yönlendiriliyorsunuz.");

                $("#bilgi-" + login).css("display", "none");
                $("#uyari-" + login).css("display", "none");

                setTimeout(function () {
                  
                    window.location.href = "/Home/Index";
                }, 5000);
            }
            else if (data.state == 3) {
                $("#bilgi-" + login).css("display", "block");
                $("#bilgi-" + login + " #mesaj").html(data.message);

                $("#basarili-" + login).css("display", "none");
                $("#uyari-" + login).css("display", "none");
            }
            else {
                $("#uyari-" + login).css("display", "block");
                $("#bilgi-" + login).css("display", "none");
                $("#basarili-" + login).css("display", "none");
                $("#uyari-" + login + " #mesaj").html(data.message);
            }

        });

    }


</script>