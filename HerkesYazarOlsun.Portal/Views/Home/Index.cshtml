@section Styles {
    <link href="~/lib/owlcarousel/dist/assets/owl.carousel.min.css" rel="stylesheet" />
    <style>
        .sidebar-sticky {
            position: sticky;
            top: 20px;
        }
        /* NAV CONTAINER */
.owl-nav {
    position: absolute;
    top: 50%;
    width: 100%;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
}

/* BUTTONS */
.owl-nav button {
    pointer-events: all;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0,0,0,0.6) !important;
    color: #fff !important;
    border: none !important;
    font-size: 22px !important;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all .25s ease;
}

/* HOVER */
.owl-nav button:hover {
    background: #0d6efd !important;
    transform: scale(1.1);
}

/* LEFT / RIGHT POSITION */
.owl-prev {
    margin-left: -22px;
}

.owl-next {
    margin-right: -22px;
}

/* DISABLED */
.owl-nav button.disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

/* MOBILE */
@@media (max-width: 768px) {
    .owl-nav button {
        width: 36px;
        height: 36px;
        font-size: 18px !important;
    }
    .owl-nav button span {
    display: none;
}

.owl-prev::before {
    content: "❮";
}

.owl-next::before {
    content: "❯";
}

}

    </style>
}
