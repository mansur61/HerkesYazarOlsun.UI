@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<br />

@section scripts{
    <script src="~/lib/bootstrap/dist/js/jquery-1.10.2.js"></script>
}
@section Styles{
    <link href="~/lib/bootstrap/dist/css/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/kitap_arama_style.css" rel="stylesheet" />
}


@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS;
<div class="container">

    <div class="row">
        <div class="col-md-3">
            <br />

            <ul class="list-group list-group-horizontal">

                <li class="list-group-item"><a href="/Kitaplar/TumKitaplar">Tüm Kitaplar</a> </li>
                <li class="list-group-item"><a href="/Kisi/TumYazarlar">Tüm Yazarlar</a></li>
                <li class="list-group-item"><a href="">Yayın Evini Kazanan Kitaplar</a></li>
                <li class="list-group-item"><strong><a style="font-size:20px" href="/Kitaplar/KitapOlustur">KİTAP YAZ</a></strong></li>
                <li class="list-group-item"><strong><a href="/Kitaplar/KitapEkleWordOrPdf"><span style="font-size:20px">WORD</span> veya <span style="font-size:20px">PDF</span>'ten Aktarım</a></strong></li>
            </ul>
        </div>
        <div class="col-md-9">
            @Html.Partial("_Carousel")

        </div>
    </div>
</div>

<br />
@{
    string tipsec = "";
}
<div class="row">
    <div class="col-md-9">
        <h3>
            En Çok Yıldız Alan Kitaplar
        </h3>
    </div>
</div>

@{
    tipsec = "yayin";
    Model.Tip = @tipsec;
}

@Html.Partial("_KitapSliderGosterimleri", @Model)
@* @Model.VMBooksList.Where(p => p.Stars.HangiStar == "4" || p.Stars.HangiStar == "5").ToList() *@

<div style="height:50px;"></div>

<div class="row">
    <div class="col-md-9">
        <h3>
            En Çok Yorum Alan Kitaplar
        </h3>
    </div>
</div>

@{
    tipsec = "begenilen";
    Model.Tip = @tipsec;
}

@Html.Partial("_KitapSliderGosterimleri",@Model)

<div style="height:50px;"></div>


<div class="row">
    <div class="col-md-9">
        <h3>
            Diğer Kitaplar
        </h3>
    </div>
</div>

@{
    tipsec = "okunan";
    Model.Tip = @tipsec;
}

@Html.Partial("_KitapSliderGosterimleri",@Model)


<div style="height:100px;"></div>


@Html.Partial("_Sponsorlar")
