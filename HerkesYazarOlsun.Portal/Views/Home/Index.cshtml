@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL
@using HerkesYazarOlsun.Model.ViewModel
@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string isGozlemciMod = User.GetGozlemciMod();

     var temp = Model.VMBooksList?.ToList(); //   Kopya liste oluştur
    var tempDigerBookList = temp?.ToList();
    var tempYorumBookList = temp?.ToList();
    var tempYildizBookList = temp?.ToList();
}
 

@section Styles {
    <link href="~/lib/owlcarousel/dist/assets/owl.carousel.min.css" rel="stylesheet" />
    <style>
        .sidebar-sticky {
            position: sticky;
            top: 20px;
        }
    </style>
}

<div class="container-fluid">
    <div class="row">

        <!-- 🔹 SIDEBAR -->
        <aside class="col-md-3 sidebar-sticky">
            <ul class="list-group">
                <li class="list-group-item">
                    📚 <a href="/Kitaplar/TumKitaplar">Tüm Kitaplar</a>
                </li>
                <li class="list-group-item">
                    👤 <a href="/Kisi/TumYazarlar">Tüm Yazarlar</a>
                </li>
                <li class="list-group-item">
                    🏢 <a href="/Kitaplar/YayinEviKitaplar?YayinlananKitaplar=true">
                        Yayın Evini Kazanan Kitaplar
                    </a>
                </li>

                @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
                {
                    <li class="list-group-item fw-bold">
                        ✏️ <a href="/Kitaplar/KitapOlustur?isYazmayaDevamEt=false">KİTAP YAZ</a>
                    </li>
                    <li class="list-group-item fw-bold">
                        ⬆️📄 <a href="/Kitaplar/KitapEkleWordOrPdf">WORD / PDF Aktar</a>
                    </li>
                }
            </ul>
        </aside>

        <!-- 🔹 SLIDER ALANI -->
        <main class="col-md-6 offset-md-1">
            mansur
            @Html.Partial("_Carousel")

        </main>
    </div>
</div>

@{
    string tipsec = "";    
}
<div class="row">
    <div class="col-md-9">
        <h3>
            5 Yıldız Alan Kitaplar
        </h3>
    </div>
</div>

@functions {
    private string GetDominantStar(VM_Stars stars)
    {
        var values = new Dictionary<string, int>
        {
            { "yildiz1", stars.BirStarToplam },
            { "yildiz2", stars.IkiStarToplam },
            { "yildiz3", stars.UcStarToplam },
            { "yildiz4", stars.DortStarToplam },
            { "yildiz5", stars.BesStarToplam }
        };
        if (values.All(v => v.Value == 0))
            return "yildiz0";

        int maxValue = values.Max(v => v.Value);
        var maxItems = values.Where(v => v.Value == maxValue).ToList();

        if (maxItems.Count > 1)
            return "yildiz5";

        return maxItems.First().Key;
    }
}

@{
    tipsec = "yildizalan"; 
    Model.Tip = @tipsec;    
    tempYildizBookList = temp
         .Where(p => GetDominantStar(p.Stars) == "yildiz5")
         .ToList();
    Model.VMBooksList = tempYildizBookList;
}
 

@Html.Partial("_KitapSliderGosterimleri", @Model)

<div style="height:50px;"></div>

<div class="row">
    <div class="col-md-9">
        <h3>
            En Çok Yorum Alan 10 Kitaplar 
        </h3>
    </div>
</div> 
@{
    
    tipsec = "yorumalan";
    Model.Tip = @tipsec;
    // Yorum sayısına göre sıralanmış en çok yorum alan 10 kitabı seç
    Model.VMBooksList = temp;
    tempYorumBookList = temp.Where(p => p.Stars.HangiStar != "yildiz5" && p.BooksComments?.Count > 0)
                     .OrderByDescending(b => b.BooksComments?.Count) 
     //.Take(10)
     .ToList();
    Model.VMBooksList = tempYorumBookList;
} 

@Html.Partial("_KitapSliderGosterimleri",@Model)

<div style="height:50px;"></div>


<div class="row">
    <div class="col-md-9">
        <h3>
            Diğer Kitaplar 
        </h3>
    </div>
</div>

@{
    tipsec = "digerkitaplar"; 
    Model.Tip = @tipsec;
    Model.VMBooksList = temp;
    // İlk 10 yorum alan ve 5 yıldızlı kitapları hariç tut
    tempDigerBookList = temp 
         .Where(p => !p.BooksComments.Any()) // hiç yorum almayanlar
            .Where(p => p.Stars.HangiStar != "yildiz5")       // 5 yıldızlı olmayanlar
    .ToList();
    Model.VMBooksList = tempDigerBookList;
} 

@Html.Partial("_KitapSliderGosterimleri",@Model)


<div style="height:100px;"></div>


@Html.Partial("_Sponsorlar")
<br />
 
<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/nice-select/js/jquery.nice-select.min.js"></script>
<script src="~/lib/owlcarousel/dist/owl.carousel.min.js"></script>
<script src="~/js/kitap-arama.js"></script>

@section Scripts { 

    <script>
        $(function () {
            $('#owl-@Model.Tip').owlCarousel({
                loop: false,
                margin: 15,
                nav: true,     // ← ileri geri
                dots: true,    // ← senin <ol><li> yerine
                responsive: {
                    0: { items: 1 },
                    768: { items: 4 },
                    1200: { items: 5 } // ← 5 kitap = 1 sayfa
                }
            });
        });
    </script>
}
