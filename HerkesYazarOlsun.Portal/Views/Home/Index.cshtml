@{
    string tipsec = "";    
}

@functions {
    private string GetDominantStar(VM_Stars stars)
    {
        var values = new Dictionary<string, int>
        {
            { "yildiz1", stars.BirStarToplam },
            { "yildiz2", stars.IkiStarToplam },
            { "yildiz3", stars.UcStarToplam },
            { "yildiz4", stars.DortStarToplam },
            { "yildiz5", stars.BesStarToplam }
        };
        if (values.All(v => v.Value == 0))
            return "yildiz0";

        int maxValue = values.Max(v => v.Value);
        var maxItems = values.Where(v => v.Value == maxValue).ToList();

        if (maxItems.Count > 1)
            return "yildiz5";

        return maxItems.First().Key;
    }
}


<div class="row">
    <div class="col-md-9">
        <h3>
            5 Yıldız Alan Kitaplar
        </h3>
    </div>
</div>


@{
    var yildizModel = new VM_BOOKS_DETAIL
    {
        Tip = "yildizalan",
        VMBooksList = temp
            .Where(p => GetDominantStar(p.Stars) == "yildiz5")
            .ToList(),
        isAnaSayfa = true
    };
}

@Html.Partial("_KitapSliderGosterimleri", yildizModel)

<div class="row">
    <div class="col-md-9">
        <h3>
            En Çok Yorum Alan 10 Kitaplar 
        </h3>
    </div>
</div> 
 
@{
    var yorumModel = new VM_BOOKS_DETAIL
    {
        Tip = "yorumalan",
        VMBooksList = temp
            .Where(p => p.Stars.HangiStar != "yildiz5" && p.BooksComments?.Count > 0)
            .OrderByDescending(p => p.BooksComments.Count)
            .ToList(),
        isAnaSayfa = true
    };
}

@Html.Partial("_KitapSliderGosterimleri", yorumModel)

 
@{
    var digerModel = new VM_BOOKS_DETAIL
    {
        Tip = "digerkitaplar",
        VMBooksList = temp
            .Where(p => !p.BooksComments.Any())
            .Where(p => p.Stars.HangiStar != "yildiz5")
            .ToList(),
        isAnaSayfa = true
    };
}

<div class="row">
    <div class="col-md-9">
        <h3>
            Diğer Kitaplar 
        </h3>
    </div>
</div>

@Html.Partial("_KitapSliderGosterimleri", digerModel)

 

