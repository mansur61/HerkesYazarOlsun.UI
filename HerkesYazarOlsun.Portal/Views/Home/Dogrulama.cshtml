@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_USERS;
@using HerkesYazarOlsun.Portal.Controllers;

 

@section Styles {
    <link href="~/lib/css/giris_kayit_dogrulama.css" rel="stylesheet" />
}

 
<section>
    <div class="container">
        <div class="row">

            <!-- SOL PANEL -->
            <div class="col-lg-6 mb-4">
                <div id="title-container">
                    <h4>Herkes Yazar Olsun' da</h4>
                    <h4>Doğrulama İşlemleri</h4>
                    <p>Mail veya SMS ile doğrulama adımını tamamlayabilirsiniz.</p>
                </div>
            </div>

            <!-- SAĞ PANEL -->
            <div class="col-lg-6">
                <div class="login_form_inner register_form_inner">

                    <h3>Doğrulama Yapınız</h3>

                    <div id="register_form" class="row login_form">

                        <div class="d-flex align-items-center justify-content-center gap-3">

                            <a href="/Email/EmailDogrula/"
                               class="auth-secondary-btn flex-fill text-center">
                                Mail Doğrulama
                            </a>

                            <span class="mx-2">Veya</span>

                            <a href="/Sms/SmsDogrula/"
                               class="auth-primary-btn flex-fill text-center">
                                SMS Doğrulama
                            </a>

                            <div id="loading" style="display:none; text-align:center;">
                                <img src="https://i.gifer.com/ZZ5H.gif" style="width:50px; height:50px;">
                            </div>
                        </div>

                    </div>

                   

                </div>
            </div>
        </div>
    </div>
</section>


<div style="height:150px"></div>
 