@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "~/Views/Shared/_LayoutOnlyScript.cshtml";
}

@section Styles{
    <style>
       
        /* Kartların arasındaki ikon + ok */
        .step-connector {
            text-align: center;
            margin: 40px 0;
            position: relative;
        }

        .connector-icon {
            width: 90px;
            height: 90px;
            object-fit: contain;
            animation: fadeIn 1.2s ease, floatAnim 4s ease-in-out infinite;
            opacity: 0.95;
        }

        /* Aşağıya doğru küçük zarif ok */
        .arrow-down {
            width: 18px;
            height: 18px;
            border-left: 3px solid #4CAF50;
            border-bottom: 3px solid #4CAF50;
            transform: rotate(-45deg);
            margin: 10px auto 0;
            animation: arrowBounce 1.6s infinite;
        }

        /* Fade-in efekti */
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: scale(0.6);
        }

        to {
            opacity: 1;
            transform: scale(1);
        }

        }

        /* Hafif yukarı-aşağı "floating" efekti */
        @@keyframes floatAnim {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }

        }

        /* Ok zıplama efekti */
        @@keyframes arrowBounce {
            0%, 100%

        {
            transform: rotate(-45deg) translateY(0);
        }

        50% {
            transform: rotate(-45deg) translateY(5px);
        }

        }

        /* Mobil uyumlu */
        @@media(max - width: 768px)

        {
            .connector-icon

        {
            width: 60px;
            height: 60px;
        }

        }

        /* Logo üstte ortalanmış */
        .center-logo-top {
            width: 100%;
            text-align: center;
            margin: 20px 0; /* üst-alt boşluk */
        }

        /* Logo boyutu ve animasyon */
        .center-logo-top-img {
            width: 140px; /* Masaüstü */
            height: 140px;
            max-width: 90%;
            object-fit: contain;
            animation: fadeIn 1.2s ease, floatAnim 4s ease-in-out infinite;
            opacity: 0.95;
            transition: transform 0.3s ease;
        }

            /* Hover hafif büyüme */
            .center-logo-top-img:hover {
                transform: scale(1.08);
            }

        /* Fade-in animasyonu */
        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        /* Hafif yukarı-aşağı animasyon */
        @@keyframes floatAnim {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }

        }

        /* Mobil uyum */
        @@media(max - width: 768px)

        {
            .center-logo-top-img

        {
            width: 90px;
            height: 90px;
        }

        .center-logo-top {
            margin: 15px 0;
        }

        }
@@media (max-width: 768px) {

    .vh-100 {
        height: auto !important;
        min-height: auto !important;
    }

    .row.align-items-center {
        padding: 30px 15px !important;
    }

    .row.align-items-center .col-md-4,
    .row.align-items-center .col-md-8 {
        margin-bottom: 20px;
    }

}

    </style>
}

<div class="center-logo-top">
    <img src="@Url.Content( "~/lib/img/book_2.png")" class="center-logo-top-img" />
</div>


<div class="container p-20" style="overflow-x:hidden; background-color:#ffffff;">
  
    
    <!-- Adım 1 -->
    <div class="row align-items-center vh-100 p-5">
       
        <div class="col-md-4 reveal-left">
            <div class="card onboarding-card h-100 p-4 shadow-sm" style="border:none; background:#f9fdf9; font-size:20px;padding:15px">
                <h5 class="card-title fw-semibold fs-3" style="color:#4CAF50; font-family:'Poppins', sans-serif;">✍️ Yazmaya Başla</h5>
                <p class="card-text text-dark" style="font-family:'Roboto', sans-serif;">
                    Kendi hikayelerini, şiirlerini veya romanlarını kolayca yaz. <strong>Herkes Yazar Olsun</strong> modern bir yazım ortamı sunar.
                </p>
            </div>
        </div>
        <div class="col-md-8 reveal-right">
            <div class="card onboarding-card h-100 p-4 shadow-sm" style="border:none; background:#fff; font-size:20px;">
                <p style="font-family:'Roboto', sans-serif; color:#555; line-height:1.6;">
                    Hayal gücünüzü özgür bırakın ve kendi dünyanızı yaratın.<br>
                    Fikirlerinizi düzenleyebilir, metinlerinizi kategorilere ayırabilir ve projelerinizi yönetebilirsiniz.<br>                                  
                    Hikayenizi başkalarıyla paylaşmadan önce önizleme yapabilirsiniz.<br>
                    Kolay kaydetme ve otomatik yedekleme sayesinde verileriniz güvende kalır.<br>
                    İlk adımı atın ve kendi eserinizin yaratıcısı olun.
                </p>
            </div>
        </div>
    </div>
    <div class="step-connector">
        <img src="~/lib/img/stack-of-books.png" class="connector-icon" />
        <div class="arrow-down"></div>
    </div>
    <br />
    <!-- Adım 2 (ters yerleşim) -->
    <div class="row align-items-center vh-100 p-5">
        <div class="col-md-8 reveal-left">
            <div class="card onboarding-card h-100 p-4 shadow-sm" style="border:none; background:#fff; font-size:20px;">
                <p style="font-family:'Roboto', sans-serif; color:#555; line-height:1.6;">
                    Eserinizi yayınlamak hiç bu kadar kolay olmamıştı.<br>
                    Profesyonel yayınevleri ile uygun anlaşmalar yapılır.<br>
                    Kapak tasarımı ve içerik düzenlemeleri konusunda destek sağlanır.<br> 
                    Yayın süreci boyunca rehberlik ve öneriler sunulur.<br>
                    Hedef kitlenize ulaşmak için pazarlama stratejileri paylaşılır.<br>
                    Kitabınız, profesyonel yayınevleri sayesind online mağazalarda satışa sunulur.<br>
                    Fiyatlandırma ve telif hakları konusunda detaylı bilgi verilir.<br>
                    Başarıya giden yolculuğunuz burada başlar.
                </p>
            </div>
        </div>
        <div class="col-md-4 reveal-right">
            <div class="card onboarding-card h-100 p-4 shadow-sm" style="border:none; background:#f9fdf9; font-size:20px;padding:5px">
                <h5 class="card-title fw-semibold fs-3" style="color:#4CAF50; font-family:'Poppins', sans-serif;">📚 Eserini Yayınla</h5>
                <p class="card-text text-dark" style="font-family:'Roboto', sans-serif;">
                    Kitabını tamamladıktan sonra, sponsor yayınevleri sayesinde uygun şartlarda yayınlayabilirsin.
                </p>
            </div>
        </div>
    </div>
    <div class="step-connector">
        <img src="~/lib/img/stack-of-books.png" class="connector-icon" />
        <div class="arrow-down"></div>
    </div>
    <br />
    <!-- Adım 3 -->
    <div class="row align-items-center vh-100 p-5">
        <div class="col-md-4 reveal-left">
            <div class="card onboarding-card h-100 p-4 shadow-sm" style="border:none; background:#f9fdf9; font-size:20px;padding:15px">
                <h5 class="card-title fw-semibold fs-3" style="color:#4CAF50; font-family:'Poppins', sans-serif;">🤝 Toplulukla Buluş</h5>
                <p class="card-text text-dark" style="font-family:'Roboto', sans-serif;">
                    Diğer yazarlarla tanış, fikir alışverişi yap ve eserini yorumlarla geliştirme fırsatı bul.
                </p>
            </div>
        </div>
        <div class="col-md-8 reveal-right">
            <div class="card onboarding-card h-100 p-4 shadow-sm" style="border:none; background:#fff; font-size:20px;">
                <p style="font-family:'Roboto', sans-serif; color:#555; line-height:1.6;">
                    Yazarlık topluluğuna katılın ve diğer yazarlarla bağlantı kurun.<br>
                    Fikir alışverişi ile yazılarınızı geliştirin.<br>
                    Deneyimli yazarların önerilerini alın.<br>
                    Eserlerinize yorum ve geri bildirim alın.<br>  
                    Topluluk içi ödüller ve rozetler kazanabilirsiniz.<br>
                    Yazarlık yolculuğunuzda yalnız değilsiniz.<br>
                    İlham verici bir ortamda kendinizi geliştirin.
                </p>
            </div>
        </div>
    </div>

</div>
<br />
<br />

<div class="card onboarding-card h-100 p-4 shadow-sm" style="border:none; background:#f9fdf9; font-size:20px; padding:15px;text-align:center;">
    <h5 class="card-title fw-semibold fs-3" style="color:#4CAF50; font-family:'Poppins', sans-serif;">✍️ Haydi Sende</h5>
    <p class="card-text text-dark" style="font-family:'Roboto', sans-serif;">
        Kendi hikayelerini, şiirlerini veya romanlarını kolayca yazmaya başla 
    </p>
    <div class="text-center mt-4">
        <a href="/Account/KayitOl" class="btn btn-success px-4 py-2 fw-bold" style="font-family:'Poppins', sans-serif; font-size:18px;">
            📖 Kayıt Olunuz
        </a>
    </div>
</div>



<style>
    .onboarding-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 12px;
    }

        .onboarding-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.25);
        }

        .onboarding-card:active {
            transform: translateY(-5px) scale(0.98);
        }

    .reveal-left, .reveal-right {
        opacity: 0;
        transform: translateX(-50px);
        transition: all 0.6s ease;
    }

    .reveal-right {
        transform: translateX(50px);
    }

        .reveal-left.active, .reveal-right.active {
            opacity: 1;
            transform: translateX(0);
        }
</style>

<script>
    $(document).ready(function(){
        function reveal() {
            $(".reveal-left, .reveal-right").each(function(){
                var topOfElement = $(this).offset().top;
                var bottomOfWindow = $(window).scrollTop() + $(window).height();
                if(bottomOfWindow > topOfElement + 50){
                    $(this).addClass("active");
                }
            });
        }
        $(window).on("scroll", reveal);
        reveal();
    });
</script>
 
 