@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles{

	<link href="~/lib/bootstrap/dist/css/style_aroma_template.css" rel="stylesheet" />
}
<section class="login_box_area section-margin">
	<div class="container">
		<div class="row">
			<div class="col-lg-6">
				<div class="login_box_img">
					<div class="hover">
						<h4>Herkes Yazar Olsun' a Hoşgeldiniz !</h4>
						<p>Şifrenizi Yenileyiniz..</p>
						@*<a class="button button-account" href="/Account/Register">Kayıt Olunuz</a>*@
					</div>
				</div>
			</div>
			<div class="col-lg-6">
				<div class="login_form_inner">
					<h3>Şifremi Unuttum</h3>
					<form class="row login_form" action="#/" id="contactForm">
						<div class="col-md-12 form-group">
							<input type="text" class="form-control" id="mail" name="mail" placeholder="Mailinizi Giriniz" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Mailinizi Giriniz'">
						</div>
						<div class="col-md-12 form-group">
							<input type="text" class="form-control" id="ySifre" name="ySifre" placeholder="Yeni Şifre" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Yeni Şifre'">
						</div>
						@*<div class="col-md-12 form-group">
							<input type="text" class="form-control" id="ySifreTekrar" name="ySifreTekrar" placeholder="Yeni Şifre Tekrar" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Yeni Şifre Tekrar'">
						</div>*@
						
						<div class="col-md-12 form-group">
							<button type="submit" value="submit" class="button button-login w-100">Şifre Yenile</button>
							
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
</section>

@*@section scripts{

	<script src= "~/lib/bootstrap/dist/js/main_aroma_template.js"></script>
}*@