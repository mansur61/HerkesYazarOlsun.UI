@{
    ViewData["Title"] = "Yazarlık Rehberi | Herkes Yazar Olsun";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Meta {
    <meta name="description" content="Yazarlığa başlamak isteyenler için kapsamlı yazarlık rehberi. Roman ve hikâye yazma teknikleri, yazma alışkanlığı kazanma yolları ve yayınlama süreci." />
    <meta name="robots" content="index, follow" />
}

<div class="container py-5" style="max-width:1100px">

    <!-- Hero -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">✍️ Yazarlık Rehberi</h1>
        <p class="text-muted fs-5 mt-3">
            Yazarlık yolculuğuna başlamak isteyenler için hazırlanmış,
            bilgilendirici ve rehber niteliğinde içerikler.
        </p>
    </div>

    <!-- Article 1 -->
    <article class="mb-5">
        <h2 class="fw-bold mb-3">Yazar Nasıl Olunur?</h2>

        <img src="https://images.unsplash.com/photo-1455390582262-044cdead277a?auto=format&fit=crop&w=1100&q=80"
             class="img-fluid rounded mb-4"
             alt="Yazar nasıl olunur">

        <p>
            Yazar olmak birçok kişinin hayalini süsler. Ancak bu yolculuk,
            ilhamdan çok disiplin, sabır ve süreklilik gerektirir.
            Yazarlık doğuştan gelen bir yetenekten ziyade,
            zamanla geliştirilen bir beceridir.
        </p>

        <p>
            Başarılı yazarların ortak noktası düzenli yazma alışkanlığıdır.
            Her gün yazmak, düşünceleri kelimelere dökme yeteneğini güçlendirir
            ve yazma sürecini daha doğal hale getirir.
        </p>

        <h3>Yazmaya Başlamak</h3>
        <p>
            Yazarlığın ilk ve en önemli adımı yazmaya başlamaktır.
            İlham beklemek yerine belirli bir yazma rutini oluşturmak,
            yazarlık becerisinin gelişmesini sağlar.
        </p>

        <h3>Okuma Alışkanlığı</h3>
        <p>
            İyi bir yazar olmanın yolu iyi bir okuyucu olmaktan geçer.
            Farklı türlerde kitaplar okumak kelime dağarcığını genişletir,
            anlatım gücünü artırır.
        </p>
    </article>

    <hr class="my-5">

    <!-- Article 2 -->
    <article class="mb-5">
        <h2 class="fw-bold mb-3">Roman Yazma Teknikleri</h2>

        <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?auto=format&fit=crop&w=1100&q=80"
             class="img-fluid rounded mb-4"
             alt="Roman yazma teknikleri">

        <p>
            Roman yazmak uzun soluklu ve planlı bir süreçtir.
            Sağlam bir kurgu, inandırıcı karakterler ve tutarlı bir olay örgüsü
            romanın temel taşlarını oluşturur.
        </p>

        <p>
            Roman yazım sürecinde ön hazırlık yapmak,
            yazma aşamasını büyük ölçüde kolaylaştırır.
            Karakter profilleri ve olay akışı önceden planlanmalıdır.
        </p>

        <h3>Karakter Oluşturma</h3>
        <p>
            Okuyucunun bağ kurabileceği karakterler,
            romanın başarısını doğrudan etkiler.
            Karakterlerin geçmişi ve motivasyonları net olmalıdır.
        </p>

        <h3>Olay Örgüsü</h3>
        <p>
            Romanın başı, gelişme bölümü ve sonucu dengeli bir şekilde ilerlemelidir.
            Olaylar rastgele değil, mantıklı bir akışla ilerlemelidir.
        </p>
    </article>

    <hr class="my-5">

    <!-- Article 3 -->
    <article class="mb-5">
        <h2 class="fw-bold mb-3">Yazılan Eser Nasıl Yayınlanır?</h2>

        <img src="https://images.unsplash.com/photo-1509021436665-8f07dbf5bf1d?auto=format&fit=crop&w=1100&q=80"
             class="img-fluid rounded mb-4"
             alt="Kitap yayınlama süreci">

        <p>
            Eser tamamlandıktan sonra yayınlama süreci başlar.
            Günümüzde yazarlar için hem dijital hem de basılı yayıncılık
            seçenekleri bulunmaktadır.
        </p>

        <p>
            Dijital yayıncılık, yeni yazarlar için düşük maliyetli ve hızlı
            bir yayınlama imkânı sunar.
            Basılı yayıncılık ise daha geleneksel bir yoldur.
        </p>

        <h3>Dijital Yayıncılık</h3>
        <p>
            Dijital platformlar, eserin daha geniş bir kitleye ulaşmasını sağlar.
        </p>

        <h3>Yayınevleri ile Çalışmak</h3>
        <p>
            Profesyonel yayınevleri editörlük ve dağıtım desteği sunar.
        </p>
    </article>

    <hr class="my-5">

    <article class="mb-5">
        <h2 class="fw-bold mb-3">Yazma Alışkanlığı Nasıl Kazanılır?</h2>

        <img src="https://images.unsplash.com/photo-1491841550275-ad7854e35ca6?auto=format&fit=crop&w=1100&q=80"
             class="img-fluid rounded mb-4"
             alt="Yazma alışkanlığı kazanma">

        <p>
            Yazarlıkta en büyük zorluk yazmaya devam edebilmektir.
            Yazma alışkanlığı zamanla oluşur ve disiplinle güçlenir.
        </p>

        <p>
            Küçük hedeflerle başlamak, yazma sürecini sürdürülebilir kılar.
            Günlük kısa yazılar bile uzun vadede büyük ilerleme sağlar.
        </p>
    </article>

    <hr class="my-5">

    <article class="mb-5">
        <h2 class="fw-bold mb-3">Yeni Yazarların Yaptığı Yaygın Hatalar</h2>

        <img src="https://images.unsplash.com/photo-1506784983877-45594efa4cbe?auto=format&fit=crop&w=1100&q=80"
             class="img-fluid rounded mb-4"
             alt="Yazar hataları">

        <p>
            Yeni başlayan yazarlar genellikle benzer hatalar yapar.
            Bu hataların farkında olmak gelişim sürecini hızlandırır.
        </p>

        <p>
            İlham beklemek, eleştiriye kapalı olmak ve aceleci davranmak
            yazarlık yolculuğunda yapılan yaygın hatalardır.
        </p>
    </article>

    <!-- CTA -->
    <div class="card text-center p-4 shadow-sm bg-light border-0">
        <h4 class="fw-bold mb-2">✍️ Sen de Yazmaya Başla</h4>
        <p class="text-muted">
            Yazarlık yolculuğunu Herkes Yazar Olsun ile başlat.
        </p>
        <a href="/Account/KayitOl" class="btn btn-success px-4 py-2 fw-bold">
            Kayıt Ol
        </a>
    </div>

</div>
