@using HerkesYazarOlsun.Portal.Controllers
@{
    ViewData["Title"] = "İletişim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <style>
        .styled-title {
            font-weight: 700;
            font-size: 3.2rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            background: linear-gradient(45deg, #6fcf97, #27ae60);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            font-size: 1.1rem;
            color: #6c757d;
        }

        .custom-select {
            border-radius: 10px;
            padding: 10px 15px;
            font-size: 1rem;
            border: 1px solid #ced4da;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            transition: all 0.2s ease-in-out;
        }

        .custom-select:focus,
        .custom-select:hover {
            border-color: #6fcf97;
            box-shadow: 0 0 6px rgba(111,207,151,0.5);
        }

        .btn-green {
            background-color: #6fcf97;
            border-color: #6fcf97;
            color: #fff;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-green:hover {
            background-color: #5bbf87;
            border-color: #5bbf87;
            color: #fff;
        }
    </style>
}

<input type="hidden" id="iletisimicin" value="iletisim" />

@{
    string alertmesajgostermedurumu = "iletisim";
}

<!-- HERO / NAVBAR ALTI BAŞLIK -->
<div class="container-fluid bg-light py-5 mb-4 border-bottom">
    <div class="container text-center">
        <h1 class="styled-title mb-3">İletişim</h1>
        <p class="subtitle mb-0">
            Bizimle iletişime geçmek için aşağıdaki formu doldurun.
        </p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <!-- Ad Soyad -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ad Soyad</label>
                        <input type="text" class="form-control form-control-lg" id="ad" placeholder="Ad Soyad" required>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">E-Posta</label>
                        <input type="email" class="form-control form-control-lg" id="email" placeholder="E-posta adresiniz" required>
                    </div>

                    <!-- Konu -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Konu</label>
                        <select class="form-select custom-select" id="konuMenu" required>
                            <option value="" selected disabled>Konu Seçiniz</option>
                            <option value="1">Kitap Yayınlama</option>
                            <option value="2">Öneri Sunma</option>
                            <option value="3">Şikayet</option>
                            <option value="4">Ödeme İle Alakalı</option>
                            <option value="5">Sponsor Seçimi</option>
                        </select>
                    </div>

                    <!-- Mesaj -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Mesajınız</label>
                        <textarea class="form-control form-control-lg"
                                  id="mesaj"
                                  rows="5"
                                  placeholder="Lütfen mesajınızı buraya yazın..."
                                  required></textarea>
                    </div>

                    <!-- Gönder -->
                    <button type="submit"
                            class="btn btn-green w-100 py-3"
                            onclick="IletisimGonder()">
                        <i class="fas fa-paper-plane me-2"></i> Gönder
                    </button>

                </div>
            </div>

            <div class="mt-4">
                @Html.Partial("_AlertMesaj", alertmesajgostermedurumu)
            </div>

        </div>
    </div>
</div>

<script>
    var iletisim = $("#iletisimicin").val();

    var konuMenuId = 0;
    var konuText = "";

    document.getElementById("konuMenu").addEventListener("change", function () {
        konuMenuId = this.value;
        konuText = this.options[this.selectedIndex].text;
    });

    function IletisimGonder() {

        var ad = $("#ad").val();
        var email = $("#email").val();
        var konuMenuId = $("#konuMenu").val();
        var mesaj = $("#mesaj").val();

        if (!konuMenuId) {
            mesajGoster("uyari", "Konu seçilmelidir.");
            return;
        }

        if (ad === "" || email === "" || mesaj === "") {
            mesajGoster("uyari", "Ad, E-posta ve Mesaj alanları boş bırakılamaz.");
            return;
        }

        $.post("@Url.Action(nameof(TaleplerController.TalepKaydet), "Talepler")", {
            EMAIL: email,
            ADISOYADI: ad,
            KONU_ID: konuMenuId,
            KONU: konuText,
            MESAJ: mesaj
        }, function (data) {

            if (data.state == 1) {
                mesajGoster("basarili", data.message);
                Bilgilendir(email, mesaj);
            }
            else if (data.state == 3) {
                mesajGoster("bilgi", data.message);
            }
            else {
                mesajGoster("uyari", data.message);
            }
        });
    }

    function mesajGoster(tip, mesaj) {
        $("#uyari-" + iletisim).hide();
        $("#bilgi-" + iletisim).hide();
        $("#basarili-" + iletisim).hide();

        $("#" + tip + "-" + iletisim).show();
        $("#" + tip + "-" + iletisim + " #mesaj").html(mesaj);
    }

    function Bilgilendir(email, mesaj) {
        $.post("@Url.Action(nameof(EmailController.MailBilgilendirme), "Email")", {
            kime: "@ViewBag.MAIL",
            konu: "Herkes Yazar Olsun İletişim Formu",
            mesaj: email + " mail adresinden gelen mesaj -> " + mesaj
        });
    }
</script>
