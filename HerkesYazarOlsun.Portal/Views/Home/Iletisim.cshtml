@using HerkesYazarOlsun.Portal.Controllers
@{
    ViewData["Title"] = " ";
    Layout = "~/Views/Shared/_Layout.cshtml"; // header , slider kısmı yok
}

@section Styles {

    <style>
        .styled-title {
            font-weight: bold;
            font-size: 5.5rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 1px 1px 2px rgba(0, 100, 0, 0.6); /* yeşil gölge */
            background: linear-gradient(45deg, #6fcf97, #27ae60, #145a32); /* farklı yeşil tonları */
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            font-size: 2rem;
            color: #555;
            font-style: italic;
        }

        .custom-select {
            border-radius: 10px;
            padding: 10px 15px;
            font-size: 1rem;
            border: 1px solid #ced4da;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            transition: all 0.2s ease-in-out;
        }

            .custom-select:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 6px rgba(13,110,253,0.5);
            }

            .custom-select:hover {
                border-color: #0d6efd;
            }
    </style>
}

<input type="hidden" id="iletisimicin" value="iletisim" />

@{
    string alertmesajgostermedurumu = "iletisim";
}

<div class="text-center mb-4">
    <h1 class="styled-title">📢 İletişim Formu 📢</h1>
    <p class="subtitle">Bizimle iletişime geçmek için aşağıdaki formu doldurun. En kısa sürede size dönüş yapacağız.</p>
</div>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <!-- Ortalanmış form -->
            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-4">

                    <!-- Ad Soyad -->
                    <div class="mb-3">
                        <label for="ad" class="form-label fw-semibold">Ad Soyad</label>
                        <input type="text" class="form-control" placeholder="Ad Soyad" required id="ad">
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label for="email" class="form-label fw-semibold">E-Posta</label>
                        <input type="email" class="form-control" id="email" placeholder="E-Posta adresiniz" required>
                    </div>

                    <!-- Konu -->
                    <div class="mb-3">
                        <label for="konuMenu" class="form-label fw-semibold">Konu</label>
                        <br />
                        <select class="form-select custom-select" id="konuMenu" required>
                            <option value="" selected disabled>Konu Seçiniz</option>
                            <option value="1">Kitap Yayınlama</option>
                            <option value="2">Öneri Sunma</option>
                            <option value="3">Şikayet</option>
                            <option value="4">Ödeme İle Alakalı</option>
                            <option value="5">Sponsor Seçimi</option>
                        </select>
                    </div>
                    <br />
                    <!-- Mesaj -->
                    <div class="mb-3">
                        <label for="mesaj" class="form-label fw-semibold">Mesajınız</label>
                        <textarea class="form-control" placeholder="Lütfen mesajınızı buraya yazın.." rows="5" id="mesaj" required></textarea>
                    </div>
                    <br />
                    <!-- Gönder Butonu -->
                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" onclick="IletisimGonder()">
                        <i class="fas fa-paper-plane me-2"></i>GÖNDER
                    </button>

                </div>
            </div>

            <div class="mt-3">
                @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)
            </div>
        </div>
    </div>
</div>

<div style="height:50px"></div>




<script>

    var iletisim = $("#iletisimicin").val();

    var konuMenuId = 0;
    var konuText = "";
    document.getElementById("konuMenu").addEventListener("change", function () {
        konuMenuId = this.value;
        konuText = this.options[this.selectedIndex].text;

    });

    function IletisimGonder() {

        var ad = $("#ad").val();
        var email = $("#email").val();
        var konuMenuId = $("#konuMenu").val();
        var mesaj = $("#mesaj").val();

        if (konuMenuId == 0) {
            $("#uyari-" + iletisim).css("display", "block");
            $("#bilgi-" + iletisim).css("display", "none");
            $("#basarili-" + iletisim).css("display", "none");
            $("#uyari-" + iletisim + " #mesaj").html("Sponsor bilgisi seçilmelidir. ");
            return;
        }
        if (email == "" && ad == "" && mesaj == "") {
            $("#uyari-" + iletisim).css("display", "block");
            $("#bilgi-" + iletisim).css("display", "none");
            $("#basarili-" + iletisim).css("display", "none");
            $("#uyari-" + iletisim + " #mesaj").html("Ad, Mail ve Mesaj bilgilerinizi boş bırakmayınız.. ");
            return;
        }

        $.post("@Url.Action(nameof(TaleplerController.TalepKaydet), "Talepler")",
            {
                "EMAIL": email,
                "ADISOYADI": ad,
                "KONU_ID": konuMenuId,
                "KONU": konuText,
                "MESAJ": mesaj
            },

            function (data) {
                if (data.state == 1) {
                    $("#basarili-" + iletisim).css("display", "block");
                    $("#basarili-" + iletisim + " #mesaj").html(data.message);

                    $("#bilgi-" + iletisim).css("display", "none");
                    $("#uyari-" + iletisim).css("display", "none");

                    Bilgilendir(email, mesaj);

                }
                else if (data.state == 3) {
                    $("#bilgi-" + iletisim).css("display", "block");
                    $("#bilgi-" + iletisim + " #mesaj").html(data.message);

                    $("#basarili-" + iletisim).css("display", "none");
                    $("#uyari-" + iletisim).css("display", "none");
                }
                else {
                    $("#uyari-" + iletisim).css("display", "block");
                    $("#bilgi-" + iletisim).css("display", "none");
                    $("#basarili-" + iletisim).css("display", "none");
                    $("#uyari-" + iletisim + " #mesaj").html(data.message);
                }
            });

    }

    function Bilgilendir(email, mesaj) {
        $.post("@Url.Action(nameof(EmailController.MailBilgilendirme), "Email")",
            {
                "kime": "@ViewBag.MAIL",
                "konu": "Herkes Yazar Olsun İletişim Formu",
                "mesaj": email + " mail adresinden ilgili mesaj -> " + mesaj
            }
        )
        .done(function (data) {
            if (data.state === 1) {
                $("#basarili-" + iletisim).css("display", "block");
                    $("#basarili-" + iletisim + " #mesaj").html("Mail bilgilendirmesi yapıldı");

                    $("#bilgi-" + iletisim).css("display", "none");
                    $("#uyari-" + iletisim).css("display", "none");
            }

            else {
               $("#uyari-" + iletisim).css("display", "block");
                $("#bilgi-" + iletisim).css("display", "none");
                $("#basarili-" + iletisim).css("display", "none");
                $("#uyari-" + iletisim + " #mesaj").html("Mail bilgilendirmesi yapılamadı. ");
            }
        })
        .fail(function () {
            $("#uyari-" + iletisim).css("display", "block");
            $("#bilgi-" + iletisim).css("display", "none");
            $("#basarili-" + iletisim).css("display", "none");
            $("#uyari-" + iletisim + " #mesaj").html("Mail bilgilendirmesi yapılamadı. ");
        });


    }

</script>


