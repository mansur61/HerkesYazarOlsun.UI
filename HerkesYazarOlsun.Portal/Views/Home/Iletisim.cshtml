@using HerkesYazarOlsun.Portal.Controllers
@{
    ViewData["Title"] = " ";
    Layout = "~/Views/Shared/_Layout2.cshtml"; // header , slider kısmı yok 
}

@section Styles {

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 (İkonlar için) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        .styled-title {
            font-weight: bold;
            font-size: 5.5rem;
            color: #007bff; /* Mavi tonunda */
            text-transform: uppercase;
            letter-spacing: 2px;
            text-shadow: 2px 2px 5px rgba(0, 123, 255, 0.3);
            background: linear-gradient(45deg, #007bff, #00d4ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .subtitle {
            font-size: 2rem;
            color: #555;
            font-style: italic;
        }
    </style>
}

<input type="hidden" id="iletisimicin" value="iletisim" />

@{
    string alertmesajgostermedurumu = "iletisim";
}

<div class="text-center mb-4">
    <h1 class="styled-title">📢 İletişim Formu 📢</h1>
    <p class="subtitle">Bizimle iletişime geçmek için aşağıdaki formu doldurun.</p>
</div>

<div class="container mt-4">
    <div class="card">
        <div class="card-body p-4">
            

            <div class="mb-3 input-group">
                <span class="input-group-text"><i class="fas fa-user text-info"></i></span>
                <input type="text" class="form-control" placeholder="Ad Soyad" required id="ad">
            </div>

            <div class="mb-3 input-group">
                <span class="input-group-text"><i class="fas fa-envelope text-info"></i></span>
                <input type="email" class="form-control" id="email" placeholder="E-Posta" required>
            </div>

            <div class="mb-3 input-group">
                <span class="input-group-text"><i class="fas fa-list text-info"></i></span>
                <select class="form-select" id="konuMenu" required>
                    <option value="" selected disabled>Konu Seçiniz</option>
                    <option value="1">Kitap Yayınlama</option>
                    <option value="2">Öneri Sunma</option>
                    <option value="3">Şikayet</option>
                    <option value="4">Ödeme İle Alakalı</option>
                    <option value="5">Sponsor Seçimi</option>
                </select>
            </div>


            <div class="mb-3 input-group">
                <span class="input-group-text"><i class="fas fa-comment text-info"></i></span>
                <textarea class="form-control" placeholder="Lütfen mesajınızı buraya yazın.." rows="5" id="mesaj" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100" onclick="IletisimGonder()">GÖNDER</button>
        </div>
    </div>
    @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)
</div>

 

@section Scripts {
    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
}

<script>

    var iletisim = $("#iletisimicin").val();

    var konuMenuId = 0;
    var konuText = "";
    document.getElementById("konuMenu").addEventListener("change", function () {
        konuMenuId = this.value;
        konuText = this.options[this.selectedIndex].text;

    });

    function IletisimGonder() {

        var ad = $("#ad").val();
        var email = $("#email").val();
        var konuMenuId = $("#konuMenu").val();
        var mesaj = $("#mesaj").val();

       // console.log(" ad: " + ad + " email: " + email + " konuText: " + konuText + " konuMenuId: " + konuMenuId + " mesaj: " + mesaj);

        if (konuMenuId == 0) {
            $("#uyari-" + iletisim).css("display", "block");
            $("#bilgi-" + iletisim).css("display", "none");
            $("#basarili-" + iletisim).css("display", "none");
            $("#uyari-" + iletisim + " #mesaj").html("Sponsor bilgisi seçilmelidir. ");
            return;
        }
        if (email == "" && ad == "" && mesaj == "") {
            $("#uyari-" + iletisim).css("display", "block");
            $("#bilgi-" + iletisim).css("display", "none");
            $("#basarili-" + iletisim).css("display", "none");
            $("#uyari-" + iletisim + " #mesaj").html("Ad, Mail ve Mesaj bilgilerinizi boş bırakmayınız.. ");
            return;
        }

        $.post("@Url.Action(nameof(TaleplerController.TalepKaydet), "Talepler")",
            {
                "EMAIL": email,
                "ADISOYADI": ad,
                "KONU_ID": konuMenuId,
                "KONU": konuText,
                "MESAJ": mesaj
            },

            function (data) { 
                if (data.state == 1) {
                    $("#basarili-" + iletisim).css("display", "block");
                    $("#basarili-" + iletisim + " #mesaj").html(data.message);

                    $("#bilgi-" + iletisim).css("display", "none");
                    $("#uyari-" + iletisim).css("display", "none");

                    Bilgilendir(email, mesaj);

                }
                else if (data.state == 3) {
                    $("#bilgi-" + iletisim).css("display", "block");
                    $("#bilgi-" + iletisim + " #mesaj").html(data.message);

                    $("#basarili-" + iletisim).css("display", "none");
                    $("#uyari-" + iletisim).css("display", "none");
                }
                else {
                    $("#uyari-" + iletisim).css("display", "block");
                    $("#bilgi-" + iletisim).css("display", "none");
                    $("#basarili-" + iletisim).css("display", "none");
                    $("#uyari-" + iletisim + " #mesaj").html(data.message);
                }
            });

    }



    function Bilgilendir(email, mesaj) { 
        $.post("@Url.Action(nameof(EmailController.MailBilgilendirme), "Email")",
            {
                "kime": "kayamansur61@gmail.com",
                "konu": "Herkes Yazar Olsun İletişim Formu",
                "mesaj": email + " mail adresinden ilgili mesaj -> " + mesaj
            },

            function (data) { 
                // setTimeout(function () {

                //     window.location.href = "/Home/Index";
                // }, 3000);

 
            });
    }



</script>


