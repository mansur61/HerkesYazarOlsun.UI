@{
    ViewData["Title"] = " ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 
@section Styles {
    <style>
        .about-section {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: auto;
            padding-bottom: 60px;
        }

        .content-box {
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            padding: 50px 30px;
        }

        .content-box h2 {
            color: #00C9A7;
            font-weight: 700;
            margin-bottom: 20px;
            font-size: 2.5rem;
        }

        .content-box .description {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #555;
            margin-bottom: 50px;
            font-family: 'Roboto', sans-serif;
        }

        .info-box {
            background: #f9fdf9;
            padding: 30px;
            margin-bottom: 30px;
            border-radius: 10px;
            border-left: 5px solid #00C9A7;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .info-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.15);
        }

        .info-box h3 {
            color: #00C9A7;
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 1.5rem;
        }

        .info-box p {
            color: #666;
            line-height: 1.8;
            margin-bottom: 0;
            font-family: 'Roboto', sans-serif;
        }

        .info-box ul {
            list-style-position: inside;
            margin-bottom: 0;
        }

        .info-box ul li {
            color: #666;
            margin-bottom: 10px;
            line-height: 1.8;
            font-family: 'Roboto', sans-serif;
        }

        .cta-box {
            background: linear-gradient(135deg, #f9fdf9 0%, #e8fff7 100%);
            padding: 50px;
            border-radius: 12px;
            margin-top: 50px;
            border: 2px solid #00C9A7;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,199,167,0.15);
        }

        .cta-text {
            font-size: 1.3rem;
            color: #333;
            font-weight: 600;
            margin-bottom: 25px;
            font-family: 'Poppins', sans-serif;
        }

        .cta-box .btn {
            background-color: #00C9A7;
            color: white;
            font-weight: 600;
            padding: 15px 40px;
            font-size: 1.1rem;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-family: 'Poppins', sans-serif;
        }

        .cta-box .btn:hover {
            background-color: #00b39e;
            transform: scale(1.05);
            box-shadow: 0 5px 15px rgba(0,199,167,0.4);
            color: white;
            text-decoration: none;
        }

        .title {
            font-family: 'Poppins', sans-serif;
        }

        @media (max-width: 768px) {
            .content-box {
                padding: 30px 20px;
            }

            .content-box h2 {
                font-size: 1.8rem;
            }

            .cta-box {
                padding: 30px 20px;
            }

            .cta-text {
                font-size: 1.1rem;
            }
        }
    </style>
}

<div class="about-section">
    <div class="container">
        <div class="content-box text-dark py-5">
            <h2 class="title text-center">📖 Hakkımızda</h2>
            <p class="description text-center">
                <strong>Herkes Yazar Olsun</strong>, yazmayı seven herkesin kendi hikayelerini, romanlarını, şiirlerini veya denemelerini özgürce yazabileceği, geliştirebileceği ve yayımlayabileceği bir platformdur.
            </p>
            <div class="info-box">
                <h3>✨ Neden "Herkes Yazar Olsun"?</h3>
                <p>
                    Günümüzde birçok kişi yazmaya ilgi duysa da, kitaplarını basılı hale getirmek ve geniş kitlelere ulaştırmak oldukça zahmetli olabilir.
                    <strong>Herkes Yazar Olsun</strong>, yazarlara destek olmayı amaçlayan yenilikçi bir sistem sunuyor.
                </p>
            </div>
            <div class="info-box">
                <h3>📚 Nasıl Çalışır?</h3>
                <ul>
                    <li>Kullanıcılar kendi kitaplarını yazabilir, düzenleyebilir ve geliştirebilirler.</li>
                    <li>Kitaplarını tamamlayan yazarlar, sponsorlu yayınevleri aracılığıyla eserlerini yayınlama fırsatı bulurlar.</li>
                    <li>Özel anlaşmalar sayesinde yazarlar, yayın sürecinde indirimlerden yararlanabilirler.</li>
                </ul>
            </div>
            <div class="info-box">
                <h3>🚀 Amacımız ve Vizyonumuz</h3>
                <p>
                    Biz, herkesin bir hikayesi olduğuna inanıyoruz ve bu hikayelerin okuyucularla buluşması gerektiğini düşünüyoruz.
                    <strong>Herkes Yazar Olsun</strong>, yazarlık hayalini kuranlar için bir rehber olmayı amaçlıyor.
                </p>
            </div>
            
            <!-- Yeni CTA Bölümü -->
            <div class="cta-box">
                <p class="cta-text">🖋️ Hikayeni Dünyayla Paylaş</p>
                <p style="color: #666; margin-bottom: 25px; font-family: 'Roboto', sans-serif;">
                    Senin de bir hikayesin var! Hayal gücünü özgür bırak ve eserinizin yaratıcısı ol. 
                    Şimdi başla ve binlerce okuyucu ile bağlantı kur.
                </p>
                <a href="/Home/Index" class="btn btn-dark">Şimdi Başla 📖</a>
            </div>
        </div>
    </div>
</div>
