@{
    ViewData["Title"] = "Kitap Arama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* @section scripts{
    <script src= "~/lib/bootstrap/dist/js/jquery-1.10.2.js"></script>
} *@
@section Styles{
    <link href="~/lib/bootstrap/dist/css/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/kitap_arama_style.css" rel="stylesheet" />
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;
@using HerkesYazarOlsun.Portal.Controllers;

@{
    Model.kitapSliderYometimAdi = "arama";
     
}
@Html.Partial("_KitapSliderItemYonetimleri",@Model)

<section class="product spad">
<div class="container" >
        <div class="row">
            <div class="col-lg-4 col-md-5">
                <div class="sidebar">
                    <div class="sidebar__item">

                        <h3>Arama Yapınız</h3>
                        <div style="height:15px"></div>
                        <ul>
                            <li>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" value="1" id="tarihCeck">
                                    <label class="form-check-label" for="flexCheckDefault">
                                        @DateTime.Now.Year.ToString() te yazılan kitaplar
                                    </label>
                                </div>
                            </li>
                            <li>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" value="0" id="tarihCeck">
                                    <label class="form-check-label" for="flexCheckDefault2">
                                        @DateTime.Now.Year.ToString() ten önce yazılan kitaplar
                                    </label>
                                </div>
                            </li>
                          
                        </ul>

                    </div>


                    <div class="sidebar__item">
                        <h5>Kategori Seçiniz</h5>
                        <div style="height:15px"></div>
                        <div class="price-range-wrap">
                            <select class="wide" id="kategori">
                                <option value="" selected> Seçiniz...</option>
                                <option value="1">Hikaye</option>
                                <option value="2">Roman</option>
                                <option value="3">Şiir</option>
                                <option value="4"></option>
                            </select>
                        </div>
                        <br />
                    </div>
                    <br />
                    <div class="sidebar__item">
                        <h5>Yazar Giriniz</h5>
                        <div style="height:15px"></div>
                        <div class="input-group mb-4">
                            <input type="text" class="form-control" placeholder="Yazar..." id="yazarAdi" name="yazarAdi">
                            veya
                            <br />
                            <input type="text" class="form-control" name="kitap_ara" id="kitap_ara" placeholder="Kitap..." />

                        </div>

                    </div>

                    <!--slider sidebar-->
                    @Html.Partial("_SideBarItem",@Model)

                    <div class="row">
                        <button type="button" class="btn btn-info" style="width:100%" onclick="Filtrele()">Arama Yap</button>
                    </div>
                </div>


            </div>
            <div class="col-lg-8" >

                @*@Html.Partial("_Filtreleme",@Model)*@

                <div class="filter__item">
                    <div class="row">
                        <div class="col-lg-4 col-md-5">
                            <div style="height:15px"></div>
                            <div class="filter__sort">
                                <span>Sıralama</span>
                                <select class="small" id="siralama" name="siralama">
                                    <option value="0">Azalan</option>
                                    <option value="1">Artan</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-4">
                            <div style="height:15px"></div>
                            <div class="filter__found">
                                <h6><span>@Model.VMBooksList.Count() </span> Ürün Bulunmaktadır.</h6>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-3">
                             Listelenecek Kayıt Sayısı
                            <select class="wide" name="kayit_sayisi" id="kayit_sayisi">
                                <option value="0" selected> Seçiniz...</option>
                                <option value="10"> İlk 10 Kayıt</option>
                                <option value="20">İlk 20 Kayıt</option>
                                <option value="30">İlk 30 Kayıt</option>
                                <option value="40">İlk 40 Kayıt</option>
                                <option value="50">İlk 50 Kayıt</option>

                            </select>
                        </div>
                    </div>
                </div>

                @*<div class="alert alert-success" id="basarili" style="display:none;">
                    <strong>Başarılı!</strong> Favorilere Eklendi
                    <button type="button" class="btn btn-info" onclick='Kapat()'>Kapat</button>
                </div>
                <br />
                <div class="alert alert-info" id="uyari" style="display:none;">
                    <strong>Bilgi!</strong> Favorilere Eklenemedi
                    <button type="button" class="btn btn-info" onclick='Kapat()'>Kapat</button>
                </div>
                <br />*@

                @Html.Partial("_AlertMesaj",@Model.Tip)

                <div class="row" id="tumaramaalar">
                    @Html.Partial("Kitaplar",@Model)
                    @Html.Partial("_PaginationButonlar",@Model.vM_PAGINATION_BUTTONS)
                </div>
                <div class="row" id="arabutonfiltre"></div>
            </div>
        </div>
        
    </div>
</section>




<script>
    $("#arabutonfiltre").css("display", "none");
    
    function Filtrele() {
       

        var listelenecek_kayit_sayisi = $("#kayit_sayisi").val();

        if (listelenecek_kayit_sayisi == 0) {
            alert("Litelenecek Kayıt Sayısı Seç");
            return;
        }

        if (listelenecek_kayit_sayisi == null) {
            listelenecek_kayit_sayisi = 10;
        }

        var kitap_ara = $("#kitap_ara").val();
        var siralama = $("#siralama").val();
        var yazarAdi = $("#yazarAdi").val();
        var kategoriId = $("#kategori").val();
        var tarihCeck = $("#tarihCeck").val();
        
        $.get("@Url.Action(nameof(AramaController.OrtakTumAramalar), "Arama")", {
            "listelenecek_kayit_sayisi": listelenecek_kayit_sayisi,
            "KITAP_ADI": kitap_ara,
            "YAZAR_ADI": yazarAdi,
            "siralama": siralama,
            "kategoriId": kategoriId,
            "tarihCeck": tarihCeck
        }, function (data) {
           
            if (data) {
                $("#verisayisi").val(3);
                $("#arabutonfiltre").html(data);
                $("#arabutonfiltre").css("display", "block");
                $("#tumaramaalar").css("display", "none");
                $("#tumaramaalarButonlar").css("display", "none");

            } else {
                $("#tumaramaalarButonlar").css("display", "block");
                $("#tumaramaalar").css("display", "block");
                $("#arabutonfiltre").css("display", "block");
            }

        });

    }

    //function Kapat() {
    //    $("#basarili").css("display", "none");
    //    $("#uyari").css("display", "none");
    //}

</script>

<script src= "~/lib/bootstrap/dist/js/jquery-3.3.1.min.js"></script>
<script src= "~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
<script src= "~/lib/bootstrap/dist/js/jquery.nice-select.min.js"></script>
<script src= "~/lib/bootstrap/dist/js/jquery-ui.min.js"></script>
<script src= "~/lib/bootstrap/dist/js/jquery.slicknav.js"></script>
<script src= "~/lib/bootstrap/dist/js/mixitup.min.js"></script>
<script src= "~/lib/bootstrap/dist/js/owl.carousel.min.js"></script>
<script src= "~/lib/bootstrap/dist/js/kitap-arama.js"></script>




