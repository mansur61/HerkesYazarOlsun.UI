
@model HerkesYazarOlsun.Model.ViewModel.VM_ARAMA_SONUC;

@using HerkesYazarOlsun.Model.ViewModel;
 

 @{ 

    int perSlide = Model.sliderdaGosterilecekKayit == 0 ?  
                    ViewBag.SliderdaGosterilecekKayit : 
                    Model.sliderdaGosterilecekKayit;
 

    int total = Model.vmBookList.Count;
    int sliderSayisi = (int)Math.Ceiling((double)total / perSlide);
    var butons = new  VM_PAGINATION_BUTTON{
            sliderSayisi = sliderSayisi,
            sliderSayiDivTagName = "arabutonfiltre"
    };
    Model.vM_PAGINATION_BUTTONS = butons; 
}
 
@if (@Model.vmBookList.Count() > 0)
{  

        var tumAramalarModel = new VM_BOOKS_DETAIL
        {
            VMBooksList = Model.vmBookList.ToList(),  
            sliderdaGosterilecekKayit = perSlide,
            vM_PAGINATION_BUTTONS = butons,
            Tip = "arabutonfiltre",
            isAnaSayfa = false,
        };

      @Html.Partial("Kitaplar", @tumAramalarModel)
 
 
    @Html.Partial("_PaginationButonlar",@Model.vM_PAGINATION_BUTTONS)

}else{
    <p>Aranan kritere uygun herhangi bir kayıt bulunamadı</p>
}



