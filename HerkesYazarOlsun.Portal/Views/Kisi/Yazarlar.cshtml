

@model HerkesYazarOlsun.Model.ViewModel.VM_USERS;
@using HerkesYazarOlsun.Portal.Controllers;

<div class="container" style="border:1px solid red;margin: 50px auto;width:auto">
    <div class="row">

        <div class="col-lg-12">

            @{
                int gosterilecekKayit = Model.sliderdaGosterilecekKayit;
            }
            @for (int i = 0; i < @Model.vM_PAGINATION_BUTTONS.sliderSayisi; i++)
            {
                <div class="durum_@Model.vM_PAGINATION_BUTTONS.sliderSayiDivTagName">


                    @foreach (var item in @Model.UsersList.Take(range: new Range(Model.Start, @gosterilecekKayit)))
                    {

                        <div class="col-lg-4 col-md-6 col-sm-6" style="border: 1px dotted blue;height:auto;width:200px;margin:5px 5px;padding:5px">
                            <div class="product__item">
                                <div class="product__item__pic set-bg" data-setbg="http://placehold.it/350x260">
                                    <ul class="product__item__pic__hover">
                                        <li><a href="#" onclick='YazariFavorilereEkle(@item.ID,@item.TCKNO)'><i class="fa fa-heart"></i></a></li>
                                        <li><a href="#" onclick='YazarGit(@Model.YAZAR_ID)'><i class="fa fa-user"></i></a></li>

                                    </ul>
                                </div>
                                <div class="product__item__text">
                                    <h6><a href="/Kitaplar/KitapDetay?kitapId=@item.ID">@item.NAME </a></h6>
                                    <div class="row">
                                        <div class="rating hidden-sm col-sm-7">
                                            <i class="price-text-color fa fa-star"></i>
                                            <i class="price-text-color fa fa-star"> </i>
                                            <i class="price-text-color fa fa-star"></i>
                                            <i class="price-text-color fa fa-star"> </i>
                                            <i class="price-text-color fa fa-star"> </i>

                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    }
                    @{
                        Model.Start = Model.sliderdaGosterilecekKayit;
                        gosterilecekKayit = 2 * Model.sliderdaGosterilecekKayit;
                        Model.sliderdaGosterilecekKayit = gosterilecekKayit;
                    }
                </div>

            }


            
           
        </div>

    </div>

</div>


<script>

    function YazarGit(yazarId) {

    }
    function YazariFavorilereEkle(yazarId, tck) {

        $.post("@Url.Action(nameof(KisiController.YazariFavorilereEkle), "Kisi")", { "id": yazarId, "tck": tck }, function (data) {
            if (data) {
                $("#basarili").css("display", "block");
            } else {
                $("#uyari").css("display", "block");
            }


        });
    }

    function Kapat() {
        $("#basarili").css("display", "none");
        $("#uyari").css("display", "none");
    }

</script>