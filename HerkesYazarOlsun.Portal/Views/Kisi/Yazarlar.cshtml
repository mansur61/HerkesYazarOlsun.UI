

@model HerkesYazarOlsun.Model.ViewModel.VM_USERS;
@using HerkesYazarOlsun.Portal.Controllers;

@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}
<div class="container" style="margin: 50px auto;width:auto">
    <div class="row">

        <div class="col-lg-12">

            @{
                int gosterilecekKayit = Model.sliderdaGosterilecekKayit;
            }
            @for (int i = 0; i < @Model.vM_PAGINATION_BUTTONS.sliderSayisi; i++)
            {
                <div class="durum_@Model.vM_PAGINATION_BUTTONS.sliderSayiDivTagName">


                    @foreach (var item in @Model.VMUsersList.Take(range: new Range(Model.Start, @gosterilecekKayit)))
                    {

                        <div class="col-lg-4 col-md-6 col-sm-6" style="border: 1px dotted blue;height:auto;width:200px;margin:5px 5px;padding:5px">
                            <div class="product__item" style="overflow:hidden;height:340px">
                                <div class="product__item__pic set-bg"
                                     data-setbg="https://herkesyazarolsun.com.tr/Belgeler/@item.Profile?.ProfilResimURl">
                   
                                    <ul class="product__item__pic__hover">
                                        @if (isGozlemciMod == "0")
                                        {
                                            <li><a onclick='YazariFavorilereEkle(@item.ID,@item.ID,"@Model.Tip")'><i class="fa fa-heart"></i></a></li>

                                        }
                                        <li><a href="/Kisi/Profil?id=@item.ID" ><i class="fa fa-user"></i></a></li>

                                    </ul>
                                </div>
                                <div class="product__item__text">
                                    <h6><a href="/Kitaplar/KitapDetay?kitapId=@item.ID">@item.NAME </a></h6>
                                    <div class="row">
                                        <div class="rating hidden-sm col-sm-7">

                                            @for (int m = 0; m < @item.Stars.EnFazlaSitar; m++)
                                            {
                                                <i class="price-text-color fa fa-star"></i>
                                            }


                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    }
                    @{
                        Model.Start = Model.sliderdaGosterilecekKayit;
                        gosterilecekKayit = Model.End +  Model.sliderdaGosterilecekKayit;
                        Model.sliderdaGosterilecekKayit = gosterilecekKayit;
                    }
                </div>

            }


            
           
        </div>

    </div>

</div>


<script>

  
    function YazariFavorilereEkle(yazarId, tck,tip) {

        $.post("@Url.Action(nameof(KisiController.YazariFavorilereEkle), "Kisi")", { "id": yazarId, "tck": tck }, function (data) {
            if (data) {
                $("#basarili-" + tip).css("display", "block");
            } else {
                $("#uyari-" + tip).css("display", "block");
            }


        });
    }

</script>