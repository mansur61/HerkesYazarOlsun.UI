

@model HerkesYazarOlsun.Model.ViewModel.VM_USERS_DETAIL;
@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Portal.Controllers;

@using HerkesYazarOlsun.Portal.Helpers.Extensions;

@using HerkesYazarOlsun.Model.ViewModel;

 
 @{
           int perSlide = Model.sliderdaGosterilecekKayit != 0
            ? Model.sliderdaGosterilecekKayit
            : Convert.ToInt32(ViewBag.SliderdaGosterilecekKayit);
 }
     
   @for (int i = 0; i < Model.vM_PAGINATION_BUTTONS.sliderSayisi; i++)
    {
        var slideModel = new VM_USERS_DETAIL
        {
            VMUsersList = Model.VMUsersList
                .Skip(i * perSlide)
                .Take(perSlide)
                .ToList(),
            Tip = Model.Tip, 
        }; 

        <div class="durum_@Model.vM_PAGINATION_BUTTONS.sliderSayiDivTagName"
            data-index="@i"
            style="display:@(i == 0 ? "block" : "none");">

            <div class="row g-3">
                @foreach (var user in slideModel.VMUsersList)
                {                  
                    @*@Html.Partial("_YazarlarItem", user)*@
                    @Html.Partial("_YazarlarItem", 
                    new HerkesYazarOlsun.Model.ViewModel.VM_YazarItem {
                        Users = user,
                        Tip = slideModel.Tip 
                    })
                
                }
            </div>

        </div>
    }