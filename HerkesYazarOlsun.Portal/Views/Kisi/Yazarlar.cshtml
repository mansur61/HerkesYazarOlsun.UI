

@model HerkesYazarOlsun.Model.ViewModel.VM_USERS_DETAIL;
@using HerkesYazarOlsun.Portal.Controllers;

@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}
<div class="container" style="margin-top:50px;">
    <div class="row">
        @foreach (var item in Model.VMUsersList.Skip(Model.Start).Take(Model.sliderdaGosterilecekKayit))
        {
            <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 mb-3">
                <div class="product__item h-100 border border-primary rounded p-2">
                    <div class="product__item__pic set-bg position-relative"
                         style="background-image: url('https://herkesyazarolsun.com.tr/Belgeler/@item.Profile?.ProfilResimURl'); background-size:cover; background-position:center; height:250px;">
                        <ul class="product__item__pic__hover list-unstyled d-flex justify-content-end m-2 position-absolute w-100 top-0">
                            @if (isGozlemciMod == "0")
                            {
                                <li class="me-2"><a onclick='YazariFavorilereEkle(@item.ID,@item.ID,"@Model.Tip")'><i class="fa fa-heart text-danger"></i></a></li>
                            }
                            <li><a href="/Kisi/Profil?id=@item.ID"><i class="fa fa-user text-dark"></i></a></li>
                        </ul>
                    </div>
                    <div class="product__item__text mt-2">
                        <h6><a href="/Kitaplar/KitapDetay?kitapId=@item.ID">@item.USERNAME</a></h6>
                        <div class="row">
                            <div class="rating col-7">
                                @for (int m = 0; m < item.Stars?.EnFazlaSitar; m++)
                                {
                                    <i class="fa fa-star text-warning"></i>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

 
@* @Html.Partial("_AlertMesaj", @Model.Tip)   *@

<script> 
  
    function YazariFavorilereEkle(yazarId, tck,tip) {
          
        $.post("@Url.Action(nameof(KisiController.YazariFavorilereEkle), "Kisi")", { "id": yazarId, "tck": tck }, function (data) {
            if (data) {
                console.log("data ",data); 
                UyariVer(data.state, "#basarili-"+ tip, "#bilgi-"+ tip, "#uyari-"+ tip, data.message);
               
            } else { 
               UyariVer(data.state, "#basarili-"+ tip, "#bilgi-"+ tip, "#uyari-"+ tip, data.message);
            }


        });
    }

</script>