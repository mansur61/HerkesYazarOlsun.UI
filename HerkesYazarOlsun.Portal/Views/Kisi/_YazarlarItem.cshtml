

@model HerkesYazarOlsun.Model.ViewModel.VM_USERS;
@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Portal.Controllers;

@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}
    
    
<link href="~/lib/css/yazarlar_item.css" rel="stylesheet" />

 
 @{
    var item = @Model;
 } 
            <div class="col-6 col-sm-6 col-md-4 col-lg-3 mt-15">
                <div class="profile-card">

                    <!-- Resim alanı -->
                    <img src="@(!string.IsNullOrEmpty(item?.Profile?.ProfilResimURl)
                    ? $"https://herkesyazarolsun.com.tr/Belgeler/{item.Profile.ProfilResimURl}"
                    : Url.Content( "~/lib/img/user.png"))"
                     alt="@item.USERNAME" />

                    <!-- Bilgi alanı -->
                    <div class="profile-info">
                        <!-- Hover ikonları ismin üstüne -->
                        <ul class="hover-icons">
                        @if (isGozlemciMod == "0")
                            {
                                <li>
                                    <a id="favBtn_@item.ID" onclick='YazariFavorilereEkle(@item.ID,@item.ID,"@ViewBag.Tip")'>
                                        <i class="fa fa-heart text-danger"></i>
                                    </a>
                                </li>
                            }
                            <li>
                                <a href="/Kisi/Profil?pId=@StringCipher.Encrypt(@item.ID.ToString())">
                                    <i class="fa fa-user text-dark"></i>
                                </a>
                            </li>
                        </ul>

                        <h2>
                            <span style="text-decoration:none; color:#333;">@item.USERNAME</span>
                        </h2>

                        <div class="follow-stats">
                            <div class="stat"> 
                                @if (item.Stars != null)
                                {
                                    item.Stars.isToplam = false;
                                    <div class="mb-3 mt-1 text-center">
                                        @Html.Partial("_YildizGoster", @item.Stars)
                                    </div>
                                }

                            </div>
                        </div>
                    </div>

                </div>
            </div>
      
 

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>


<script>

    function YazariFavorilereEkle(yazarId, tck, tip) {

        const btn = document.getElementById("favBtn_" + yazarId);
        const originalIcon = btn.innerHTML; // eski hali sakla

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Favorilere eklemek istiyor musunuz?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Evet',
            cancelButtonText: 'Hayır',
            customClass: {
                confirmButton: 'btn btn-primary',
                cancelButton: 'btn btn-danger'
            }
        }).then((result) => {

            if (result.isConfirmed) {

                // Kullanıcı evet dedi → spinner başlasın
                btn.innerHTML = '<i class="fa fa-spinner fa-spin text-primary"></i>';

                $.post("@Url.Action(nameof(KisiController.YazariFavorilereEkle), "Kisi")",
                    { id: yazarId, tck: tck },
                    function (data) {

                        // AJAX tamamlandıktan sonra ikonu geri döndür
                        btn.innerHTML = originalIcon;

                        if (data) {
                            UyariVer(
                                data.state,
                                "#basarili-" + tip,
                                "#bilgi-" + tip,
                                "#uyari-" + tip,
                                data.message
                            );
                        }
                        else {
                            UyariVer(
                                "warning",
                                "#basarili-" + tip,
                                "#bilgi-" + tip,
                                "#uyari-" + tip,
                                "Beklenmeyen bir hata oluştu"
                            );
                        }
                    }
                )
                .fail(function() {
                    btn.innerHTML = originalIcon;
                    UyariVer("error", "#basarili-" + tip, "#bilgi-" + tip, "#uyari-" + tip, "Sunucu hatası.");
                });

            } else if (result.dismiss === Swal.DismissReason.cancel) {

                Swal.fire(
                    'İşlem İptal',
                    'Favori ekleme işlemi iptal edildi.',
                    'info'
                );
            }

        });

    }
</script>