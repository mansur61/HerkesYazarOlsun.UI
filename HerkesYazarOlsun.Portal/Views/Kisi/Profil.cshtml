@{
    ViewData["Title"] = "Profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@section Styles {

    <link href="~/lib/bootstrap/dist/css/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/kitap_arama_style.css" rel="stylesheet" />
    @*<link href="~/lib/bootstrap/dist/css/style_kitap_detay.css" rel="stylesheet" />*@
}

@section scripts{
    <script src="~/lib/bootstrap/dist/js/jquery-1.10.2.js"></script>
}

@using HerkesYazarOlsun.Portal.Controllers;
@model HerkesYazarOlsun.Model.ViewModel.VM_USERS;


<div class="row">
    <div style="width:auto;height:auto;background-color:aliceblue;margin:15px;">


        <section class="h-100 gradient-custom-2">
            <div class="container py-5 h-100">
                <div class="row d-flex justify-content-center align-items-center h-100">
                    <div class="col col-md-3" style="padding:5px">
                        <div class="card">
                            <div class="rounded-top text-white d-flex flex-row">
                                <div class="ms-4 mt-5 d-flex flex-column" style="width: 150px;">
                                    <img src="https://mdbcdn.b-cdn.net/img/Photos/new-templates/bootstrap-profiles/avatar-1.webp"
                                         alt="Generic placeholder image" class="img-fluid img-thumbnail mt-4 mb-2"
                                         style="width: 150px; z-index: 1">
                                    @*<button type="button" class="btn btn-outline-dark"
                                    style="z-index: 1;">
                                    Edit profile
                                    </button>*@
                                    <div class="mb-3">
                                        <label for="formFile" class="form-label">Profili Değiştir.</label>
                                        <input class="form-control" type="file" id="formFile">
                                    </div>
                                </div>
                                <div  style="margin-top: 10px;color:black;font-size:30px">
                                    @Model.NAME @Model.SURNAME
                                </div>
                              
                            </div>

                        </div>
                        <br />
                        <div class="row" >
                            <div class="rating hidden-sm col-sm-7">
                                <i class="price-text-color fa fa-star"></i>
                                <i class="price-text-color fa fa-star"> </i>
                                <i class="price-text-color fa fa-star"></i>
                                <i class="price-text-color fa fa-star"> </i>
                                <i class="price-text-color fa fa-star"> </i>

                            </div>
                           
                        </div>

                    </div>

                    <div class="col-md-2" style="margin-top:80px;text-align:center">
                        <p style="font-size:30px"><strong>Takipler</strong></p>
                        <p style="font-size:25px">120</p>
                    </div>
                    <div class="col-md-2" style="margin-top:80px;text-align:center">
                        <p style="font-size:30px">
                            <strong>Takipçiler</strong>
                        </p>
                        <p style="font-size:25px">61</p>
                    </div>

                    <div class="col-md-1" style="text-align:center;margin-top:80px;">
                        <button type="button" class="btn btn-info" onclick="YazarTakip()">
                            Takip Et
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<div id="takipdurum">
    <div class="alert alert-success" id="basarili" style="display:block;">
        <strong>Başarılı!</strong> Yazar Takip Edildi
        <button type="button" class="btn btn-info" onclick='Kapat()'>Kapat</button>
    </div>
    <br />
    <div class="alert alert-info" id="uyari" style="display:block;">
        <strong>Bilgi!</strong> Yazar Takip Edilmedi
        <button type="button" class="btn btn-info" onclick='Kapat()'>Kapat</button>
    </div>
    <br />
</div>
<input type="hidden" id="yazar_id" value="@Model.ID" />


<div style="height:50px;visibility: hidden;"></div>

<section class="product_description_area">
    <div class="container">


        <ul class="nav nav-tabs" id="myTab" role="tablist">

            <li class="nav-item ">
                <a class="nav-link  active" id="hakkinda-tab" data-toggle="tab" href="#hakkinda" role="tab" aria-controls="hakkinda" onclick="Hakkinda()"
                   aria-selected="false">Hakkında</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="devamedenkitaplar-tab" data-toggle="tab" href="#devamedenkitaplar" role="tab" aria-controls="devamedenkitaplar"
                   onclick="DevamEdenKitaplar()"
                   aria-selected="false">Devam Eden Kitapları</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="tamamlanankitaplar-tab" data-toggle="tab" href="#tamamlanankitaplar" role="tab" aria-controls="tamamlanankitaplar"
                   onclick="TamamlananKitaplar()"
                   aria-selected="false">Tamamlanan Kitapları</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="yayinlanan-tab" data-toggle="tab" href="#yayinlanan" role="tab" aria-controls="yayinlanan"
                   onclick="YayinlananKitaplar()"
                   aria-selected="false">Yayınlanan Kitapları</a>
            </li>

        </ul>


        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="hakkinda" role="tabpanel" aria-labelledby="hakkinda-tab">

                <div id="bilgi">  @Model.ID.ToString() nolu yazar  @Model.NAME @Model.SURNAME </div>
            </div>
            <div class="tab-pane fade" id="devamedenkitaplar" role="tabpanel" aria-labelledby="devamedenkitaplar-tab">

                <div id="devameden">   </div>
            </div>
            <div class="tab-pane fade" id="tamamlanankitaplar" role="tabpanel" aria-labelledby="tamamlanankitaplar-tab">

                <div id="tamamlanan"> </div>
            </div>
            <div class="tab-pane fade" id="yayinlanan" role="tabpanel" aria-labelledby="yayinlanan-tab">

                <div id="yayin"> </div>
            </div>

        </div>
    </div>
</section>

<br />

<div style="height:300px;visibility: hidden;"></div>
<script>

    $("#bilgi").css("display", "none");
    $("#takipdurum").css("display", "none");

    //const nodeList = document.querySelectorAll("#gozukecekMiFooter");
    //for (let i = 0; i < nodeList.length; i++) {
    //    nodeList[i].style.display = "none";
    //}

    var yazarId = $("#yazar_id").val();

    function YazarTakip() {
        $("#takipdurum").css("display", "block");
    }

    function Hakkinda() {

        $("#bilgi").css("display", "block");
    }

    function Kapat() {
        $("#basarili").css("display", "none");
        $("#uyari").css("display", "none");

    }
    function DevamEdenKitaplar() {
        $(this).css("color", "red");
        $.post("@Url.Action(nameof(KitaplarController.AraButonFiltrelemeKitaplar), "Kitaplar")",
            {
                "yazarIId": yazarId,
                "DevamEdenKitaplar": true,
                "profilKitapTuru": "devameden"
            },

            function (data) {
                $("#devameden").html(data);
            });
    }

    function TamamlananKitaplar() {
        $.post("@Url.Action(nameof(KitaplarController.AraButonFiltrelemeKitaplar), "Kitaplar")",
            {
                "yazarIId": yazarId,
                "BitenKitaplar": true,
                "profilKitapTuru": "tamamlanan"
            },

            function (data) {
                $("#tamamlanan").html(data);
            });
    }

    function YayinlananKitaplar() {
        $.post("@Url.Action(nameof(KitaplarController.AraButonFiltrelemeKitaplar), "Kitaplar")",
            {
                "yazarIId": yazarId,
                "YayinlananKitaplar": true,
                "profilKitapTuru": "yayin"
            },

            function (data) {
                $("#yayin").html(data);
            });
    }
</script>