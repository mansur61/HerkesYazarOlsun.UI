@model HerkesYazarOlsun.Model.ViewModel.VM_USERS
@using HerkesYazarOlsun.Model.Enums
@using HerkesYazarOlsun.Portal.Helpers.Extensions
@using HerkesYazarOlsun.Portal.Controllers

@{
    ViewData["Title"] = "Profil";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string isGozlemciMod = User.GetGozlemciMod();
}

<input type="hidden" id="profilicin" value="profil" />
<input type="hidden" id="yazar_id" value="@Model.ID" />
<p id="kural" style="display:none;">@ViewBag.isBildirimTakip</p>

@section Styles {
  <link href="~/lib/css/profil.css" rel="stylesheet" />
}

<!-- 🔄 SPINNER -->
<div id="globalSpinner" class="spinner text-center"
     style="display:none; position:fixed; top:50%; left:50%; transform:translate(-50%, -50%); z-index:9999;">
    <i class="fa fa-spinner fa-spin fa-3x"></i>
</div>

<div class="container py-5">

    <!-- PROFİL KARTI -->
    <div class="profile-card">
         
             <img src="@(
    !string.IsNullOrWhiteSpace(Model?.Profile?.ProfilResimURl)
        && Model.Profile.ProfilResimURl != "-1"
        ? Url.Content($"https://herkesyazarolsun.com.tr/Belgeler/{Model.Profile.ProfilResimURl}")
        : Url.Content("~/lib/img/user.png")
)"
     class="img-fluid rounded-circle"
     width="130"
     height="130"
     style="object-fit:cover;" />



        <div class="profile-info ms-4">
            <h2>@Model.USERNAME</h2>

            <div class="d-flex gap-4 mt-2">
                <div>
                    <strong>Takipler</strong>
                    <div>@Model.WriterFollowLoginList?.Count(p => p.isFollow == (int)Takip.TakipEt)</div>
                </div>
                <div>
                    <strong>Takipçiler</strong>
                    <div>@Model.WriterFollowYazarList?.Count(p => p.isFollow == (int)Takip.TakipEt)</div>
                </div>
            </div>

            @if (ViewBag.LOGIN_USER_ID != Model.ID && isGozlemciMod == "0")
            {
                <div class="mt-3 d-flex gap-2 flex-wrap">
                    @if (!ViewBag.IsTakip)
                    {
                        <button class="btn btn-info" onclick="YazarTakip(1)">Takip Et</button>
                    }
                    else
                    {
                        <button class="btn btn-warning" onclick="YazarTakip(0)">Takip Ediliyor</button>
                    }
                    <button class="btn btn-primary" onclick="YildizVer()">Yıldız Ver</button>
                    <button class="btn btn-danger" onclick="YildizIptalEt()">İptal</button>
                </div>
            }
        </div>
    </div>

    @Html.Partial("_AlertMesaj", "profil")

    <!-- 🔥 TAB ALANI -->
    <section class="product_description_area mt-4">

        <ul class="nav nav-tabs gap-2">

    <li class="nav-item" role="presentation">
        <button class="nav-link btn btn-light active"
                data-bs-toggle="tab"
                data-bs-target="#hakkinda"
                type="button">
            Hakkında
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link btn btn-light"
                data-bs-toggle="tab"
                data-bs-target="#devamedenkitaplar"
                type="button"
                onclick="DevamEdenKitaplar()">
            Devam Eden
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link btn btn-light"
                data-bs-toggle="tab"
                data-bs-target="#tamamlanankitaplar"
                type="button"
                onclick="TamamlananKitaplar()">
            Tamamlanan
        </button>
    </li>

    <li class="nav-item" role="presentation">
        <button class="nav-link btn btn-light"
                data-bs-toggle="tab"
                data-bs-target="#yayinlanan"
                type="button"
                onclick="YayinlananKitaplar()">
            Yayınlanan
        </button>
    </li>

        </ul>


        <div class="tab-content border p-3 border-top-0">
            <div class="tab-pane fade show active" id="hakkinda">
                @Model.NAME @Model.SURNAME
            </div>
            <div class="tab-pane fade" id="devamedenkitaplar">
                <div id="devameden"></div>
            </div>
            <div class="tab-pane fade" id="tamamlanankitaplar">
                <div id="tamamlanan"></div>
            </div>
            <div class="tab-pane fade" id="yayinlanan">
                <div id="yayin"></div>
            </div>
        </div>

    </section>

</div>

@section scripts {

<script>

    function showSpinner() {
        $("#globalSpinner").show();
    }

    function hideSpinner() {
        $("#globalSpinner").hide();
    }
    $("#bilgi").css("display", "none");

    var yildizPuani = 0;
    var yazarId = $("#yazar_id").val();
    var profil = $("#profilicin").val();

    function Bilgilendirme(follow) {

        //var email = @Model.EMAIL;
        var email = "@(Model.EMAIL ?? "")";
        var message = "";

        if (follow == 1) {
            message = " Takip Etti";
        } else {
            message = " Takipten Çıkardı";
        }

        var yorum = "(@ViewBag.LGN_USER.NAME) adlı kişi sizi " + message;

        $.post("@Url.Action(nameof(EmailController.MailBilgilendirme), "Email")", {
            "konu": "Herkes Yazar Olsun'dan Bildirim",
            "kime": email,
            "tip": 0,
            "mesaj": yorum,


        }, function (data) {
            console.log("data:" + data.state);
            if (data.state == 1) {
                $("#basarili-" + profil).css("display", "block");
                $("#basarili-" + profil + " #mesaj").html(data.message);

                $("#bilgi-" + profil).css("display", "none");
                $("#uyari-" + profil).css("display", "none");


            }
            else if (data.state == 3) {
                $("#bilgi-" + profil).css("display", "block");
                $("#bilgi-" + profil + " #mesaj").html(data.message);

                $("#basarili-" + profil).css("display", "none");
                $("#uyari-" + profil).css("display", "none");
            }
            else {
                $("#uyari-" + profil).css("display", "block");
                $("#bilgi-" + profil).css("display", "none");
                $("#basarili-" + profil).css("display", "none");
                $("#uyari-" + profil + " #mesaj").html(data.message);
            }

        });
    }


    function YildizVer() {

        if (yildizPuani == 0) {
            $("#uyari-" + profil).css("display", "block");
            $("#bilgi-" + profil).css("display", "none");
            $("#basarili-" + profil).css("display", "none");
            $("#uyari-" + profil + " #mesaj").html("Yıldız veriniz.");
            return;
        }

        $.post("@Url.Action(nameof(KisiController.PostWriterStars), "Kisi")",
            {
                "id": yazarId,
                "puan": yildizPuani
            },

            function (data) {
                console.log("data YildizVer ",data);
                if (data.state == 1) {
                    $("#basarili-" + profil).css("display", "block");
                    $("#basarili-" + profil + " #mesaj").html(data.message);

                    $("#bilgi-" + profil).css("display", "none");
                    $("#uyari-" + profil).css("display", "none");

                       setTimeout(function () {
                        window.location.reload();
                    }, 3000);

                }
                else if (data.state == 3) {
                    $("#bilgi-" + profil).css("display", "block");
                    $("#bilgi-" + profil + " #mesaj").html(data.message);

                    $("#basarili-" + profil).css("display", "none");
                    $("#uyari-" + profil).css("display", "none");
                }
                else {
                    $("#uyari-" + profil).css("display", "block");
                    $("#bilgi-" + profil).css("display", "none");
                    $("#basarili-" + profil).css("display", "none");
                    $("#uyari-" + profil + " #mesaj").html(data.message);
                }
            });
    }

    function YazarTakip(follow) {

        var kural = $('#kural').text().trim();

        $.post("@Url.Action(nameof(KisiController.PostWriterFollow), "Kisi")",
            {
                "id": yazarId,
                "follow": follow
            },

            function (data) {
                console.log("data yazartakip ",data);
                if (data.state == 1) {
                    $("#basarili-" + profil).css("display", "block");
                    $("#basarili-" + profil + " #mesaj").html(data.message);

                    $("#bilgi-" + profil).css("display", "none");
                    $("#uyari-" + profil).css("display", "none");

                    if (kural === "True") {
                        Bilgilendirme(follow);
                    }
                    setTimeout(function () {
                        window.location.reload();
                    }, 3000);
                }
                else if (data.state == 3) {
                    $("#bilgi-" + profil).css("display", "block");
                    $("#bilgi-" + profil + " #mesaj").html(data.message);

                    $("#basarili-" + profil).css("display", "none");
                    $("#uyari-" + profil).css("display", "none");
                }
                else {
                    $("#uyari-" + profil).css("display", "block");
                    $("#bilgi-" + profil).css("display", "none");
                    $("#basarili-" + profil).css("display", "none");
                    $("#uyari-" + profil + " #mesaj").html(data.message);
                }
            });
    }

    function Hakkinda() {

        $("#bilgi").css("display", "block");
    }

    var yildizlar = document.getElementsByClassName("yildizver");

    function YildizIptalEt() {
          yildizPuani = 0;
          console.log("iptal");
          for (var i = 0; i < yildizlar.length; i++) {
              $(yildizlar[i]).css("color", "black");
          }
      }

      function YildizVerChange(adet) {
          yildizPuani = adet;
          console.log("adet:" + adet);

          for (var i = 0; i < yildizlar.length; i++) {
              $(yildizlar[i]).css("color", "black");
          }

          for (var i = 0; i < adet; i++) {
              $(yildizlar[i]).css("color", "dodgerblue");
          }
      }

      for (var i = 0; i < yildizlar.length; i++) {
          yildizlar[i].addEventListener("click", function () {
              var adet = parseInt(this.getAttribute("data-adet"));
              YildizVerChange(adet);
          });
      }

          function DevamEdenKitaplar() {
        showSpinner();

        $.post("@Url.Action(nameof(KitaplarController.AraButonFiltrelemeKitaplar), "Kitaplar")",
            {
                "yazarIId": yazarId,
                "DevamEdenKitaplar": true,
                "profilKitapTuru": "devameden",
                "tip": profil
            },
            function (data) {
                $("#devameden").html(data); // veri DOM’a eklendi
                hideSpinner();              // spinner şimdi kapat
            }
        ).fail(function() {
            hideSpinner();
            console.log("Veri yüklenirken bir hata oluştu.");
        });
    }

        function loadKitaplar(tabId, postData, targetDivId) {
        
        if ($("#" + targetDivId).children().length > 0) return;

        showSpinner();

        $.post("@Url.Action(nameof(KitaplarController.AraButonFiltrelemeKitaplar), "Kitaplar")",
            postData,
            function (data) {
                $("#" + targetDivId).html(data); // veri DOM’a eklendi
            })
            .fail(function () {
                console.log("Veri yüklenirken bir hata oluştu.");
            })
            .always(function () {
                hideSpinner(); // spinner veri DOM’a geldikten sonra kapanır
            });
    }
        
    function TamamlananKitaplar() {
        loadKitaplar("tamamlanankitaplar",
            {
                "yazarIId": yazarId,
                "BitenKitaplar": true,
                "profilKitapTuru": "tamamlanan",
                "tip": profil
            },
            "tamamlanan"
        );
    }

    
    function YayinlananKitaplar() {
        loadKitaplar("yayinlanankitaplar",
            {
                "yazarIId": yazarId,
                "YayinlananKitaplar": true,
                "profilKitapTuru": "yayin",
                "tip": profil
            },
            "yayin"
        );
    }
</script>

}
