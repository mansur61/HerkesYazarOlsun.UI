
@{
    ViewData["Title"] = "Tüm Yazarlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 


@model HerkesYazarOlsun.Model.ViewModel.VM_USERS_DETAIL;
@using HerkesYazarOlsun.Portal.Controllers;
@using HerkesYazarOlsun.Model.ViewModel;

 
@if (ViewBag.FavoriYazarlar != null && ViewBag.FavoriYazarlar)
{
    <h3 style="margin: 50px auto;">Favori Yazarlar</h3>
}
else  
{
    <h3 style="margin: 50px auto;">Tüm Yazarlar</h3>
}
 
@{
    string tip = "tumyazarlar";
    Model.Tip =  tip;
}
<input type="hidden" id="tip" value="@tip" />


@Html.Partial("_AlertMesaj", @tip) 

@Html.Partial("_YazarFiltreleme")
  
<br/>

<div id="tumyazarlar">
     
     <h6>
        <span>@(Model.VMUsersList?.Count ?? 0)</span> Kayıt Var
    </h6>

<hr />
    @{
        int perSlide = Model.sliderdaGosterilecekKayit != 0
            ? Model.sliderdaGosterilecekKayit
            : Convert.ToInt32(ViewBag.SliderdaGosterilecekKayit);


        int total = Model.VMUsersList.Count;
        int sliderSayisi = (int)Math.Ceiling((double)total / perSlide);
        var butons = new  VM_PAGINATION_BUTTON{
                sliderSayisi = sliderSayisi,
                sliderSayiDivTagName = "tumyazarlar"
                
        };
        Model.vM_PAGINATION_BUTTONS = butons;
    }

    @Html.Partial("Yazarlar",@Model) 
    @Html.Partial("_PaginationButonlar",@Model.vM_PAGINATION_BUTTONS)

</div>


<div id="arabutonfiltre"></div>

<script src= "~/js/general.js"></script>

<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/nice-select/js/jquery.nice-select.min.js"></script> 


<script>

    $("#arabutonfiltre").css("display", "none"); 

    function Temizle(){ 
        location.reload();
                 
    }
    function Ara() {
        
       //UyariVer(1, "#basarili-", "#bilgi-", "#uyari-", "Kitap Tamamlandı. İlgili kitaba yönlendiriliyorsunuz..");
        var listelenecek_kayit_sayisi = $("#kayit_sayisi").val();
        console.log(" YazariFavorilereEkle ara "+listelenecek_kayit_sayisi);
       
        if(listelenecek_kayit_sayisi == 0){
            return ;
        }


        if (listelenecek_kayit_sayisi == null) {
            listelenecek_kayit_sayisi = 10;
        }

        var yazar_ara = $("#yazar_ara").val();
         //alert(yazar_ara);
      
        $.post("@Url.Action(nameof(KisiController.AraButonFiltrelemeYazarlar), "Kisi")", {
            "listelenecek_kayit_sayisi": listelenecek_kayit_sayisi,
            "YAZAR_ADI": yazar_ara
        }, function (data) {
            if (data) {
                
                $("#arabutonfiltre").html(data);
                $("#arabutonfiltre").css("display", "block");
               
                $("#tumyazarlar").css("display", "none"); 

            } else {
                //alert("olumsuz");
                $("#tumyazarlar").css("display", "block");
                $("#arabutonfiltre").css("display", "block");
            }

        });
    }
     
</script>

