@{ ViewData["Title"] = "Makale Ekle"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="container py-4" style="max-width:760px">
    <h1>Makale Ekle</h1>
    <p>Word (.docx) veya PDF dosyanızı yükleyin. Önce taslak olarak kaydedilir; okuduktan sonra yayınlayabilirsiniz.</p>
    @Html.ValidationSummary(false, "", new { @class = "text-danger", role = "alert" })
    <form action="@Url.Action("Ekle", "Makaleler")" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <label for="baslik">Makale başlığı</label>
        <input class="form-control mb-3" id="baslik" name="baslik" value="@ViewBag.Baslik" maxlength="200" required />
        <label for="dosya">Word veya PDF dosyası (en fazla 20 MB)</label>
        <input class="form-control mb-3" type="file" id="dosya" name="dosya" accept=".docx,.pdf" required />
        <p>Belgedeki metin mobil okumaya uygun aktarılır. Resimler ve özgün sayfa düzeni aktarılmaz. Eski .doc dosyalarını .docx olarak kaydedin.</p>
        <button class="btn btn-primary" type="submit">Taslak olarak yükle</button>
        <a href="@Url.Action("Profil", "Kisi")" class="btn btn-light">Profilime dön</a>
    </form>
</div>
