@model HerkesYazarOlsun.Model.Entity.Makale
@{ ViewData["Title"] = Model.Baslik; Layout = "~/Views/Shared/_Layout.cshtml"; }
<article class="container py-4" style="max-width:800px;overflow-wrap:anywhere">
    <a href="@Url.Action("Index", "Home")">← Ana sayfa</a>
    @if (TempData["MakaleHata"] is string hata) { <p role="alert" class="text-danger">@hata</p> }
    <h1 class="mt-3">@Model.Baslik</h1>
    <p>@Model.Yazar · @(Model.YayinTarihi?.ToLocalTime().ToString("dd.MM.yyyy") ?? "Taslak — henüz yayınlanmadı")</p>
    @if (ViewBag.IsOwner == true && !Model.YayinTarihi.HasValue)
    {
        <form action="@Url.Action("Yayinla", "Makaleler")" method="post" class="mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button class="btn btn-success" type="submit">Yayınla</button>
        </form>
    }
    <div style="white-space:pre-wrap;font-size:1.125rem;line-height:1.85">@Model.Metin</div>
</article>
