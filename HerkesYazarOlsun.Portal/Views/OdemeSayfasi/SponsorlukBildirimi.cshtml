@{
    ViewData["Title"] = "Kitap Oku";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_SPONSORLAR;
@using HerkesYazarOlsun.Portal.Controllers;


<input type="hidden" id="odemesponsoricin" value="odemesponsor" />
<input type="hidden" id="loginId" value="1" />
<input type="hidden" id="kitapId" value="1" />

@{
    string alertmesajgostermedurumu = "odemesponsor";
}


<div class="container">

    <div class="row">

        <p style="text-align:center"><i class="fa fa-check" style="font-size:200px;color:green"></i></p>
        <center><h3><strong>Ödemeniz Başarılı şekilde alınmıştır.</strong></h3></center>

        <br /><br />

        <p>
            Aşağıda bulunan form ile bizlere yayınlamak istediğiniz <span style="color:green"> <strong> sponsor </strong></span> 'u  seçerek bilgi veriniz.
        </p>
        <p>
            Bize ulaşan bilgiler doğrultusunda kitabınızın incelenip <span style="text-decoration:underline">yayına uygun olması halinde</span> sponsor koudunuzu
            3 iş günü içerisinde formda belirttiğiniz mail ile size iletilecektir. <span style="text-decoration:underline"> Lütfen geçerli ve aktif mail adresi giriniz </span> 
        </p>
        <div>
            <span style="color:red"><strong>NOT</strong></span>  <span style="text-decoration:underline"> Yayına alınmama durumunda </span> ise size düzeltmeniz gereken durumlar olursa belirtilecektir.
            Bu durumlar;
            <p></p>
            <p> * Kitabınızın içeriği ile alakalı olabilmektedir. (Argo kelimeler, cinsellik durumları vs.) </p>
            <p> * Yayın evinin düzeltmesini istediği format bazlı durumlar olabilmektedir </p>
        </div>

        <br /><br />
        <div class="col-sm-8">

            <div class="row">

                <div class="form-group ">
                    <label for="name">Ad-Soyad </label>
                    <input type="text" id="ad" class="form-control" name="cardOnName" placeholder="Adınız" />


                </div>
                <div class="form-group ">
                    <label for="email">Mail Adresiniz</label>
                    <input type="text" id="email" name="email" class="form-control" placeholder="Mail Adresiniz">
                </div>

                <div class="form-group ">
                    <label for="tel">Telefon Numaranız</label>
                    <input type="number" name="tel" class="form-control" id="tel" placeholder="Telefon Numaranız: 0535xxxxxxx" />
                </div>

                <div class="dropdown" style="padding:10px">
                    <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                        <span id="seciim">Sponsor Seçiniz</span>  <span class="caret"></span>
                    </button>
                    <ul class="dropdown-menu" role="menu" id="sponsorMenu">

                        @foreach (var item in @Model.SponsorlarList)
                        {
                            <li><a class="spns" value="@item.ID"  name="@item.SponsorAdi" onclick="SponsorSec(@item.ID)">@item.SponsorAdi</a></li>

                        }
                    </ul>

                </div>

                <div style="height:30px"></div>

                <div class="clearfix"></div>
                <div class="form-group">
                    <label for="mesaj">Mesajınız Var Mı?</label>
                    <textarea type="text" name="mesaj" class="form-control" rows="6" id="mesaj" placeholder="Varsa Mesajınız"></textarea>
                </div>

                @Html.Partial("_AlertMesaj",@alertmesajgostermedurumu)
                <div class="form-group col-lg-12">

                    <button onclick="Gonder()" class="btn btn-primary pull-right">Sponsorunu İlet</button>
                    @*type="submit"*@
                    <div class="clearfix"></div>
                </div>
            </div>
        </div>

        @*  <div class="col-sm-4">
        <h3>Address</h3>
        <h4>Banzhow Template</h4>
        <p>
        <i class="fa fa-map-marker"></i> 123 My Street, Banzhow City, CA 4567
        </p>
        <p><i class="fa fa-phone"></i> (123) 456-7890</p>
        <p><i class="fa fa-envelope"></i> <a href="mailto:info@banzhow.com">info@banzhow.com</a></p>
        <p><i class="fa fa-clock-o"></i> Monday - Friday: 9:00 AM to 5:00 PM</p>
        </div>*@

    </div>
</div>

<script>

    var sponsorMenuId = 0;
    var loginId = $("#loginId").val();
    var kitapId = $("#kitapId").val();

    var odemesponsor = $("#odemesponsoricin").val();

    function Gonder() {
        var ad = $("#ad").val();
        var email = $("#email").val();
        var tel = $("#tel").val();
        //var sponsorMenuId = $("#sponsorMenu").val();
        var mesaj = $("#mesaj").val();



        console.log(" ad: " + ad + " email: " + email + " tel: " + tel + " sponsorMenuId: " + sponsorMenuId + " mesaj: " + mesaj);

        if (sponsorMenuId == 0){
            $("#uyari-" + odemesponsor).css("display", "block");
            $("#bilgi-" + odemesponsor).css("display", "none");
            $("#basarili-" + odemesponsor).css("display", "none");
            $("#uyari-" + odemesponsor + " #mesaj").html("Sponsor bilgisi seçilmelidir. ");
            return;
        }
        if (email == ""  && name == "" && tel == "") {
            $("#uyari-" + odemesponsor).css("display", "block");
            $("#bilgi-" + odemesponsor).css("display", "none");
            $("#basarili-" + odemesponsor).css("display", "none");
            $("#uyari-" + odemesponsor + " #mesaj").html("Ad, Mail ve Telefon bilgilerinizi boş bırakmayınız.. ");
            return;
        }

        $.post("@Url.Action(nameof(OdemeSayfasiController.SaveSponsorlukBildir), "OdemeSayfasi")", {
            "NameSurname": ad,
            "Mail": email,
            "Tel": tel,
            "Mesaj": mesaj,
            "SponsorId": sponsorMenuId,
            "LoginUserId": loginId,
            "KitapId": kitapId

        }, function (data) {
            console.log(data);
            if (data.state == 1) {
                $("#basarili-" + odemesponsor).css("display", "block");
                $("#basarili-" + odemesponsor + " #mesaj").html(data.message);

                $("#bilgi-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor).css("display", "none");

            }
            else if (data.state == 3) {
                $("#bilgi-" + odemesponsor).css("display", "block");
                $("#bilgi-" + odemesponsor + " #mesaj").html(data.message);

                $("#basarili-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor).css("display", "none");
            }
            else {
                $("#uyari-" + odemesponsor).css("display", "block");
                $("#bilgi-" + odemesponsor).css("display", "none");
                $("#basarili-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor + " #mesaj").html(data.message);
            }

        });


    }

    function SponsorSec(id) {
        sponsorMenuId = id;
        var nodeNameProperty = SponsorAdiGetir(id - 1);
        console.log("nodeNameProperty :" + nodeNameProperty);
        $("#seciim").html(nodeNameProperty);

    }
    function SponsorAdiGetir(id) {
        var nodeNameProperty = "";
        const nodeList = document.querySelectorAll(".spns");

        for (let i = 0; i < nodeList.length; i++) {

            if (id == i) {
                nodeNameProperty = nodeList[i].name;
            }
        }
        return nodeNameProperty;
    }


</script>