@{
    ViewData["Title"] = " ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_SPONSORLAR;
@using HerkesYazarOlsun.Portal.Controllers;

 

@{
    string alertmesajgostermedurumu = "odemesponsor";
}

@section Styles{
    <style>
    .btn-custom {
        background-color: #00C4A0;
        border-color: #00C4A0;
        color: #fff;
    }

    /* Hover ve aktif durumları */
    .btn-custom:hover {
        background-color: #00b08f; /* biraz koyu ton hover için */
        border-color: #00b08f;
        color: #fff;
    }

    .btn-custom:focus, .btn-custom:active {
        background-color: #00997f;
        border-color: #00997f;
        color: #fff;
        box-shadow: 0 0 0 0.25rem rgba(0,196,160,0.5);
    }
</style>
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-4">
                <i class="fa fa-check" style="font-size:200px;color:green"></i>
                <h3 class="mt-3"><strong>Ödemeniz Başarılı şekilde alınmıştır.</strong></h3>
            </div>

            <p>
                Aşağıda bulunan form ile bizlere yayınlamak istediğiniz 
                <span class="text-success"><strong>sponsor</strong></span>'u seçerek bilgi veriniz.
            </p>
            <p>
                Bize ulaşan bilgiler doğrultusunda kitabınızın incelenip 
                <span class="text-decoration-underline">yayına uygun olması halinde</span> sponsor kodunuz
                3 iş günü içerisinde formda belirttiğiniz mail ile size iletilecektir. 
                <span class="text-decoration-underline"> Lütfen geçerli ve aktif mail adresi giriniz </span>
            </p>
            <div class="mb-3">
                <span class="text-danger fw-bold">NOT</span>  
                <span class="text-decoration-underline"> Yayına alınmama durumunda </span> ise size düzeltmeniz gereken durumlar belirtilir:
                <ul>
                    <li>Kitabınızın içeriği ile alakalı olabilmektedir (Argo kelimeler, cinsellik vb.)</li>
                    <li>Yayın evinin düzeltmesini istediği format bazlı durumlar olabilmektedir</li>
                </ul>
            </div>
            <div class="mb-3">
                <span class="text-danger fw-bold">ÖNEMLİ </span>  
                <span class="text-decoration-underline">
                    3 iş günü içinde size sponsor kodunuz iletilmesi halinde
                </span> 
                <span class="text-decoration-underline text-danger">
                    PARANIZ İADE EDİLMEYECEKTİR !!!
                </span>
            </div>

            <form action="" method="post" enctype="multipart/form-data" class="needs-validation" id="form-bilgi-gonder" novalidate>
                <div class="mb-3">
                    <label for="ad" class="form-label">Ad-Soyad</label>
                    <input type="text" id="ad" class="form-control" name="cardOnName" placeholder="Adınız" required>
                    <div class="invalid-feedback">Adınızı giriniz.</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Mail Adresiniz</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="Mail Adresiniz" required>
                    <div class="invalid-feedback">Geçerli bir mail giriniz.</div>
                </div>
                <div class="mb-3">
                    <label for="tel" class="form-label">Telefon Numaranız</label>
                    <input type="tel" name="tel" class="form-control" id="tel" placeholder="Telefon Numaranız: 0535xxxxxxx" required>
                    <div class="invalid-feedback">Telefon numaranızı giriniz.</div>
                </div>

                <!-- Bootstrap 5 Dropdown -->
                <div class="mb-3">
                    <label class="form-label">Sponsor Seçiniz</label>
                    <div class="dropdown">
                        <button class="btn btn-custom dropdown-toggle w-100 text-start" 
        type="button" 
        id="dropdownSponsorButton" 
        data-bs-toggle="dropdown" 
        aria-expanded="false">
    <span id="seciim">Sponsor Seçiniz</span>
</button>
                        <ul class="dropdown-menu w-100" aria-labelledby="dropdownSponsorButton" id="sponsorMenu">
                            @foreach (var item in Model.SponsorlarList)
                            {
                                <li><a class="dropdown-item spns" href="#" data-id="@item.ID" data-name="@item.SponsorAdi" onclick="SponsorSec(this)">@item.SponsorAdi</a></li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ödemeyi yaptığınız dekontu bize bildiriniz*</label>
                    <input name="file" type="file" id="dekontAktar" class="form-control" onchange="dosyaSecim('dosyaAktarmaDekont')">
                    <input type="hidden" id="aktarilacakDekont">
                </div>

                <div class="progress mb-3">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-danger" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="mb-3">
                    <label for="mesaj" class="form-label">Mesajınız Var Mı?</label>
                    <textarea name="mesaj" class="form-control" rows="6" id="mesaj" placeholder="Varsa Mesajınız"></textarea>
                </div>

                @Html.Partial("_AlertMesaj", alertmesajgostermedurumu)

                <button type="submit" class="btn btn-custom w-100">Sponsorunu İlet</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 JS dosyası ve Bootstrap JS dosyası-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script> 
 
    <script src= "~/js/general.js"></script>
}

<script>

    var sponsorMenuId = 0;
    var loginId = $("#loginId").val();
    var kitapId = $("#kitapId").val();

    var odemesponsor = $("#odemesponsoricin").val();


    var progressBar = document.getElementsByClassName('progress-bar')[0];

    var tip = odemesponsor;


    var form = document.getElementById('form-bilgi-gonder');
    form.addEventListener('submit', function (event) {
        event.preventDefault();

        var aktarilacakDekont = $("#aktarilacakDekont").val();
        console.log("bak aktarılacak Dekont:" + aktarilacakDekont);

        var ad = $("#ad").val();
        var email = $("#email").val();
        var tel = $("#tel").val();
        var mesaj = $("#mesaj").val();

        if (sponsorMenuId == 0) {
            $("#uyari-" + odemesponsor).css("display", "block");
            $("#bilgi-" + odemesponsor).css("display", "none");
            $("#basarili-" + odemesponsor).css("display", "none");
            $("#uyari-" + odemesponsor + " #mesaj").html("Sponsor bilgisi seçilmelidir. ");
            return;
        }

        var formData = new FormData(this);

        //formData.append('KitapId', kitapId);
        formData.append('KitapIdENC', kitapId);        
        formData.append('LoginUserId', loginId);
        formData.append('NameSurname', ad);
        formData.append('Mail', email);
        formData.append('SponsorId', sponsorMenuId);
        formData.append('Mesaj', mesaj);

        var dosyaInputs = form.querySelectorAll('input[type="file"]');
        console.log(dosyaInputs.length);
        for (var i = 0; i < dosyaInputs.length; i++) {
            formData.append('dosyalar', dosyaInputs[i].files[0]);
        }

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Kaydetmek için Emin Misiniz?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Evet',
            cancelButtonText: 'Hayır',
            customClass: {
                confirmButton: 'btn btn-primary',
                cancelButton: 'btn btn-danger'
            }
        }).then((result) => {
            if (result.isConfirmed) {

                progressBar.style.width = '0%';

                let progress = 0;
                const interval = setInterval(() => {

                    if (progress < 90) {  // Sunucu yanıtı gelene kadar %90'a kadar dolmasını sağla
                        progress += 10;
                        progressBar.style.width = `${progress}%`;
                    }
                }, 3000);

                $.ajax({
                    url: 'SaveSponsorlukBildir',
                    method: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        console.log('Başarılı dönüş: response', response);
                        if (response.state == 1) {

                            clearInterval(interval);
                            progressBar.style.width = '100%';

                            BilgiVer(response.state, "#basarili-", "#bilgi-", "#uyari-", "Sponsor Bildiriminiz Alınmıştır. İlgili kitaba yönlendiriliyorsunuz..");
                            setTimeout(function () {
                                 
                                 window.location.href = "/Kitaplar/KitapDetay?kitap_id=" + kitapId.toString();

                            }, 3000);
                        }
                        else {
                            clearInterval(interval);
                            progressBar.style.width = `${progress}%`;
                            BilgiVer(response.state, "#basarili-", "#bilgi-", "#uyari-", response.message);
                        }

                    },
                    error: function (xhr, status, error) {
                        console.error('Hata:', error);
                        clearInterval(interval);
                        progressBar.style.width = `${progress}%`;

                    }
                });
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire('Sponsorluk Bildirimi', 'Sponsorluk Bildirimi işleminde sorun oluştu. Bizim ile iletişime geçiniz', 'error');
            }
        });
    });

    function BilgiVer(state, basarili, bilgi, uyari, mesaj) {
        if (state == 1) {
            $(basarili + tip).css("display", "block");
            $(basarili + tip + " #mesaj").html(mesaj);

            $(bilgi + tip).css("display", "none");
            $(uyari + tip).css("display", "none");

        }
        else if (state == 3) {
            $(bilgi + tip).css("display", "block");
            $(bilgi + tip + " #mesaj").html(mesaj);

            $(basarili + tip).css("display", "none");
            $(uyari + tip).css("display", "none");
        }
        else {
            $(uyari + tip).css("display", "block");
            $(bilgi + tip).css("display", "none");
            $(basarili + tip).css("display", "none");
            $(uyari + tip + " #mesaj").html(mesaj);
        }
    }


    function Gonder() {
        var ad = $("#ad").val();
        var email = $("#email").val();
        var tel = $("#tel").val();
        var mesaj = $("#mesaj").val();

        console.log(" ad: " + ad + " email: " + email + " tel: " + tel + " sponsorMenuId: " + sponsorMenuId + " mesaj: " + mesaj);

        if (sponsorMenuId == 0) {
            $("#uyari-" + odemesponsor).css("display", "block");
            $("#bilgi-" + odemesponsor).css("display", "none");
            $("#basarili-" + odemesponsor).css("display", "none");
            $("#uyari-" + odemesponsor + " #mesaj").html("Sponsor bilgisi seçilmelidir. ");
            return;
        }
        if (email == "" && ad == "" && tel == "") {
            $("#uyari-" + odemesponsor).css("display", "block");
            $("#bilgi-" + odemesponsor).css("display", "none");
            $("#basarili-" + odemesponsor).css("display", "none");
            $("#uyari-" + odemesponsor + " #mesaj").html("Ad, Mail ve Telefon bilgilerinizi boş bırakmayınız.. ");
            return;
        }

        $.post("@Url.Action(nameof(OdemeSayfasiController.SaveSponsorlukBildirAsync), "OdemeSayfasi")", {
            "NameSurname": ad,
            "Mail": email,
            "Tel": tel,
            "Mesaj": mesaj,
            "SponsorId": sponsorMenuId,
            "LoginUserId": loginId,
            "KitapId": kitapId

        }, function (data) {
            console.log(data);
            if (data.state == 1) {
                $("#basarili-" + odemesponsor).css("display", "block");
                $("#basarili-" + odemesponsor + " #mesaj").html(data.message);

                $("#bilgi-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor).css("display", "none");

            }
            else if (data.state == 3) {
                $("#bilgi-" + odemesponsor).css("display", "block");
                $("#bilgi-" + odemesponsor + " #mesaj").html(data.message);

                $("#basarili-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor).css("display", "none");
            }
            else {
                $("#uyari-" + odemesponsor).css("display", "block");
                $("#bilgi-" + odemesponsor).css("display", "none");
                $("#basarili-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor + " #mesaj").html(data.message);
            }

        });


    }

     function SponsorSec(el) {
        const sponsorId = el.getAttribute("value");
        const sponsorName = el.getAttribute("name");

        sponsorMenuId = sponsorId;
        $("#seciim").html(sponsorName);

        console.log("Seçilen sponsor adı:", sponsorName);
    }




</script>