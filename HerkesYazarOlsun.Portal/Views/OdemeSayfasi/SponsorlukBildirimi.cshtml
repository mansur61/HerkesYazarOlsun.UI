@{
    ViewData["Title"] = "Kitap Oku";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_SPONSORLAR;
@using HerkesYazarOlsun.Portal.Controllers;


<input type="hidden" id="odemesponsoricin" value="odemesponsor" />
<input type="hidden" id="loginId" value="1" />
<input type="hidden" id="kitapId" value="1" />

@{
    string alertmesajgostermedurumu = "odemesponsor";
}

@section Styles {

    <link href="~/lib/bootstrap/dist/css/kitapekle.css" rel="stylesheet" /> 
}


<div class="container">

    <div class="row">

        <p style="text-align:center"><i class="fa fa-check" style="font-size:200px;color:green"></i></p>
        <center><h3><strong>Ödemeniz Başarılı şekilde alınmıştır.</strong></h3></center>

        <br /><br />

        <p>
            Aşağıda bulunan form ile bizlere yayınlamak istediğiniz <span style="color:green"> <strong> sponsor </strong></span> 'u  seçerek bilgi veriniz.
        </p>
        <p>
            Bize ulaşan bilgiler doğrultusunda kitabınızın incelenip <span style="text-decoration:underline">yayına uygun olması halinde</span> sponsor koudunuzu
            3 iş günü içerisinde formda belirttiğiniz mail ile size iletilecektir. <span style="text-decoration:underline"> Lütfen geçerli ve aktif mail adresi giriniz </span>
        </p>
        <div>
            <span style="color:red"><strong>NOT</strong></span>  <span style="text-decoration:underline"> Yayına alınmama durumunda </span> ise size düzeltmeniz gereken durumlar olursa belirtilecektir.
            Bu durumlar;
            <p></p>
            <p> * Kitabınızın içeriği ile alakalı olabilmektedir. (Argo kelimeler, cinsellik durumları vs.) </p>
            <p> * Yayın evinin düzeltmesini istediği format bazlı durumlar olabilmektedir </p>
        </div>

        <br /><br />
        <div class="col-sm-8">
            <form action="" method="post" enctype="multipart/form-data" class="needs-validation" id="form-bilgi-gonder">
                <div class="row">

                    <div class="form-group ">
                        <label for="name">Ad-Soyad </label>
                        <input type="text" id="ad" class="form-control" name="cardOnName" placeholder="Adınız" />


                    </div>
                    <div class="form-group ">
                        <label for="email">Mail Adresiniz</label>
                        <input type="text" id="email" name="email" class="form-control" placeholder="Mail Adresiniz">
                    </div>

                    <div class="form-group ">
                        <label for="tel">Telefon Numaranız</label>
                        <input type="number" name="tel" class="form-control" id="tel" placeholder="Telefon Numaranız: 0535xxxxxxx" />
                    </div>

                    <div class="dropdown" style="padding:10px">
                        <button type="button" class="btn btn-primary dropdown-toggle" data-toggle="dropdown">
                            <span id="seciim">Sponsor Seçiniz</span>  <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu" role="menu" id="sponsorMenu">

                            @foreach (var item in @Model.SponsorlarList)
                            {
                                <li><a class="spns" value="@item.ID" name="@item.SponsorAdi" onclick="SponsorSec(@item.ID)">@item.SponsorAdi</a></li>

                            }
                        </ul>

                    </div>

                    <div class="card-body">

                        <h5>Ödemeyi yaptığınız dekontu bize bildiriniz*</h5>
                        <input name="file" type="file" id="dosyaAktar" onchange="dosyaSecim('dosyaAktarmaDekont')" />
                        <input type="hidden" id="aktarilacakDekont">
                    </div>
                    <br />
                    <div class="progress">
                        <div aria-valuemax="100" aria-valuemin="0" aria-valuenow="50" class="progress-bar progress-bar-striped progress-bar-animated bg-danger" role="progressbar" style="width: 0%"></div>
                    </div>

                    <div style="height:30px"></div>

                    <div class="clearfix"></div>
                    <div class="form-group">
                        <label for="mesaj">Mesajınız Var Mı?</label>
                        <textarea type="text" name="mesaj" class="form-control" rows="6" id="mesaj" placeholder="Varsa Mesajınız"></textarea>
                    </div>

                    @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)
                    <div class="form-group col-lg-12">

                        <button type="submit" class="btn btn-primary pull-right">Sponsorunu İlet</button>
                        @* onclick="Gonder()" *@
                        @**@
                        <div class="clearfix"></div>
                    </div>
                </div>
            </form>
        </div>


    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 JS dosyası ve Bootstrap JS dosyası -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>


}
<script>

    var sponsorMenuId = 0;
    var loginId = $("#loginId").val();
    var kitapId = $("#kitapId").val();

    var odemesponsor = $("#odemesponsoricin").val();


    var progressBar = document.getElementsByClassName('progress-bar')[0];
    console.log(progressBar);

    var tip = odemesponsor;

    var form = document.getElementById('form-bilgi-gonder');
    form.addEventListener('submit', function (event) {
        event.preventDefault();

        var aktarilacakDekont = $("#aktarilacakDekont").val();
        console.log("bak aktarılacak Dekont:" + aktarilacakDekont);

        var formData = new FormData(this);  
       
        formData.append('KitapId', kitapId);
        formData.append('LoginUserId', loginId);

        var dosyaInputs = form.querySelectorAll('input[type="file"]');
        console.log(dosyaInputs.length);
        for (var i = 0; i < dosyaInputs.length; i++) {
            formData.append('dosyalar', dosyaInputs[i].files[0]);
        }

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Kaydetmek için Emin Misiniz?",
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Evet',
            cancelButtonText: 'Hayır',
            customClass: {
                confirmButton: 'btn btn-primary',
                cancelButton: 'btn btn-danger'
            }
        }).then((result) => {
            if (result.isConfirmed) {

                progressBar.style.width = '0%';

                let progress = 0;
                const interval = setInterval(() => {

                    if (progress < 90) {  // Sunucu yanıtı gelene kadar %90'a kadar dolmasını sağla
                        progress += 10;
                        progressBar.style.width = `${progress}%`;
                    }
                }, 3000);

                $.ajax({
                    url: 'SaveSponsorlukBildir',
                    method: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        console.log('Başarılı dönüş: response', response);
                        if (response.state == 1) {

                            clearInterval(interval);
                            progressBar.style.width = '100%';

                            BilgiVer(response.state, "#basarili-", "#bilgi-", "#uyari-", "Kitabınız Eklendi. İlgili kitaba yönlendiriliyorsunuz..");
                            // setTimeout(function () {
                            //     var link = window.location.href;
                            //      window.location.href = "/Kitaplar/KitapDetay?kitapId=" + kitapId.toString();

                            // }, 3000);
                        }
                        else {
                            clearInterval(interval);
                            progressBar.style.width = `${progress}%`;
                            BilgiVer(response.state, "#basarili-", "#bilgi-", "#uyari-", response.message);//"Kitabınız Eklenemedi"
                        }

                    },
                    error: function (xhr, status, error) {
                        console.error('Hata:', error);
                        clearInterval(interval);
                        progressBar.style.width = `${progress}%`;

                    }
                });
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire('Sponsorluk Bildirimi', 'Sponsorluk Bildirimi işleminde sorun oluştu. Bizim ile iletişime geçiniz', 'error');
            }
        });
    });

    function BilgiVer(state, basarili, bilgi, uyari, mesaj) {
        if (state == 1) {
            $(basarili + tip).css("display", "block");
            $(basarili + tip + " #mesaj").html(mesaj);

            $(bilgi + tip).css("display", "none");
            $(uyari + tip).css("display", "none");

        }
        else if (state == 3) {
            $(bilgi + tip).css("display", "block");
            $(bilgi + tip + " #mesaj").html(mesaj);

            $(basarili + tip).css("display", "none");
            $(uyari + tip).css("display", "none");
        }
        else {
            $(uyari + tip).css("display", "block");
            $(bilgi + tip).css("display", "none");
            $(basarili + tip).css("display", "none");
            $(uyari + tip + " #mesaj").html(mesaj);
        }
    }


    function Gonder() {
        var ad = $("#ad").val();
        var email = $("#email").val();
        var tel = $("#tel").val();
        var mesaj = $("#mesaj").val();

        console.log(" ad: " + ad + " email: " + email + " tel: " + tel + " sponsorMenuId: " + sponsorMenuId + " mesaj: " + mesaj);

        if (sponsorMenuId == 0) {
            $("#uyari-" + odemesponsor).css("display", "block");
            $("#bilgi-" + odemesponsor).css("display", "none");
            $("#basarili-" + odemesponsor).css("display", "none");
            $("#uyari-" + odemesponsor + " #mesaj").html("Sponsor bilgisi seçilmelidir. ");
            return;
        }
        if (email == "" && name == "" && tel == "") {
            $("#uyari-" + odemesponsor).css("display", "block");
            $("#bilgi-" + odemesponsor).css("display", "none");
            $("#basarili-" + odemesponsor).css("display", "none");
            $("#uyari-" + odemesponsor + " #mesaj").html("Ad, Mail ve Telefon bilgilerinizi boş bırakmayınız.. ");
            return;
        }

        $.post("@Url.Action(nameof(OdemeSayfasiController.SaveSponsorlukBildir), "OdemeSayfasi")", {
            "NameSurname": ad,
            "Mail": email,
            "Tel": tel,
            "Mesaj": mesaj,
            "SponsorId": sponsorMenuId,
            "LoginUserId": loginId,
            "KitapId": kitapId

        }, function (data) {
            console.log(data);
            if (data.state == 1) {
                $("#basarili-" + odemesponsor).css("display", "block");
                $("#basarili-" + odemesponsor + " #mesaj").html(data.message);

                $("#bilgi-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor).css("display", "none");

            }
            else if (data.state == 3) {
                $("#bilgi-" + odemesponsor).css("display", "block");
                $("#bilgi-" + odemesponsor + " #mesaj").html(data.message);

                $("#basarili-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor).css("display", "none");
            }
            else {
                $("#uyari-" + odemesponsor).css("display", "block");
                $("#bilgi-" + odemesponsor).css("display", "none");
                $("#basarili-" + odemesponsor).css("display", "none");
                $("#uyari-" + odemesponsor + " #mesaj").html(data.message);
            }

        });


    }

    function SponsorSec(id) {
        sponsorMenuId = id;
        var nodeNameProperty = SponsorAdiGetir(id - 1);
        console.log("nodeNameProperty :" + nodeNameProperty);
        $("#seciim").html(nodeNameProperty);

    }
    function SponsorAdiGetir(id) {
        var nodeNameProperty = "";
        const nodeList = document.querySelectorAll(".spns");

        for (let i = 0; i < nodeList.length; i++) {

            if (id == i) {
                nodeNameProperty = nodeList[i].name;
            }
        }
        return nodeNameProperty;
    }


</script>