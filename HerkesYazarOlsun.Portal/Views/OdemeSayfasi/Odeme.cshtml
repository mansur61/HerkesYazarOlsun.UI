@{
    ViewData["Title"] = "Ödeme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Portal.Controllers;

<style>
    .pl-ziro {
        padding-left: 0px;
    }
</style>

<!-- Kredi kartı css ler -->
<style>
    .card-preview {
        position: relative;
        width: 100%;
        max-width: 400px;
        height: 230px;
        margin-bottom: 20px;
        border: 1px solid #ccc;
        border-radius: 10px;
        overflow: hidden;
        background-color: #333;
    }

    .card-preview img {
        width: 100%;
        height: 100%;
        position: absolute;
        top: 0;
        left: 0;
    }

    #cardNumberDisplay,
    #cardNameDisplay,
    #cardExpiryDisplay,
    #cvvDisplay {
        position: absolute;
        left: 20px;
        font-family: Arial, sans-serif;
        color: #fff;
    }

    #cardNumberDisplay {
        top: 80px;
        font-size: 20px;
    }

    #cardNameDisplay {
        top: 130px;
        font-size: 16px;
    }

    #cardExpiryDisplay {
        top: 160px;
        font-size: 16px;
    }

    #cvvDisplay {
        top: 80px;
        right: 20px;
        font-size: 16px;
        display: none;
    }

    .form label {
        display: block;
        margin-top: 10px;
        font-size: 14px;
        color: #333;
    }

    .form input {
        width: 100%;
        padding: 8px;
        margin-top: 5px;
        font-size: 14px;
        border: 1px solid #ccc;
        border-radius: 5px;
        box-sizing: border-box;
    }

    .expiry-cvv-container {
        display: flex;
        gap: 10px;
    }

    .expiry-cvv-container input {
        width: 80px;
    }

    input[type="number"] {
        -moz-appearance: textfield;
    }

    input[type="number"]::-webkit-outer-spin-button,
    input[type="number"]::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
</style>

<input type="hidden" id="odemeicin" value="odeme" />
<input type="hidden" id="loginId" value="@ViewBag.LoginUserId.ToString()" />
<input type="hidden" id="kitapId" value="@ViewBag.KitapId.ToString()" />

@{
    string alertmesajgostermedurumu = "odeme";
}

<div style="height:75px;"></div>
<h1>Ödeme Sayfası</h1>

<div class="container mb-5">
    <div class="row">
        <div class="col-12 col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Ödeme Detayları</h5>
                </div>
                <div class="card-body">
                    <div class="card-preview mx-auto">
                        <img id="cardImage" src="~/lib/img/card1.png" alt="" style="width: 100%; height:100%; border-radius: 10px;" />
                        <div id="cardNumberDisplay">**** **** **** ****</div>
                        <div id="cardNameDisplay">NAME ON CARD</div>
                        <div id="cardExpiryDisplay">MM/YY</div>
                        <div id="cvvDisplay">***</div>
                    </div>

                    <div class="form mt-3">
                        <label for="cardNumber">Kart Numarası:</label>
                        <input type="text" id="cardNumber" maxlength="19" placeholder="**** **** **** ****" />

                        <label for="cardName">Kart Üzerindeki İsim:</label>
                        <input type="text" id="cardName" placeholder="Ad Soyad" />

                        <label for="expiryDate">Son Kullanma Tarihi ve CVV:</label>
                        <div class="expiry-cvv-container">
                            <input type="number" id="expiryMonth" min="1" max="12" placeholder="MM" />
                            <input type="number" id="expiryYear" min="2000" placeholder="YY" />
                            <input type="number" id="cvv" maxlength="3" placeholder="CVV" />
                        </div>
                    </div>
                </div>
            </div>

            <ul class="list-group mt-3">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    Toplam Ödeme
                    <span class="badge bg-primary rounded-pill" id="odemeFiyati">@ViewBag.DefaultYayinUcreti</span>
                </li>
            </ul>

            <br />
            @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)

            <a class="btn btn-success btn-lg w-100 mt-3" role="button" onclick="OdemeAl()">ÖDEME YAP</a>

            <div id="loading" class="text-center mt-3" style="display: none;">
                <img src="https://i.gifer.com/ZZ5H.gif" alt="loading..." style="width: 50px; height: 50px;" />
            </div>
        </div>

        <div class="col-12 col-md-6" style="background-color:lightgrey; border-radius:20px;">
            <div class="text-center my-3">
                <p style="font-size:30px;">
                    <i class="fa fa-bell text-success"></i> <strong>TEBRİKLER</strong> <i class="fa fa-bell text-success"></i>
                </p>
            </div>
            <div style="font-size:14px; padding:10px;">
                <p><strong>Herkes Yazar Olsun</strong> da emekleriniz hiçbir zaman boşa çıkmayacaktır. Kitabınızı anlaşmalı olan tüm yayın evlerimizden birine indirimli olarak yayınlama hakkı kazandınız.</p>
                <p>Kitabınızı yayına almak istiyorsanız öncelikle <a href="/Home/Index#sponsorlar">Sponsorlar</a> bağlantısından sponsorlarımızı görebilir, istediğiniz sponsoru inceleyerek belirleyebilirsiniz.</p>
                <p>Belirlediğiniz sponsorlarımız ile anlaşmalı indirimlerimizden anında faydalanabilirsiniz. Bunun için sabit fiyatımızı (@ViewBag.DefaultYayinUcreti) ödeme sayfasından ödemeniz gerekmektedir.</p>
                <p>Ödemeniz başarılı olursa, açılan ekranda belirlediğiniz sponsoru bize mail aracılığıyla iletmeniz gerekmektedir.</p>
                <p>İlettiğiniz mail doğrultusunda sizlere sponsor kodu temin edilerek yayın işlemleri başlatılacaktır.</p>
                <p>Sponsor kodunuz ve detaylı bilgileriniz, mail adresinize 3 iş günü içinde iletilecektir.</p>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


<script>

    var loginUserId = $("#loginId").val();
    var kitapId = $("#kitapId").val();

    var odeme = $("#odemeicin").val();
    const defaultCardImageUrl = `${window.location.origin}/lib/img/card1.png`;
    const cvvImageUrl = `${window.location.origin}/lib/img/card1_arka.png`;

    function UyariGoster(mesajIlet) {
        $("#uyari-" + odeme).css("display", "block");
        $("#bilgi-" + odeme).css("display", "none");
        $("#basarili-" + odeme).css("display", "none");
        $("#uyari-" + odeme + " #mesaj").html(mesajIlet);
    }

    // Kart verilerini kontrol etmek için regexler
    var cardNumberRegex = /^(\d{4} ){3}\d{4}$/; // Örnek: 1236 2532 4569 1233
    var monthRegex = /^(0?[1-9]|1[0-2])$/; // Ay: 1-12
    var yearRegex = /^[2-9]\d{3}$/; // Yıl: 2000 ve sonrası
    var cvvRegex = /^\d{3}$/; // CVV: 3 rakam

    // Kart numarası girişi
    $("#cardNumber").on("input", function () {
        let cardNumber = $(this).val().replace(/\D/g, ""); // Sadece sayılar
        cardNumber = cardNumber.match(/.{1,4}/g)?.join(" ") || ""; // Her 4 hanede bir boşluk ekle
        $("#cardNumberDisplay").text(cardNumber || "**** **** **** ****");
        $(this).val(cardNumber); // Formatlı kart numarasını geri yaz
    });

    // Kart üzerindeki isim girişi
    $("#cardName").on("input", function () {
        const cardName = $(this).val();
        $("#cardNameDisplay").text(cardName || "NAME ON CARD");
    });

    // Ay (MM) ve Yıl (YY) girişi
    $("#expiryMonth, #expiryYear").on("input", function () {
        const month = $("#expiryMonth").val().padStart(2, '0'); // Ayın iki haneli olması sağlanır
        const year = $("#expiryYear").val().padStart(2, '0'); // Yılın iki haneli olması sağlanır
        $("#cardExpiryDisplay").text(`${month}/${year}`); // Ay ve yıl birleştirilir
    });

    // CVV alanına tıklanıldığında
    $("#cvv").focus(function () {
        $("#cardExpiryDisplay").hide();
        $("#cardNumberDisplay").hide();
        $("#cardNameDisplay").hide();

        $("#cvvDisplay").show(); // CVV'yi göster
        $("#cardImage").attr("src", cvvImageUrl); // CVV resmini göster
    });

    // CVV alanından çıkıldığında
    $("#cvv").blur(function () {
        $("#cardExpiryDisplay").show();
        $("#cardNumberDisplay").show();
        $("#cardNameDisplay").show();

        $("#cvvDisplay").hide(); // CVV'yi gizle
        $("#cardImage").attr("src", defaultCardImageUrl); // Varsayılan kart resmine dön
    });

    // CVV girişi
    $("#cvv").on("input", function () {
        const cvv = $(this).val().replace(/\D/g, ""); // Sadece sayılar
        $("#cvvDisplay").text(cvv || "***");
        $(this).val(cvv); // Formatlı CVV'yi geri yaz
    });

    // Doğrulama fonksiyonu
    function KartBilgileriniDogrula(cardNumber, expityMonth, expityYear, cvCode, cardOnName) {

        if (cardNumber == "" && expityMonth == "" && expityYear == "" && cvCode == "" && cardOnName == "") {
            UyariGoster("Boş Alan Bırakmayınız");
            return;
        }

        // Hata mesajları
        if (!cardNumberRegex.test(cardNumber)) {
            UyariGoster("Kart numarası 20 karakter olmalı ve her 4 hanede bir boşluk içermelidir (örn: 1234 5678 9012 3456 7890).");
            return false;
        }

        if (!monthRegex.test(expityMonth)) {
            UyariGoster("Ay bilgisi 1 ile 12 arasında bir sayı olmalıdır.");
            return false;
        }

        if (!yearRegex.test(expityYear)) {
            UyariGoster("Yıl bilgisi 2000 veya daha büyük bir 4 haneli sayı olmalıdır.");
            return false;
        }

        if (!cvvRegex.test(cvCode)) {
            UyariGoster("CVV bilgisi 3 haneli bir sayı olmalıdır.");
            return false;
        }

        if (!cardOnName) {
            UyariGoster("Kart üzerindeki isim boş bırakılamaz.");
            return false;
        }else{
            const nameRegex = /^[A-Za-zÇĞİÖŞÜçğıöşü\s]+$/;
                if (!nameRegex.test(cardOnName)) {
                UyariGoster("Lütfen Kart üzerindeki isimde yalnızca harf kullanın (rakam veya özel karakter girmeyin).");
                       return false;
            }
        }

        // Tüm kontroller başarılı
        console.log("Kart bilgileri doğru!");
        return true;
    }

    function OdemeAl() {
        const cardNumber = $("#cardNumber").val().trim();
        const expityMonth = $("#expiryMonth").val().trim();
        const expityYear = $("#expiryYear").val().trim();
        const cvCode = $("#cvv").val().trim();
        const cardOnName = $("#cardName").val().trim();

        var odemeFiyati = $("#odemeFiyati").val();

        var odemeFiyati = document.getElementById("odemeFiyati").innerHTML.toString().trim();

        // console.log(" odemeFiyati:" + odemeFiyati)

