@{
    ViewData["Title"] = "Ödeme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@using HerkesYazarOlsun.Portal.Controllers;

<style>
    .panel-title {
        display: inline;
        font-weight: bold;
    }

    .checkbox.pull-right {
        margin: 0;
    }

    .pl-ziro {
        padding-left: 0px;
    }
</style>



<input type="hidden" id="odemeicin" value="odeme" />
<input type="hidden" id="loginId" value="1" />
<input type="hidden" id="kitapId" value="1" />

@{
    string alertmesajgostermedurumu = "odeme";
}


<div style="height:75px;"></div>
<h1>Ödeme Sayfası</h1>
<div style="height:75px;"></div>

<div class="container" style="margin-bottom:50px;">
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        Ödeme Detayları
                    </h3>
                    @*<div class="checkbox pull-right">
                    <label>
                    <input type="checkbox" />
                    Remember
                    </label>
                    </div>*@
                </div>
                <div class="panel-body">
                    @*<form role="form">*@
                    <div class="form-group">
                        <label for="cardNumber">
                            Kard Numaranız
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="card_number" placeholder="Kart Numaranız" />
                            <span class="input-group-addon"><span class="fa fa-lock"></span></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="cardNumber">
                            Kard Üzerindeki İsim
                        </label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="cardOnName" name="cardOnName" placeholder="Kart Üzerindeki İsim" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-7 col-md-7">
                            <label for="expityMonth">
                                Son Kullanım Tarihi
                            </label>
                            <div class="form-group">

                                <div class="col-xs-6 col-lg-6 pl-ziro">
                                    <input type="number" class="form-control" id="expityMonth" name="expityMonth" placeholder="MM" />
                                </div>
                                <div class="col-xs-6 col-lg-6 pl-ziro">
                                    <input type="number" class="form-control" id="expityYear" name="expityYear" placeholder="YY" />
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-5 col-md-5 pull-right">
                            <div class="form-group">
                                <label for="cvCode">
                                    CVV
                                </label>
                                <input type="number" class="form-control" id="cvCode" name="cvCode" placeholder="CVV" />
                            </div>
                        </div>
                    </div>
                    @*</form>*@
                </div>
            </div>
            <ul class="nav nav-pills nav-stacked">
                <li class="active">
                    <a>
                        <span class="badge pull-right">
                            <span class="fa fa-turkish-lira" id="odemeFiyati">
                                4200
                            </span>
                            @*4200*@

                        </span> Toplam Ödeme
                    </a>
                </li>
            </ul>
            <br />
            @Html.Partial("_AlertMesaj",@alertmesajgostermedurumu)

            <a class="btn btn-success btn-lg btn-block" role="button" onclick="OdemeAl()">ÖDEME YAP</a>
            @*href="http://www.jquery2dotnet.com"*@
        </div>
    </div>
</div>

<script>


    var loginId = $("#loginId").val();
    var kitapId = $("#kitapId").val();

    var odeme = $("#odemeicin").val();


    function OdemeAl() {

        // window.location.href = "/OdemeSayfasi/SponsorlukBildirimi?kitapId=1&yazarId=1";

        var cardNumber = $("#card_number").val();
        var expityMonth = $("#expityMonth").val();
        var expityYear = $("#expityYear").val();
        var cvCode = $("#cvCode").val();
        var cardOnName = $("#cardOnName").val();
        var odemeFiyati = $("#odemeFiyati").val();

        var odemeFiyati = document.getElementById("odemeFiyati").innerHTML.toString().trim();

        console.log(" odemeFiyati:" + odemeFiyati)

        console.log(" cardNumber: " + cardNumber + " expityMonth: " + expityMonth + " expityYear: " + expityYear + " cvCode: " + cvCode + " cardOnName: " + cardOnName);

        if (cardNumber == "" && expityMonth == "" && expityYear == "" && cvCode == "" && cardOnName == "") {
            $("#uyari-" + odeme).css("display", "block");
            $("#bilgi-" + odeme).css("display", "none");
            $("#basarili-" + odeme).css("display", "none");
            $("#uyari-" + odeme + " #mesaj").html("Boş Alan Bırakmayınız");
            return;
        }

        // input verileri alınmadı kontrol eylersin

        $.post("@Url.Action(nameof(OdemeSayfasiController.SaveOdeme), "OdemeSayfasi")", {
            "KartTarihiAy": expityMonth,
            "KartTarihiYil": expityYear,
            "KartUzerindekiIsim": cardOnName,
            "Cvv": cvCode,
            "KartNo": cardNumber,
            "LoginUserId": loginId,
            "KitapId": kitapId,
            "Tutar": odemeFiyati

        }, function (data) {
            console.log(data);
            if (data.state == 1) {
                $("#basarili-" + odeme).css("display", "block");
                $("#basarili-" + odeme + " #mesaj").html(data.message + " Sponsorluk Bildirimi için Yönlendiriliyorsunuz. ");

                $("#bilgi-" + odeme).css("display", "none");
                $("#uyari-" + odeme).css("display", "none");

                setTimeout(function () {
                    //kitapId şifreli şekilde gidecek
                    //yazarId şifreli şekilde gidebilir
                    //md5 ile şifrelenebilir. çözülebilir. Giriş yaptıktan sonra bu kısma odaklan
                    window.location.href = "/OdemeSayfasi/SponsorlukBildirimi?kitapId=1&yazarId=1";
                }, 5000);
            }
            else if (data.state == 3) {
                $("#bilgi-" + odeme).css("display", "block");
                $("#bilgi-" + odeme + " #mesaj").html(data.message);

                $("#basarili-" + odeme).css("display", "none");
                $("#uyari-" + odeme).css("display", "none");
            }
            else {
                $("#uyari-" + odeme).css("display", "block");
                $("#bilgi-" + odeme).css("display", "none");
                $("#basarili-" + odeme).css("display", "none");
                $("#uyari-" + odeme + " #mesaj").html(data.message);
            }

        });


    }
</script>