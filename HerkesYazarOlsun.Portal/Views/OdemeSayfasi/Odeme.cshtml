                        window.location.href = "/OdemeSayfasi/SponsorlukBildirimi?kitapId=" + kitapId + "&yazarId=" + loginUserId + "";
                    }, 5000);

            // $.post("@Url.Action(nameof(OdemeSayfasiController.SaveOdeme), "OdemeSayfasi")", {
            //     "KartTarihiAy": expityMonth,
            //     "KartTarihiYil": expityYear,
            //     "KartUzerindekiIsim": cardOnName,
            //     "Cvv": cvCode,
            //     "KartNo": cardNumber,
            //     "LoginUserId": loginUserId,
            //     "KitapId": kitapId,
            //     "Tutar": odemeFiyati

            // }, function (data) {
            //     console.log(data);
            //     if (data.state == 1) {
            //         $("#basarili-" + odeme).css("display", "block");
            //         $("#basarili-" + odeme + " #mesaj").html(data.message + " Sponsorluk Bildirimi için Yönlendiriliyorsunuz. ");

            //         $("#bilgi-" + odeme).css("display", "none");
            //         $("#uyari-" + odeme).css("display", "none");

            //         setTimeout(function () {
            //             window.location.href = "/OdemeSayfasi/SponsorlukBildirimi?kitapId=" + kitapId + "&yazarId=" + loginUserId + "";
            //         }, 5000);
            //     }
            //     else if (data.state == 3) {
            //         $("#bilgi-" + odeme).css("display", "block");
            //         $("#bilgi-" + odeme + " #mesaj").html(data.message);

            //         $("#basarili-" + odeme).css("display", "none");
            //         $("#uyari-" + odeme).css("display", "none");
            //     }
            //     else {
            //         $("#uyari-" + odeme).css("display", "block");
            //         $("#bilgi-" + odeme).css("display", "none");
            //         $("#basarili-" + odeme).css("display", "none");
            //         $("#uyari-" + odeme + " #mesaj").html(data.message);
            //     }

            // });

        }


    }

</script>