@using HerkesYazarOlsun.Portal.Controllers
@using System.Text.RegularExpressions
@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL

@{
    string tip = "ilgilisayfaguncelle";
}
<input type="hidden" id="tip" value="@tip" />
 
<div id="container">
    <nav>
        <ul>
            <li><a id='first' href="#">First page</a></li>
            <li><a id='back' href="#">Back</a></li>
            <li><a id='next' href="#">Next</a></li>
            <li><a id='last' href="#">Last page</a></li>
            <li><a id='zoomin' href="#">Zoom In</a></li>
            <li><a id='zoomout' href="#">Zoom Out</a></li>
            <li><a id='slideshow' href="#">Slide Show</a></li>
            <li><a id='flipsound' href="#">Flip sound</a></li>
            <li><a id='fullscreen' href="#">Fullscreen</a></li>
            <li><a id='thumbs' href="#">Thumbs</a></li>
            <li>
                <img src="@Url.Content("~/wowbook/images/switch.png")"
                     alt="Çıkış"
                     style="width:45px; height:45px; cursor:pointer;"
                     onclick="window.location.href='/Kitaplar/KitapDetay?kitap_id=@ViewBag.KITAPENC';" />
            </li>
        </ul>
    </nav>
    <input type="hidden" id="guncellenecekSayfaId" />
    <div id="main">
        
        <div id='features'>
            
            <div>
                <img src="https://herkesyazarolsun.com.tr/Belgeler/@(ViewBag.VM_KITAP.ONKAPAKFOTOPATH)" alt="Sayfa resmi" width="100%" height="100%" />
            </div>

            <!-- Gizli audio -->
            <audio id="flipSound" style="display:none">
                <source src="@Url.Content("~/wowbook/sound/page-flip.mp3")" type="audio/mpeg" />
            </audio>
            <h1>
                <p style="font-size:40px;text-align:center;color:white">Önsöz</p>
                <p style="font-size:20px;">@Html.Raw(Model.BookModel.ONSOZ)</p>
            </h1>

            @foreach (var item in @Model.BookModel.BooksPageList)
            {
                var temizHtml = Regex.Replace(item.PageWrite, "<img[^>]*>", "", RegexOptions.IgnoreCase);
                <div style="overflow:auto; overflow-x:hidden; text-align:justify; padding-right:15px">
                    @if (Model.IsWowBookEdit)
                    {
                        <button class="btn btn-warning" onclick="KitabiGuncelle('@item.ID')">
                            Sayfayı Güncelle
                        </button>
                    }

                    <div class='feature pagefx hardpage' style="width:350px">
                        <p style="font-size:12px;">@Html.Raw(temizHtml) </p>
                        @* @item.PageWrite *@
                    </div>
                </div>
            }

            <div>
                <img src="~/wowbook/images/cover_last.png" alt="Arka Kapak" width="100%" height="100%" />
            </div>

            <div class='feature hardpage'>
                <img src="https://herkesyazarolsun.com.tr/Belgeler/@(ViewBag.VM_KITAP.ARKAKAPAKFOTOPATH)" alt="Arka Kapak" width="100%" height="100%" />
            </div>
        </div>

    </div>
</div>
<div style="height:20px"></div>
@Html.Partial("_AlertMesaj", @tip)

<!-- Popup div -->
<div id="guncelle" style="
    display:none; position: fixed;top: 50%;left: 50%;transform: translate(-50%, -50%);
    width: 600px;       /* popup genişliği */
    max-width: 90%;     /* responsive */
    max-height: 80vh;   /* ekranın %80'i kadar yükseklik */
    overflow-y: auto;   /* taşarsa scroll */
    background-color: #fff;    border: 2px solid #333;
    border-radius: 8px; padding: 20px;z-index: 9999; box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
    <div class="row">
        <div class="col-md-12">
            <h4>Sayfa Güncelle</h4>
            <br />
            @* <div id="sayfaYaiziyAl" style="height:300px; overflow-y:auto; border:1px solid #ccc; padding:10px;"></div> *@
            <div id="sayfaYaiziyAlEditor" style="height: 400px;"></div>

            <textarea id="sayfaYaiziyAl" name="SAYFAYAZI" hidden></textarea>
        </div>
    </div>
    <div style="text-align:right; margin-top:10px;">
        <button class="btn btn-warning" onclick="Guncelle()">
            Güncelle
        </button>
        <button class="btn btn-info" onclick="KapatGuncelle()">Kapat</button>
    </div>
    
   
</div>

<!-- Progress overlay -->
<div id="progressOverlay" style="
    display:none;
    position:fixed;
    top:0; left:0;
    width:100%; height:100%;
    background: rgba(0,0,0,0.3);
    z-index: 99999;
    text-align:center;
">
    <div style="
        position:absolute;
        top:50%; left:50%;
        transform:translate(-50%, -50%);
        color:white;
        font-size:18px;
    ">
        Güncelleniyor... Lütfen bekleyin
    </div>
</div>



<script>
        document.addEventListener('DOMContentLoaded', function () {

            if (typeof Quill === 'undefined') {
            console.error('Quill yüklü değil! CDN/Script include kontrol et.');
            return;
            }

            window.quill = window.quill || new Quill('#sayfaYaiziyAlEditor', {
            theme: 'snow',
            placeholder: 'Sayfanızı buraya yazın...',
            modules: {
                toolbar: [
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                ['link', 'image'],
                [{ 'align': [] }],
                ['clean']
                ]
            }
            });


        const hiddenTextarea = document.getElementById('sayfaYaiziyAl');

        if (!hiddenTextarea) {
            console.error('Textarea #sayfaYaiziyAl bulunamadı!');
            return;
        }
        window.quill.on('text-change', () => { hiddenTextarea.value = window.quill.root.innerHTML; });
        // Form gönderiminde içeriği textarea’ya aktar
        /*document.querySelector('form')?.addEventListener('submit', function () {
            document.getElementById('sayfaYaiziyAl').value = quill.root.innerHTML;
        });*/

    });
</script>


<script>
    window.bookPagesData = {};
    @foreach (var item in Model.BookModel.BooksPageList)
    {
        <text>
            window.bookPagesData["@item.ID"] = @Html.Raw(Json.Serialize(item.PageWrite));
        </text>
    }
</script>

<script type="text/javascript">

    function KitabiGuncelle(id) { 
        $("#guncelle").css("display", "block");
        $("#guncellenecekSayfaId").val(id);

        var sayfaIcerik = window.bookPagesData[id] || "";

        // Quill editöre yükle
        if (window.quill) {
            window.quill.root.innerHTML = sayfaIcerik;
            document.getElementById('sayfaYaiziyAl').value = sayfaIcerik;
        } else {
            console.error("Quill yüklenmedi!");
        }
     
        // Eğer hidden textarea’ya da ekleyeceksen
        document.getElementById('sayfaYaiziyAl').value = sayfaIcerik;


    }

    function AcGuncelle() {
        document.getElementById('guncelle').style.display = 'block';
    }

    function KapatGuncelle() {
        document.getElementById('guncelle').style.display = 'none';
    }

         function Guncelle() {
           var id = $("#guncellenecekSayfaId").val();        // hidden input’tan al
           if(!id) { console.error("Sayfa ID yok!"); return; }

            var kitapSayfaYazi = $("#sayfaYaiziyAl").val();  // Quill’in içeriği

            console.log("kitapSayfaYazi:", kitapSayfaYazi, "id:", id);

            var tip = $("#tip").val();
            console.log("tip" ,tip );

            // Progress overlay göster
             $("#progressOverlay").show();
                setTimeout(function() {  }, 3000);

                 $.post("@Url.Action(nameof(KitaplarController.PostBooksPageUpdate), "Kitaplar")", { 
                     "ID": id, "PageWrite": kitapSayfaYazi,
                      "PageWriteBase64":"PageWriteBase64",
                      "PageFoto":"PageFoto"
                 },
                function (data) {
                    $("#progressOverlay").hide(); // işlemin sonunda gizle

                    if (data.state == 1) {
                        $("#basarili-" + tip).css("display", "block");
                        $("#basarili-" + tip + " #mesaj").html("Güncellendi");

                        $("#bilgi-" + tip).css("display", "none");
                        $("#uyari-" + tip).css("display", "none");

                        setTimeout(function () {
                            var link = window.location.href;

                            window.location.href = link;
                            console.log("link " + link);

                            window.location.reload()

                        }, 3000);
                    }
                    else if (data.state == 3) {
                        $("#bilgi-" + tip).css("display", "block");
                        $("#bilgi-" + tip + " #mesaj").html("Güncellenemedi");

                        $("#basarili-" + tip).css("display", "none");
                        $("#uyari-" + tip).css("display", "none");
                    }
                    else {
                        $("#uyari-" + tip).css("display", "block");
                        $("#bilgi-" + tip).css("display", "none");
                        $("#basarili-" + tip).css("display", "none");
                        $("#uyari-" + tip + " #mesaj").html("Güncellenemedi");
                    }

                }).fail(function(){
                        $("#progressOverlay").hide();
                        alert("Sunucu hatası! Lütfen tekrar deneyin.");
                    });
   
        }

</script>