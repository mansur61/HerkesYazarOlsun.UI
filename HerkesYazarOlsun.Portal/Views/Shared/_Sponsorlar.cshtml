@using HerkesYazarOlsun.Model.ViewModel

<style>
    .sponsor-box {
        border: 2px solid #007bff; /* Mavi çerçeve */
        border-radius: 12px; /* Kenarları yuvarlat */
        padding: 10px; /* İç boşluk */
        text-align: center; /* Metni ortala */
        margin: 5px;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1); /* Hafif gölge */
    }
</style>

@if (@ViewBag.Sponsorlar != null && @ViewBag.Sponsorlar.Count > 0)
{
    <div class="section-colored" id="sponsorlar">
        <div class="container">
            <h3 class="section-title text-center">Sponsorlarımız</h3>


            <div class="container clients">
                <div class="row">

                    @foreach (var item in ViewBag.Sponsorlar)
                    {
                        var spnstem = item as VM_SPONSORLAR;
                         
                            <div class="col-lg-2 col-md-2 col-sm-2 col-xs-6 sponsor-box">
                                <a href="#"><img class="img-responsive" src= "../../wwwroot/lib/img/tilkikitap.png" alt="TilkiKitap"></a>
                                <p>@spnstem?.SponsorAdi</p>
                            </div>
                         
                       
                         
                    } 
                </div><!-- /.row -->

            </div><!-- /.container -->

        </div><!-- /.container -->

    </div>

    <!-- /.section-colored -->
}
