                <a href="#"><img class="img-responsive" src="~/lib/img/client-3.png" alt="client 3"></a>
                </div>

                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-6">
                <a href="#"><img class="img-responsive" src="~/lib/img/client-4.png" alt="client 4"></a>
                </div>

                <div class="col-lg-2 col-md-2 col-sm-2 col-xs-6">
