<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    $(document).ready(function () {
        var ctx = $('#istatistikChart')[0].getContext('2d');
         
        var istatistik = @Html.Raw(Json.Serialize(Model.BookModel.iSTATISTIK));
        var yayinAyar = @Html.Raw(Json.Serialize(ViewBag.YayinAyar));
        
        // Eğer yayın ayar boşsa modelden al
        if (!yayinAyar || Object.keys(yayinAyar).length === 0) {
            yayinAyar = @Html.Raw(Json.Serialize(Model?.BookModel?.Categori?.CategoryYayinAyarlari));
             console.log(" CategoryCategriAyarlari yayinAyar:", yayinAyar);
        }

        console.log("istatistik:", istatistik);
        console.log("yayinAyar:", yayinAyar);

        // Oranları hesapla, tüm oranlar 0 ise 0 olarak kalır
        function hesaplaOran(deger, toplam) { 
             var oran = (toplam && toplam !== 0) ? (deger / toplam * 100) : 0; 
            return isNaN(oran) ? 0 : toplam;
        }
        console.log("yayinAyar?.toplamYildiz  ",yayinAyar?.toplamYildiz );

        var toplamYildizOran = hesaplaOran(yayinAyar?.toplamYildiz ?? 0, istatistik.toplamYildiz);
        var toplamBegeniOran = hesaplaOran(yayinAyar?.toplamBegeni ?? 0, istatistik.toplamBegeni);
        var toplamYorumOran = hesaplaOran(yayinAyar?.toplamYorum ?? 0, istatistik.toplamYorum);
        var toplamDegerlendirmeOran = hesaplaOran(yayinAyar?.toplamDegerlendirme ?? 0, istatistik.toplamDegerlendirme);

         
        // Eğer tüm oranlar 0 ise, yazı göster
        if (toplamYildizOran === 0 && toplamBegeniOran === 0 && toplamYorumOran === 0 && toplamDegerlendirmeOran === 0) {
            
            $('#istatistikChart').hide();  // Grafik alanını gizle
            $('#noDataMessage').show();    // Yazıyı göster
        } else {
            // Oranlar sıfır değilse grafiği oluştur
            var data = {
                labels: ['Toplam Yıldız', 'Toplam Beğeni', 'Toplam Yorum', 'Toplam Değerlendirme'],
                datasets: [{
                    data: [toplamYildizOran, toplamBegeniOran, toplamYorumOran, toplamDegerlendirmeOran],
                    backgroundColor: ['#3498db', '#2ecc71', '#f1c40f', "#E9967A"],
                    borderColor: ['#2980b9', '#27ae60', '#f39c12', "#E9967A"],
                    borderWidth: 1
                }]
            };

            var options = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom'
                    }
                }
            };

            new Chart(ctx, {
                type: 'doughnut',
                data: data,
                options: options
            });
        }
    });
</script>

<script>
    var kId = '@StringCipher.Encrypt(ViewBag.KITAPENC.ToString())';
    //console.log("kId: "+kId);
    var yildizPuani = 0; 

    function Bilgilendirme(mesaj) {

        var name = $("#name").val();
        var email = $("#email").val();
        var message = $("#message").val();

        var yorum = "(@Model.BookModel.ID - @Model.BookModel.Name) adlı kitabınıza " + email + " adlı kullanıcı yorum yaptı. Yorumu;";
        $.post("@Url.Action(nameof(EmailController.MailBilgilendirme), "Email")", {
            "konu": "Herkes Yazar Olsun'dan Kitabınıza Yorum Geldi",
            "kime": email,
            "tip": 0,
            "mesaj": yorum + "  " + mesaj,


        }, function (data) {
            console.log("data:" + data.state);
            if (data.state == 1) {
                $("#basarili-" + yorumicin).css("display", "block");
                $("#basarili-" + yorumicin + " #mesaj").html(data.message);

                $("#bilgi-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");


            }
            else if (data.state == 3) {
                $("#bilgi-" + yorumicin).css("display", "block");
                $("#bilgi-" + yorumicin + " #mesaj").html(data.message);

                $("#basarili-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");
            }
            else {
                $("#uyari-" + yorumicin).css("display", "block");
                $("#bilgi-" + yorumicin).css("display", "none");
                $("#basarili-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin + " #mesaj").html(data.message);
            }

        });
    }


    function YorumYap() {

        var kural = $('#kural').text().trim();
        console.log("kural:" + kural);

        var name = $("#name").val();
        var email = $("#email").val();
        var message = $("#message").val();
        var kitapId = $("#kitapId").val();
        var yorumicin = $("#yorummesajiicin").val();

        console.log("ad:" + name + " email:" + email + " aciklama:" + message);

        if (ad == "" || email == "" || message == "") {
            $("#uyari-" + yorumicin).css("display", "block");
            $("#bilgi-" + yorumicin).css("display", "none");
            $("#basarili-" + yorumicin).css("display", "none");
            $("#uyari-" + yorumicin + " #mesaj").html("Tüm alanları doldurunuz");
            return;
        }

        $.post("@Url.Action(nameof(KitaplarController.PostBooksComments), "Kitaplar")", {
            "NAME": name,
            "EMAIL": email,
            "BookId": kitapId,
            "ACIKLAMA": message,


        }, function (data) {
            console.log("data:" + data.state);
            if (data.state == 1) {
                $("#basarili-" + yorumicin).css("display", "block");
                $("#basarili-" + yorumicin + " #mesaj").html(data.message);

                $("#bilgi-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");

                if (kural === "True") {
                    Bilgilendirme("Kitap yorumu aktif!");
                }
                 setTimeout(function () {                    
                    window.location.href = "/Kitaplar/KitapDetay?kitap_id=" + kId.toString();

                }, 3000);
            }
            else if (data.state == 3) {
                $("#bilgi-" + yorumicin).css("display", "block");
                $("#bilgi-" + yorumicin + " #mesaj").html(data.message);

                $("#basarili-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");
            }
            else {
                $("#uyari-" + yorumicin).css("display", "block");
                $("#bilgi-" + yorumicin).css("display", "none");
                $("#basarili-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin + " #mesaj").html(data.message);
            }

        });
    }

    function Degerlendir() {
        console.log("geldi.");
        var ad = $("#ad").val();
        var email = $("#mail").val();
        var konu = $("#konu").val();
        var aciklama = $("#aciklamagir").val();
        var kitapId = $("#kitapId").val();
        var degerlendirme = $("#degerlendirmemesaicin").val();

        console.log("ad:" + ad + " email:" + email + " konu:" + konu + " aciklama:" + aciklama);

        if (yildizPuani == 0) {
            $("#uyari-" + degerlendirme).css("display", "block");
            $("#bilgi-" + degerlendirme).css("display", "none");
            $("#basarili-" + degerlendirme).css("display", "none");
            $("#uyari-" + degerlendirme + " #mesaj").html("Yıldız veriniz.");
            return;
        }

        if (ad == "" || email == "" || konu == "" || aciklama == "") {
            $("#uyari-" + degerlendirme).css("display", "block");
            $("#bilgi-" + degerlendirme).css("display", "none");
            $("#basarili-" + degerlendirme).css("display", "none");
            $("#uyari-degerlendirme #mesaj").html("Tüm alanları doldurunuz");
            return;
        }

        $.post("@Url.Action(nameof(KitaplarController.PostBooksDegerlendirme), "Kitaplar")", {
            "NAME": ad,
            "EMAIL": email,
            "KONU": konu,
            "BookId": kitapId,
            "ACIKLAMA": aciklama,
            "StarPuani": yildizPuani

        }, function (data) {
            console.log("data state:" + data.state);
            if (data.state == 1) {
                $("#basarili-" + degerlendirme).css("display", "block");
                $("#basarili-" + degerlendirme + " #mesaj").html(data.message);

                $("#bilgi-" + degerlendirme).css("display", "none");
                $("#uyari-" + degerlendirme).css("display", "none");

                // setTimeout(function () {
                //     window.location.href = window.location.href;
                // }, 3000);
                 setTimeout(function () {
                    window.location.href = "/Kitaplar/KitapDetay?kitap_id=" + kId.toString();

                }, 3000);

            }
            else if (data.state == 3) {
                $("#bilgi-" + degerlendirme).css("display", "block");
                $("#bilgi-" + degerlendirme + " #mesaj").html(data.message);

                $("#basarili-" + degerlendirme).css("display", "none");
                $("#uyari-" + degerlendirme).css("display", "none");
            }
            else {
                $("#uyari-" + degerlendirme).css("display", "block");
                $("#bilgi-" + degerlendirme).css("display", "none");
                $("#basarili-" + degerlendirme).css("display", "none");
                $("#uyari-" + degerlendirme + " #mesaj").html(data.message);
            }

        });
    }

    var yildizlar = document.getElementsByClassName("yildizver");

    function YildizVer(adet) {

        yildizPuani = adet;
        console.log("adet:" + adet + " yildizlar.length :" + yildizlar.length);

        for (var i = 0; i < yildizlar.length; i++) {
            $(yildizlar[i]).css("color", "gray");
        }

        for (var i = 0; i < adet; i++) {
            $(yildizlar[i]).css("color", "dodgerblue");
        }
    }

    function YildizIptalEt(adet) {

        yildizPuani = adet;
        console.log("adet:" + adet);
        for (var i = 0; i < yildizlar.length; i++) {
            $(yildizlar[i]).css("color", "gray");
        }
    }


</script>