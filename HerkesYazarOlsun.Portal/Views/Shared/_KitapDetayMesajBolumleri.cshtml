<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    let myChart = null;

    function createChart() {

        if (myChart) return; // tekrar oluşturma

        const canvas = document.getElementById('istatistikChart');
        if (!canvas) return;

        const ctx = canvas.getContext('2d');

        const istatistik = @Html.Raw(Json.Serialize(Model.BookModel.iSTATISTIK));
        let yayinAyar = @Html.Raw(Json.Serialize(ViewBag.YayinAyar));

        if (!yayinAyar || Object.keys(yayinAyar).length === 0) {
            yayinAyar = @Html.Raw(Json.Serialize(Model?.BookModel?.Categori?.CategoryYayinAyarlari));
        }

        function hesaplaOran(mevcut, gerekli) {
            if (!gerekli || gerekli === 0) return 0;
            return Math.round((mevcut / gerekli) * 100);
        }

        const dataValues = [
            hesaplaOran(istatistik.toplamYildiz, yayinAyar?.toplamYildiz),
            hesaplaOran(istatistik.toplamBegeni, yayinAyar?.toplamBegeni),
            hesaplaOran(istatistik.toplamYorum, yayinAyar?.toplamYorum),
            hesaplaOran(istatistik.toplamDegerlendirme, yayinAyar?.toplamDegerlendirme)
        ];

        if (dataValues.every(v => v === 0)) {
            canvas.style.display = "none";
            document.getElementById("noDataMessage").style.display = "block";
            return;
        }

        myChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: [
                    'Toplam Yıldız',
                    'Toplam Beğeni',
                    'Toplam Yorum',
                    'Toplam Değerlendirme'
                ],
                datasets: [{
                    data: dataValues,
                    backgroundColor: ['#0d6efd', '#198754', '#ffc107', '#fd7e14']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    }

    // 🔥 İstatistik tab açılınca chart oluştur
    document
        .getElementById('istatistik-tab')
        .addEventListener('shown.bs.tab', createChart);
</script>

 

<script>
    var kId = '@StringCipher.Encrypt(ViewBag.KITAPENC.ToString())';
    //console.log("kId: "+kId);
    var yildizPuani = 0; 

    function Bilgilendirme(mesaj) {

        var name = $("#name").val();
        var email = $("#email").val();
        var message = $("#message").val();

        var yorum = "(@Model.BookModel.ID - @Model.BookModel.Name) adlı kitabınıza " + email + " adlı kullanıcı yorum yaptı. Yorumu;";
        $.post("@Url.Action(nameof(EmailController.MailBilgilendirme), "Email")", {
            "konu": "Herkes Yazar Olsun'dan Kitabınıza Yorum Geldi",
            "kime": email,
            "tip": 0,
            "mesaj": yorum + "  " + mesaj,


        }, function (data) {
            console.log("data:" + data.state);
            if (data.state == 1) {
                $("#basarili-" + yorumicin).css("display", "block");
                $("#basarili-" + yorumicin + " #mesaj").html(data.message);

                $("#bilgi-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");


            }
            else if (data.state == 3) {
                $("#bilgi-" + yorumicin).css("display", "block");
                $("#bilgi-" + yorumicin + " #mesaj").html(data.message);

                $("#basarili-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");
            }
            else {
                $("#uyari-" + yorumicin).css("display", "block");
                $("#bilgi-" + yorumicin).css("display", "none");
                $("#basarili-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin + " #mesaj").html(data.message);
            }

        });
    }


    function YorumYap() {

