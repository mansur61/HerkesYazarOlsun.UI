            console.log("data:" + data.state);
            if (data.state == 1) {
                $("#basarili-" + yorumicin).css("display", "block");
                $("#basarili-" + yorumicin + " #mesaj").html(data.message);

                $("#bilgi-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");

