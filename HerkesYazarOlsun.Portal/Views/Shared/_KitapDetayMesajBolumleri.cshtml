@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAY;
@using HerkesYazarOlsun.Portal.Controllers;

<style>
    .product_description_area .tab-content .total_rate .box_total {
        background: #f1f6f7;
        text-align: center;
        padding-top: 20px;
        padding-bottom: 20px
    }

        .product_description_area .tab-content .total_rate .box_total h4 {
            font-size: 48px;
            font-weight: bold;
            color: #384aeb
        }

        .product_description_area .tab-content .total_rate .box_total h5 {
            color: #333333;
            margin-bottom: 0px;
            font-size: 24px
        }

        .product_description_area .tab-content .total_rate .box_total h6 {
            font-family: "Roboto",sans-serif;
            margin-bottom: 0px;
            font-size: 14px;
            color: #555555;
            font-weight: normal
        }

    /*.price-text-color {
                                                        color:dodgerblue;
                                                    }*/

</style>

<input type="hidden" id="kitapId" name="kitapId" value="@Model.Vm_Book.ID" />
<input type="hidden" id="degerlendirmemesaicin" value="degerlendirme" />
<input type="hidden" id="yorummesajiicin" value="yorumicin" />


@{
    string alertmesajgostermedurumu = "";

}

@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}

@*<div style="height:30px"></div>*@
<section class="product_description_area">
    <div class="container">


        <ul class="nav nav-tabs" id="myTab" role="tablist">

            <li class="nav-item ">
                <a class="nav-link active" id="aciklama-tab" data-toggle="tab" href="#aciklama" role="tab" aria-controls="aciklama" aria-selected="false">Açıklama</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="ozellikler-tab" data-toggle="tab" href="#ozellikler" role="tab" aria-controls="ozellikler"
                   aria-selected="false">Kitap Özellikleri</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="yorumlar-tab" data-toggle="tab" href="#yorumlar" role="tab" aria-controls="yorumlar"
                   aria-selected="false">Yorumlar</a>
            </li>
            <li class="nav-item">
                <a class="nav-link " id="degerlendirme-tab" data-toggle="tab" href="#degerlendirme" role="tab" aria-controls="degerlendirme"
                   aria-selected="false">Değerlendirmeler</a>
            </li>


        </ul>


        <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade show active" id="aciklama" role="tabpanel" aria-labelledby="aciklama-tab">
                <p>
                    @Model.Vm_Book.ARKAKAPAKYAZISI
                </p>

            </div>
            <div class="tab-pane fade" id="ozellikler" role="tabpanel" aria-labelledby="ozellikler-tab">
                <div class="table-responsive">
                    <table class="table">
                        <tbody>

                            <tr>
                                <td>
                                    <h5>Genişlik</h5>
                                </td>
                                <td>
                                    <h5>128mm</h5>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <h5>Yükseklik</h5>
                                </td>
                                <td>
                                    <h5>508mm</h5>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <h5>Sayfa Sayısı</h5>
                                </td>
                                <td>
                                    <h5>10</h5>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <h5>Konusu</h5>
                                </td>
                                <td>
                                    <h5>Hikaye</h5>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
            <div class="tab-pane fade" id="yorumlar" role="tabpanel" aria-labelledby="yorumlar-tab">
                <div class="row">
                    <div class="col-lg-6">
                        <div style="height:30px">
                            <h3><strong>Yorumlar</strong></h3>
                        </div>
                        @foreach (var item in @Model.Vm_Book_Comments)
                        {
                            <div class="comment_list">
                                <div class="review_item">
                                    <div class="media">
                                        <div class="d-flex">
                                            @*<img src="~/vendors/img/product/review-1.png" alt="">*@
                                        </div>
                                        <div class="media-body">
                                            <h4>@item.NAME</h4>
                                            <h5>@item.CREATE_AT</h5>
                                            @*<a class="reply_btn" href="#">Reply</a>*@
                                        </div>
                                    </div>
                                    <p>
                                        @item.ACIKLAMA
                                    </p>
                                </div>
                            </div>
                        }

                    </div>
                    <div class="col-lg-6">
                        @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
                        {
                            <div class="review_box">
                                <h4>Yorum Yaz</h4>
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="name" name="name" placeholder="Adınızı giriniz">
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <input type="text" class="form-control" id="email" name="email" placeholder="Mail adresiniz">
                                    </div>
                                </div>

                                <div class="col-md-12">
                                    <div class="form-group">
                                        <textarea class="form-control" type="text" id="message" name="message" rows="1" placeholder="Mesajınız"></textarea>
                                    </div>
                                </div>
                                @{
                                    alertmesajgostermedurumu = "yorumicin";
                                }
                                @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)

                                <div class="col-md-12 text-right">
                                    <button onclick="YorumYap()" class="btn primary-btn">Gönder</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="review_box">
                                <h4>Gözlemci Modunda Yorum Yapamazsınız.</h4>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="tab-pane fade " id="degerlendirme" role="tabpanel" aria-labelledby="degerlendirme-tab">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="row total_rate">
                            <div class="col-6">
                                <div class="box_total">
                                    <h5>En fazla Yıldız</h5>

                                    @{
                                        Model.Stars.isToplam = false;
                                    }

                                    <h4>@Html.Partial("_YildizGoster", @Model.Stars)</h4>


                                    <h6><strong>(@Model.Stars.EnFazlaSitar)</strong></h6>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="rating_list">
                                    <h3>Kitaba ait yıldızlar</h3>
                                    @{
                                        Model.Stars.isToplam = true;
                                    }

                                    <div class="col-sm-7">
                                        @Html.Partial("_YildizGoster", @Model.Stars)

                                    </div>

                                </div>
                            </div>
                        </div>

                        <div style="height:30px">
                            <h3><strong>Değerlendimeler</strong></h3>
                        </div>
                        @foreach (var item in @Model.Vm_Book_Degerlendirme_List)
                        {
                            <div class="review_list">
                                <div class="review_item">
                                    <div class="media">
                                        <div class="d-flex">
                                            @*<img src="~/vendors/img/product/review-1.png" alt="">*@
                                        </div>
                                        <div class="media-body">
                                            <h4>@item.NAME</h4>

                                            @for (int i = 0; i < @item.StarPuani; i++)
                                            {
                                                <i class="price-text-color fa fa-star"> </i>
                                            }


                                        </div>
                                    </div>
                                    <p>
                                        @item.ACIKLAMA
                                    </p>
                                </div>
                            </div>
                        }

                    </div>
                    <div class="col-lg-6">
                        @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
                        {
                            <div class="review_box">
                                <h4>Kitabı Değerlendiriniz</h4>
                                @*Yıldız:*@
                                <div class="col-sm-12">
                                    <h3>
                                        <i class="yildizver fa fa-star" onclick="YildizVer(1)"> </i>
                                        <i class="yildizver fa fa-star" onclick="YildizVer(2)"> </i>
                                        <i class="yildizver fa fa-star" onclick="YildizVer(3)"> </i>
                                        <i class="yildizver fa fa-star" onclick="YildizVer(4)"> </i>
                                        <i class="yildizver fa fa-star" onclick="YildizVer(5)"> </i>
                                    </h3>
                                </div>
                                <button type="button" class="btn btn-error" onclick="YildizIptalEt(0)">
                                    Verilen Yıldızı İptal Et
                                </button>
                                <div style="height:10px;margin:10px 2px;">
                                    <p>Değerlendime giriniz</p>
                                </div>
                                <br />
                                <div style="height:auto;margin:10px 2px;">
                                    <div style="height:50px;"></div>
                                    <div class="form-group">
                                        <input class="form-control" id="ad" type="text" placeholder="Adınız" required>

                                    </div>
                                    <div class="form-group">
                                        <input class="form-control" id="mail" type="text" placeholder="Mail adresiniz" required>
                                    </div>
                                    <div class="form-group">
                                        <input class="form-control" id="konu" type="text" placeholder="Konu giriniz">
                                    </div>
                                    <div class="form-group">
                                        <textarea class="form-control different-control w-100" type="text" id="aciklamagir" cols="30" rows="5" placeholder="Değerlendirmenizi giriniz"></textarea>
                                    </div>

                                    @{
                                        alertmesajgostermedurumu = "degerlendirme";

                                    }
                                    @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)


                                    <button type="button" class="btn btn-success" onclick="Degerlendir()">Değerlendir</button>
                                </div>
                            </div>

                        }
                        else
                        {
                            <div class="review_box"> </div>
                            <h4>Kitabı Değerlendirmek için Gözlemci Mod ile giriş yapmayınız</h4>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<script>

    var yildizPuani = 0;

    function YorumYap() {

        console.log("geldi.");
        var name = $("#name").val();
        var email = $("#email").val();
        var message = $("#message").val();

        var kitapId = $("#kitapId").val();
        var yorumicin = $("#yorummesajiicin").val();

        console.log("ad:" + name + " email:" + email + " aciklama:" + message);

        if (ad == "" || email == "" || message == "") {
            $("#uyari-" + yorumicin).css("display", "block");
            $("#bilgi-" + yorumicin).css("display", "none");
            $("#basarili-" + yorumicin).css("display", "none");
            $("#uyari-" + yorumicin + " #mesaj").html("Tüm alanları doldurunuz");
            return;
        }

        $.post("@Url.Action(nameof(KitaplarController.PostBooksComments), "Kitaplar")", {
            "NAME": name,
            "EMAIL": email,
            "BookId": kitapId,
            "ACIKLAMA": message,


        }, function (data) {
            console.log("data:" + data.state);
            if (data.state == 1) {
                $("#basarili-" + yorumicin).css("display", "block");
                $("#basarili-" + yorumicin + " #mesaj").html(data.message);

                $("#bilgi-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");
            }
            else if (data.state == 3) {
                $("#bilgi-" + yorumicin).css("display", "block");
                $("#bilgi-" + yorumicin + " #mesaj").html(data.message);

                $("#basarili-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin).css("display", "none");
            }
            else {
                $("#uyari-" + yorumicin).css("display", "block");
                $("#bilgi-" + yorumicin).css("display", "none");
                $("#basarili-" + yorumicin).css("display", "none");
                $("#uyari-" + yorumicin + " #mesaj").html(data.message);
            }

        });
    }

    function Degerlendir() {
        console.log("geldi.");
        var ad = $("#ad").val();
        var email = $("#mail").val();
        var konu = $("#konu").val();
        var aciklama = $("#aciklamagir").val();
        var kitapId = $("#kitapId").val();
        var degerlendirme = $("#degerlendirmemesaicin").val();

        console.log("ad:" + ad + " email:" + email + " konu:" + konu + " aciklama:" + aciklama);

        if (yildizPuani == 0) {
            $("#uyari-" + degerlendirme).css("display", "block");
            $("#bilgi-" + degerlendirme).css("display", "none");
            $("#basarili-" + degerlendirme).css("display", "none");
            $("#uyari-" + degerlendirme + " #mesaj").html("Yıldız veriniz.");
            return;
        }

        if (ad == "" || email == "" || konu == "" || aciklama == "") {
            $("#uyari-" + degerlendirme).css("display", "block");
            $("#bilgi-" + degerlendirme).css("display", "none");
            $("#basarili-" + degerlendirme).css("display", "none");
            $("#uyari-degerlendirme #mesaj").html("Tüm alanları doldurunuz");
            return;
        }

        $.post("@Url.Action(nameof(KitaplarController.PostBooksDegerlendirme), "Kitaplar")", {
            "NAME": ad,
            "EMAIL": email,
            "KONU": konu,
            "BookId": kitapId,
            "ACIKLAMA": aciklama,
            "StarPuani": yildizPuani

        }, function (data) {
            console.log("data state:" + data.state);
            if (data.state == 1) {
                $("#basarili-" + degerlendirme).css("display", "block");
                $("#basarili-" + degerlendirme + " #mesaj").html(data.message);

                $("#bilgi-" + degerlendirme).css("display", "none");
                $("#uyari-" + degerlendirme).css("display", "none");
            }
            else if (data.state == 3) {
                $("#bilgi-" + degerlendirme).css("display", "block");
                $("#bilgi-" + degerlendirme + " #mesaj").html(data.message);

                $("#basarili-" + degerlendirme).css("display", "none");
                $("#uyari-" + degerlendirme).css("display", "none");
            }
            else {
                $("#uyari-" + degerlendirme).css("display", "block");
                $("#bilgi-" + degerlendirme).css("display", "none");
                $("#basarili-" + degerlendirme).css("display", "none");
                $("#uyari-" + degerlendirme + " #mesaj").html(data.message);
            }

        });
    }

    var yildizlar = document.getElementsByClassName("yildizver");

    function YildizVer(adet) {

        yildizPuani = adet;
        console.log("adet:" + adet + " yildizlar.length :" + yildizlar.length);

        for (var i = 0; i < yildizlar.length; i++) {
            $(yildizlar[i]).css("color", "gray");
        }

        for (var i = 0; i < adet; i++) {
            $(yildizlar[i]).css("color", "dodgerblue");
        }
    }

    function YildizIptalEt(adet) {

        yildizPuani = adet;
        console.log("adet:" + adet);
        for (var i = 0; i < yildizlar.length; i++) {
            $(yildizlar[i]).css("color", "gray");
        }
    }


</script>