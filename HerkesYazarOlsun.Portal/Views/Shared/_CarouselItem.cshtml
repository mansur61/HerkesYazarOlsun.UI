@model HerkesYazarOlsun.Model.Entity.Books

<div class="col-lg-4" style="margin-bottom:15px;margin-top:25px;">
    <div class="col-item">
        <div class="photo">
            <img src="http://placehold.it/350x260" style="width:auto;height:350px" class="img-responsive" alt="a" />
        </div>
        @*<div class="info">*@
        <div class="row">
            <div class="price col-md-6">
                <center>
                    <h5>
                        @Model.Name
                    </h5>
                </center>
            </div>
            <div class="rating hidden-sm col-sm-6">
                <i class="price-text-color fa fa-star"></i>
                <i class="price-text-color fa fa-star"> </i>
                <i class="price-text-color fa fa-star"></i>
                <i class="price-text-color fa fa-star"> </i>
                <i class="price-text-color fa fa-star"> </i>

            </div>
        </div>
        <div class="separator clear-left">
            <p class="btn-add">
                <i class="fa fa-heart"></i><a href="" class="hidden-sm">Favorilere Ekle</a>
            </p>
            <p class="btn-details">
                <i class="fa fa-list"></i><a href="/Kitaplar/KitapDetay?kitapId=@Model.ID" class="hidden-sm">Kitap Detay</a>
            </p>
        </div>
        <div class="clearfix">
        </div>
        @*</div>*@
    </div>
</div>