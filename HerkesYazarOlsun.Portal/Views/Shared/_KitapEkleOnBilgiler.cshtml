@using HerkesYazarOlsun.Portal.Controllers;
@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;

<div class="card-body">

    <h1><strong>Kitabınızı Yazmaya Başlayınız </strong> </h1>
    <h4>Kitabınız İçin Önbilgileri Formlardan Doldurunuz ... </h4>
    <br />
    <div class="conrainer">
        <input type="hidden" id="ONKAPAKFOTO" name="ONKAPAKFOTO"  >
        <input type="hidden" id="ARKAKAPAKFOTO" name="ARKAKAPAKFOTO">
       

        <div class="mb-3">
            <h5>Kitabınızın Adını Belirleyiniz *</h5>
            <input class="form-control" type="text" id="kitapAdi" multiple name="Name">

        </div>

        <div class="mb-3">
            <h5>Kitabınızın Ön Kapağını Seçiniz *</h5>
            <input class="form-control" type="file"  id="dosyaOnKapakFoto" onchange="dosyaSecim('onKapakFoto')" multiple>

        </div>
        <div class="mb-3">
            <h5>Kitabınızın Arka Kapağını Seçiniz *</h5>
            <input class="form-control" type="file" id="dosyaArkaKapakFoto" onchange="dosyaSecim('arkaKapakFoto')" multiple>
        </div>
        <div class="mb-3">
            <h5>Kitabınızın Önsöz'ünü giriniz *</h5>
            <textarea class="form-control" id="onsoz" rows="5" cols="50" name="ONSOZ"></textarea>
            <div id="help" class="form-text" style="color:cadetblue">500 karakteri geçmeyiniz.</div>
        </div>

        <div class="mb-3">
            <h5>Kitabınızın Arkakapak yazısını giriniz *</h5>
            <textarea class="form-control" id="arkaKapakYazi" rows="5" cols="50" name="ARKAKAPAKYAZISI"></textarea>
            <div id="help" class="form-text" style="color:cadetblue">200 karakteri geçmeyiniz.</div>
        </div>
        <h5>Kitabın Kategorisini seçiniz *</h5>
        <div class="row-cols-3">
        </div>


        <select class="form-select" style="width:500px;height:30px" id="kitapKategori" name="CategoriId">
            @foreach (var category in Model.Katergoriler)
            {
                <option value="@category.Id" data="@category.Name"  >
                    @category.Name
                </option>
            }
        </select>

        


    </div>

</div>
