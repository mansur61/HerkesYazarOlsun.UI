@using HerkesYazarOlsun.Portal.Controllers
@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL

  
            <div class="card shadow-sm">
                <div class="card-body">

                    <h1 class="mb-3 fw-bold">Kitabınızı Yazmaya Başlayınız</h1>
                    <h5 class="mb-4 text-muted">
                        Kitabınız için ön bilgileri aşağıdaki formlardan doldurunuz
                    </h5>

                    <!-- Hidden Inputs -->
                    <input type="hidden" id="ONKAPAKFOTO" name="ONKAPAKFOTO" />
                    <input type="hidden" id="ARKAKAPAKFOTO" name="ARKAKAPAKFOTO" />

                    <!-- Kitap Adı -->
                    <div class="mb-3">
                        <label for="kitapAdi" class="form-label fw-semibold">
                            Kitabınızın Adını Belirleyiniz <span class="text-danger">*</span>
                        </label>
                        <input type="text"
                               class="form-control"
                               id="kitapAdi"
                               name="Name"
                               placeholder="Kitap Adı" />
                    </div>

                    <!-- Ön Kapak -->
                    <div class="mb-3">
                        <label for="dosyaOnKapakFoto" class="form-label fw-semibold">
                            Kitabınızın Ön Kapağını Seçiniz <span class="text-danger">*</span>
                        </label>
                        <input type="file"
                               class="form-control"
                               id="dosyaOnKapakFoto"
                               onchange="dosyaSecim('onKapakFoto')" />
                    </div>

                    <!-- Arka Kapak -->
                    <div class="mb-3">
                        <label for="dosyaArkaKapakFoto" class="form-label fw-semibold">
                            Kitabınızın Arka Kapağını Seçiniz <span class="text-danger">*</span>
                        </label>
                        <input type="file"
                               class="form-control"
                               id="dosyaArkaKapakFoto"
                               onchange="dosyaSecim('arkaKapakFoto')" />
                    </div>

                    <!-- Ön Söz -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Kitabınızın Önsözünü Giriniz <span class="text-danger">*</span>
                        </label>

                        <div id="onSozEditor" class="border rounded" style="height: 200px;"></div>
                        <textarea id="onsoz" name="ONSOZ" class="d-none"></textarea>

                        <div class="form-text text-info">
                            500 karakteri geçmeyiniz.
                        </div>
                    </div>

                    <!-- Arka Kapak Yazısı -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Kitabınızın Arka Kapak Yazısını Giriniz <span class="text-danger">*</span>
                        </label>

                        <div id="arkaKapakYaziEditor" class="border rounded" style="height: 200px;"></div>
                        <textarea id="arkaKapakYazi" name="ARKAKAPAKYAZISI" class="d-none"></textarea>

                        <div class="form-text text-info">
                            200 karakteri geçmeyiniz.
                        </div>
                    </div>

                    <!-- Kategori -->
                    <div class="mb-4 col-sm-8 col-md-6 p-0">
                        <label for="kitapKategori" class="form-label fw-semibold">
                            Kitabın Kategorisini Seçiniz <span class="text-danger">*</span>
                        </label>

                        <select class="form-select"
                                id="kitapKategori"
                                name="CategoriId">
                            <option value="" selected disabled>Bir kategori seçiniz</option>
                            @foreach (var category in Model.Katergoriler)
                            {
                                <option value="@category.ID"
                                        data-name="@category.Name"  
                                        id="selectData-@category.ID">
                                    @category.Name
                                </option>
                            }
                        </select>
                    </div>

                </div>
            </div>

      
