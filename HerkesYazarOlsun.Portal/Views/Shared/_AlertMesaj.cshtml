

@model string
<div style="width:auto;height:auto">

    <div class="alert alert-success" id="basarili-@Model" style="display:none;">
        <strong>Başarılı! </strong>
        <p id="mesaj"></p>
        <button type="button" class="btn btn-info" onclick='Kapat("@Model")'>  Kapat</button>
    </div>
  
    <div class="alert alert-danger" id="uyari-@Model" style="display:none;">
        <strong>Başarısız! </strong>
        <p id="mesaj"></p>
        <button type="button" class="btn btn-info" onclick='Kapat("@Model")'>  Kapat</button>
    </div>

   
    <div class="alert alert-warming" id="bilgi-@Model" style="display:none;">
        <strong>Uyarı! </strong>
        <p id="mesaj"></p>
        <button type="button" class="btn btn-info" onclick='Kapat("@Model")'>  Kapat</button>
    </div>

</div>

<script>
    function Kapat(tip) {
        console.log("alert mesaj tip:"+tip);

        $("#basarili-" + tip).css("display", "none");
        $("#uyari-" + tip).css("display", "none");
        $("#bilgi-" + tip).css("display", "none");
    }

</script>