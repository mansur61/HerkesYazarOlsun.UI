@model HerkesYazarOlsun.Model.ViewModel.VM_USERS_DETAIL;
@using HerkesYazarOlsun.Portal.Controllers;


@if (@Model.yazarSliderYometimAdi == "tumyazarlar")
{
    int sliderdaGosterilecekKayit = (Model.sliderdaGosterilecekKayit == 0) ? 10 : Model.sliderdaGosterilecekKayit;

    int kalan = (@Model.VMUsersList.Count() % sliderdaGosterilecekKayit);
    int bolum = (@Model.VMUsersList.Count() / sliderdaGosterilecekKayit);

    int sliderSayisi = (@kalan == 0) ? bolum : (@bolum + 1);

    Model.sliderdaGosterilecekKayit = @sliderdaGosterilecekKayit;
    Model.End = @sliderdaGosterilecekKayit;
    Model.kalan = @kalan;
    Model.bolum = @bolum;
    // Model.sliderSayisi = @sliderSayisi;
    Model.vM_PAGINATION_BUTTONS = new HerkesYazarOlsun.Model.ViewModel.VM_PAGINATION_BUTTON();
    Model.vM_PAGINATION_BUTTONS.sliderSayiDivTagName = "tumyazarlar";
    Model.vM_PAGINATION_BUTTONS.sliderSayisi = @sliderSayisi;
}
else if (@Model.yazarSliderYometimAdi == "yazarlar")
{
    int sliderdaGosterilecekKayit = (Model.sliderdaGosterilecekKayit == 0) ? 20 : Model.sliderdaGosterilecekKayit;

    int kalan = (@Model.VMUsersList.Count() % sliderdaGosterilecekKayit);
    int bolum = (@Model.VMUsersList.Count() / sliderdaGosterilecekKayit);

    int sliderSayisi = (@kalan == 0) ? bolum : (@bolum + 1);
    Model.End = @sliderdaGosterilecekKayit;
    //Model.sliderdaGosterilecekKayit = @sliderdaGosterilecekKayit;
    Model.kalan = @kalan;
    Model.bolum = @bolum;
    Model.vM_PAGINATION_BUTTONS = new HerkesYazarOlsun.Model.ViewModel.VM_PAGINATION_BUTTON();
    Model.vM_PAGINATION_BUTTONS.sliderSayisi = @sliderSayisi;
    Model.vM_PAGINATION_BUTTONS.sliderSayiDivTagName = "yazarlar";
}