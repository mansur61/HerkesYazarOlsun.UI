@using HerkesYazarOlsun.Portal.Controllers;
@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}
<style>
    /* Desktop: dropdown scroll */
    .navbar .dropdown-menu {
        max-height: 400px;
        overflow-y: auto;
        z-index: 2000;
    }

    /* Mobil: collapse içindeki dropdown */
    @@media (max-width: 767px) {
        #main-navbar

    {
        max-height: 80vh; /* Mobilde navbar yüksekliğini sınırla */
        overflow-y: auto; /* Scroll navbar içinde olacak */
    }

    .navbar .dropdown-menu {
        max-height: none; /* Scroll dropdown değil, navbar scroll olacak */
        overflow-y: visible;
    }

    .navbar .dropdown.open .dropdown-menu {
        display: block !important;
    }

    }
</style>
<nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
    <div class="container-fluid">
        <!-- Navbar Header: Logo + Hamburger -->
        <div class="navbar-header">
            <!-- Hamburger Menü Butonu -->
            <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#main-navbar">
                <span class="sr-only">Toggle navigation</span>
                <span class="icon-bar" style="background-color:white;"></span>
                <span class="icon-bar" style="background-color:white;"></span>
                <span class="icon-bar" style="background-color:white;"></span>
            </button>

            <!-- Logo -->
            <a class="navbar-brand" href="/Home/Index">Yazar Olun</a>
        </div>

        <!-- Navbar Menüsü -->
        <div class="collapse navbar-collapse" id="main-navbar">
            <ul class="nav navbar-nav">
                <li class="active"><a href="/Home/Index">Anasayfa</a></li>
                <li><a href="/Home/Hakkimizda">Hakkımızda</a></li>
                <li><a href="/Home/Iletisim">İletişim</a></li>
            </ul>

            <ul class="nav navbar-nav navbar-right">
                <li class="dropdown">
                    <a class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                        @if (!string.IsNullOrEmpty(User.GetEmail()))
                        {
                            <i class="fa fa-user"></i>
                        }
                        else
                        {
                            @:Giriş Yap
                        }
                        <span class="caret"></span>
                    </a>
                    <ul class="dropdown-menu">
                        @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
                        {
                            <li><a href="/Kisi/Profil">Profil @User.GetUserName() </a></li>
                            <li><a href="/Kitaplar/TumKitaplar?FavoriKitaplar=true">Favori Kitaplarım</a></li>
                            <li><a href="/Kisi/TumYazarlar?FavoriYazarlar=true">Favori Yazarlarım</a></li>
                            <li><a href="/Kitaplar/TumKitaplar?BitenKitaplar=true">Yazdığım/Tamamlanan Kitaplar</a></li>
                            <li><a href="/Kitaplar/TumKitaplar?DevamEdenKitaplar=true">Henüz Tamamlanmayan Kitaplarım</a></li>
                            <li><a href="/Kitaplar/TumKitaplar?YayinlananKitaplar=true">Yayınlanan Kitaplarım</a></li>
                            <li><a href="/Ayarlar/Ayarlar">Ayarlar</a></li>
                            <li><a href="/Account/CikisYap">Çıkış Yap</a></li>
                        }
                        else
                        {
                            <li><a href="/Account/Giris">Giriş Yap</a></li>
                        }
                    </ul>
                </li>
            </ul>

        </div>
    </div>
</nav>

<script>
    function bigImg(x) {
        $("#arabutonu").css("display", "block");
        x.style.height = "64px";
        x.style.width = "64px";
    }

    function normalImg(x) {
        $("#arabutonu").css("display", "none");
        x.style.height = "32px";
        x.style.width = "32px";
    }


</script>
<script>
    // URL sonu # ile bitiyorsa kaldır
    if (window.location.href.endsWith("#")) {
        history.replaceState(null, null, window.location.href.replace(/#$/, ""));
    }

</script>

<script src="~/js/hamburger.js"></script>