@using HerkesYazarOlsun.Portal.Controllers;
@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    string isGozlemciMod = User.GetGozlemciMod();
}

<style>
    /* Sadece giriş yapmış kullanıcı dropdown menüsü scroll */
    .scroll-dropdown {
        max-height: 300px; /* mobilde biraz daha kısa olabilir */
        overflow-y: auto;
        overflow-x: hidden;
    }

    /* Mobil: collapse içindeki navbar */
    @@media (max-width: 767px) {
        #main-navbar

    {
        max-height: 80vh; /* viewport’a göre sınırlı */
        overflow-y: auto; /* navbar scrollu aktif */
    }

    /* Dropdown menü scrollu collapse içinde çalışacak */
    .navbar-collapse .scroll-dropdown {
        position: relative; /* absolute değil, parent relative */
        display: block; /* mutlaka block */
    }

    }
</style>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top" role="navigation">
    <div class="container-fluid">
        <a class="navbar-brand" href="/Home/Index">Yazar Olun</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navbar" aria-controls="main-navbar" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="main-navbar">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item active"><a class="nav-link" href="/Home/Index">Anasayfa</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Hakkimizda">Hakkımızda</a></li>
                <li class="nav-item"><a class="nav-link" href="/Home/Iletisim">İletişim</a></li>
                @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
                {
                    <li class="nav-item"><a class="nav-link" href="/Kisi/Profil">Profil</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Ayarlar/Ayarlar">Ayarlar</a></li>
                }
            </ul>
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item dropdown">
                    @if (string.IsNullOrEmpty(User.GetEmail()))
                    {
                        if (isGozlemciMod != "0")
                        {
                            <a class="nav-link" href="/Account/CikisYap">Çıkış Yap</a>
                        }
                        else
                        {
                            <a class="nav-link" href="/Account/Giris">
                                Giriş Yap <span class="caret"></span>
                            </a>
                        }
                    }
                    else
                    {
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa fa-user"></i> @User.GetUserName()
                        </a>
                        <ul class="dropdown-menu scroll-dropdown" aria-labelledby="navbarDropdown">
                            @if (isGozlemciMod == "0")
                            {
                                <li><a class="dropdown-item" href="/Kitaplar/TumKitaplar?FavoriKitaplar=true">Favori Kitaplarım</a></li>
                                <li><a class="dropdown-item" href="/Kisi/TumYazarlar?FavoriYazarlar=true">Favori Yazarlarım</a></li>
                                <li><a class="dropdown-item" href="/Kitaplar/TumKitaplar?BitenKitaplar=true">Yazdığım/Tamamlanan Kitaplar</a></li>
                                <li><a class="dropdown-item" href="/Kitaplar/TumKitaplar?DevamEdenKitaplar=true">Henüz Tamamlanmayan Kitaplarım</a></li>
                                <li><a class="dropdown-item" href="/Kitaplar/TumKitaplar?YayinlananKitaplar=true">Yayınlanan Kitaplarım</a></li>
                            }
                            <li><a class="dropdown-item" href="/Account/CikisYap">Çıkış Yap</a></li>
                        </ul>
                    }
                </li>
            </ul>
        </div>
    </div>
</nav>

<script src= "~/js/hamburger.js"></script>
