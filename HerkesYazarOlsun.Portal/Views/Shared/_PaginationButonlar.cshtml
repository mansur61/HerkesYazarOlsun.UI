
@model HerkesYazarOlsun.Model.ViewModel.VM_PAGINATION_BUTTON;

<style>
    .containerPagination {
        width: 200px;
        height: 100%;
        background: lineer-gradient(45deg,#410358,#4700bc);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pagination {
        display: flex;
        align-items: center;
        background: #fff;
        color: #383838;
        padding: 10px 10px;
        border-radius: 6px;
    }

    .containerPagination > ul {
        margin: 20px 30px;
    }

        .containerPagination > ul li {
            display: inline-block;
            text-align: center;
            margin: 10px 10px;
            /* background: #acc;*/
            width: 45px;
            height: 45px;
            border-radius: 20%;
            font-size: 22px;
            font-weight: 500;
            line-height: 45px;
            cursor: pointer;
            background-position: 0 -45px;
            transition: background-position 0.5s;
        }

            .containerPagination > ul li.active {
                color: #410358;
                background-color: #3e8e41;
                /* background-image: lineer-gradient(45deg,#410358,#4700bc);*/
                background-repeat: no-repeat;
                background-position: 0 0px;
            }

    .btn1, .btn2 {
        display: inline-flex;
        align-items: center;
        font-size: 22px;
        font-weight: 500;
        color: #383838;
        background: transparent;
        outline: none;
        border: none;
        cursor: pointer;
    }
</style>


<div class="containerPagination" style="margin:10px auto;" id="butonlar">

    <button class="btn1" onclick="backBtn()">Geri</button>

    <ul class="pagination">
        @for (int i = 0; i < @Model.sliderSayisi; i++)
        {
            @if (i == 0)
            {
                <li class="page-item-@Model.sliderSayiDivTagName active" onclick="activeLink()" value="@(i)">
                    @(i + 1)
                </li>
            }
            else
            {
                <li class="page-item-@Model.sliderSayiDivTagName " onclick="activeLink()" value="@(i)">
                    @(i + 1)
                </li>
            }

        }

    </ul>
    <button class="btn2" onclick="nextBtn()">İleri</button>


</div>


<script>
    
    var pageItem = document.getElementsByClassName("page-item-@Model.sliderSayiDivTagName");
    var durum = document.getElementsByClassName("durum_@Model.sliderSayiDivTagName");

    console.log("pageItem: " + pageItem.length + " durum :" + durum.length);

    for (l of durum) {
        l.style.display = "none";
    }

    var isActive = false;
    var currentValue = 1;
    var currentIndex = 0;
    durum[currentIndex].style.display = "block";


    function activeLink() {
        isActive = true;
        for (l of pageItem) {
            l.classList.remove("active");
        }
        event.target.classList.add("active");
        currentValue = event.target.value;
        console.log("activeLink event.target.value: " + currentValue);
        //sayfaGoster(currentValue);
        let previous_step = currentValue - 1;
        for (var i = 0; i < durum.length; i++) {
            if (currentValue == i) {
                durum[i].style.display = "block";
            } else {
                durum[i].style.display = "none";
            }
        }

    }

    function backBtn() {

        for (l of pageItem) {
            l.classList.remove("active");
        }
        var isCurrentIndexDurumEquals = false;

        if (currentIndex == durum.length) {
            isCurrentIndexDurumEquals = true;
            pageItem[durum.length - (currentIndex - 1)].classList.add("active");
            currentIndex = durum.length - (currentIndex - 1);
        } else {
            currentIndex = currentIndex - 1;
            if (currentIndex < 0) {
                currentIndex = 0;
            }
        }


        //console.log("currentIndex backBtn: " + currentIndex + " currentValue:" + currentValue);

        if (isActive) {

            currentIndex = currentValue;
            //console.log("currentIndex backBtn: geldi  " + isActive + " currentValue:" + currentIndex);
            if (currentIndex > 0) {
                currentIndex = currentValue - 1;
            }
            else {
                currentIndex = 0;
            }
            currentValue = currentIndex;

            if (currentIndex > 0) {
                pageItem[currentValue].classList.add("active");
            } else {
                pageItem[currentIndex].classList.add("active");
            }
        }
        else {
            //if (!isCurrentIndexDurumEquals) {
            //    pageItem[currentIndex].classList.add("active");
            //}
            pageItem[currentIndex].classList.add("active");
        }

        for (var i = 0; i < durum.length; i++) {
            if (currentIndex == i) {
                durum[i].style.display = "block";
            } else {
                durum[i].style.display = "none";
            }
        }


        //if (currentValue > 1) {
        //    for (l of pageItem) {
        //        l.classList.remove("active");
        //    }
        //    currentValue--;
        //    pageItem[currentValue - 1].classList.add("active");
        //    console.log("currentValue backBtn: " + currentValue);

        //    sayfaGoster(currentValue);
        //}



    }

    function nextBtn() {

        if (currentIndex == durum.length - 1) {
            currentIndex = durum.length - 1;
        }
        else if (currentIndex < durum.length) {
            currentIndex++;

        }
        else {
            currentIndex = (durum.length);
        }

        for (l of pageItem) {
            l.classList.remove("active");
        }

        if (isActive) {
            currentIndex = currentValue;
            if (currentIndex < durum.length) {
                currentIndex = currentValue + 1;
            }
            else {
                currentIndex = (durum.length);
            }
            currentValue = currentIndex;

            if (currentIndex < durum.length) {
                pageItem[currentValue].classList.add("active");
            } else {
                pageItem[currentIndex - 1].classList.add("active");
            }
        } else {
            if (currentIndex < durum.length) {
                pageItem[currentIndex].classList.add("active");
            } else {
                pageItem[currentIndex - 1].classList.add("active");
            }
        }
        console.log("currentIndex: " + currentIndex);
        for (var i = 0; i < durum.length; i++) {
            if (currentIndex == i) {
                durum[i].style.display = "block";
            } else {
                durum[i].style.display = "none";
            }
        }


        //if (currentValue < 6) {
        //    for (l of pageItem) {
        //        l.classList.remove("active");
        //    }
        //    console.log("currentValue nextBtn: " + currentValue);
        //    pageItem[currentValue - 1].classList.add("active");
        //    currentValue++;
        //    sayfaGoster(currentValue);
        //}
    }

   
    function sayfaGoster(sayfaIndex) {

        console.log("durum.length:  " + durum.length);
        console.log("currentValue:  " + sayfaIndex);
        console.log("sayfaIndex:  " + sayfaIndex);

        if (sayfaIndex <= durum.length) {
            let previous_step = currentValue - 1;
            console.log("previous_step: " + previous_step);

            if (sayfaIndex == durum.length) {

                durum[previous_step - 1].style.display = "none";
                durum[sayfaIndex - 1].style.display = "block";
            } else {
                if (sayfaIndex == 1) {
                    durum[previous_step].style.display = "block";
                    durum[sayfaIndex].style.display = "block";
                } else {
                    durum[previous_step].style.display = "none";
                    durum[sayfaIndex].style.display = "block";
                }

            }

        }
    }
</script>
