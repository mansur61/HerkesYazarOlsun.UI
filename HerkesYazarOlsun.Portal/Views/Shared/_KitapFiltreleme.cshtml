@using HerkesYazarOlsun.Portal.Controllers
@* filtreleme kısımları *@

<div class="container mx-auto">
    <div class="row">
        <div class="col-12">
            <div class="filter__item">
                <div class="row g-3 align-items-center">

                    <!-- Kitap Ara -->
                    <div class="col-lg-4 col-md-5">
                        <div class="filter__sort">
                            <input type="text"
                                   class="form-control"
                                   name="kitap_ara"
                                   id="kitap_ara"
                                   placeholder="Kitap Adı Ara" />
                        </div>
                    </div>

                    <!-- Kayıt Sayısı -->
                    <div class="col-lg-4 col-md-3">
                        <select class="form-select"
                                name="kayit_sayisi"
                                id="kayit_sayisi">
                            <option selected value="10">İlk 10 Kayıt</option>
                            <option value="20">İlk 20 Kayıt</option>
                            <option value="30">İlk 30 Kayıt</option>
                            <option value="40">İlk 40 Kayıt</option>
                            <option value="50">İlk 50 Kayıt</option>
                        </select>
                    </div>

                    <!-- Butonlar -->
                    <div class="col-lg-4 col-md-4 d-flex gap-2">
                        <button type="button"
                        onclick="Temizle()"
                                class="btn btn-danger">
                            Temizle
                        </button>

                        <button type="button"
                                onclick="Ara()"
                                class="btn btn-primary">
                            Ara
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
