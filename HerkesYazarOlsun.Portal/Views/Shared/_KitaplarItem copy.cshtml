@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;

@using HerkesYazarOlsun.Model.Entity
@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Portal.Controllers;
@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    // int gosterilecekKayit = Model.sliderdaGosterilecekKayit.Value;
    // int start = Model.Start ?? 0;
    // int end = (Model.Start ?? 0) + gosterilecekKayit;
    // var booksList = Model.VMBooksList?.Skip(start).Take(gosterilecekKayit).ToList();//OrderByDescending(p => p.ID).
 

}

@{
    string isGozlemciMod = User.GetGozlemciMod();
}

<style>
    .trash-icon {
        display: inline-block;
        font-size: 18px;
        padding: 6px 8px;
        background-color: #fff; /* Beyaz arka plan */
        border: 1px solid #ccc; /* Hafif gri border */
        border-radius: 6px; /* Yuvarlatılmış köşeler */
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

        .trash-icon:hover {
            background-color: #f8d7da; /* Silmeye yakın kırmızı ton hover */
            border-color: #f5c6cb;
            color: #a71d2a; /* Icon rengi değişir */
            transform: scale(1.1); /* Hafif büyüme efekti */
        }

    .book-item {
        flex: 0 0 50%; /* her satırda 2 adet */
        max-width: 220px; /* senin istediğin genişlik */
        box-sizing: border-box;
        padding: 5px;
        margin: 5px;
        border: 1px dotted blue;
    }

    .books-wrapper {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }


</style>


<div class="books-wrapper">
@foreach (var item in Model.VMBooksList)
{
    try
    {
        <input type="hidden" value="@item.ID" name="kId">

            <div class="col-6 col-sm-6 col-md-4 col-lg-3 book-item">


            <div class="product__item" style="overflow:hidden;height:360px">

                <div class="product__item__pic set-bg" data-setbg="https://herkesyazarolsun.com.tr/Belgeler/@item.ONKAPAKFOTOPATH">
                    @if (!string.IsNullOrEmpty(item.Categori?.Name))
                    {
                        <div class="discount-badge" style="position:absolute; top:10px; left:10px; background-color:lightgreen; color:white; padding:5px 10px; font-size:12px; font-weight:bold; border-radius:5px;">
                            @item.Categori.Name
                        </div>
                    }

                    <ul class="product__item__pic__hover">
                        @if (isGozlemciMod == "0")
                        {
                            <li>
                                <a onclick='KitabiFavorilereEkle(this,"@StringCipher.Encrypt(item.ID.ToString())", "@Model.Tip")'><i class="fa fa-heart"></i></a>
                            </li>

                            @if (!(@Model.isAnaSayfa ?? false) && item.YazarId == (int?)ViewBag.LOGIN_USER_ID)
                            {
                                if (item.TAMAMLANDIMI)
                                {
                                    var yayinAyr = (ViewBag.YayinAyar != null && ViewBag.YayinAyar.Count > 0)
                                        ? ViewBag.YayinAyar
                                        : item.Categori?.CategoryYayinAyarlari;

                                    if (yayinAyr != null)
                                    {
                                        if (item.iSTATISTIK.ToplamBegeni >= yayinAyr.ToplamBegeni
                                            && item.iSTATISTIK.ToplamYorum >= yayinAyr.ToplamYorum
                                            && item.iSTATISTIK.ToplamYildiz >= yayinAyr.ToplamYildiz
                                            && item.iSTATISTIK.ToplamDegerlendirme >= yayinAyr.ToplamDegerlendirme)
                                        {
                                            <li>
                                                <a onclick='KitabiYayinaGonder("@StringCipher.Encrypt(item.ID.ToString())","@Model.Tip")'>
                                                    <i class="fa fa-share"></i>
                                                </a>
                                            </li>
                                        }
                                    }
                                }

                                <li id="delBtn_@item.ID"
                                    onclick='KitabiSil("@StringCipher.Encrypt(item.ID.ToString())","@Model.Tip","@item.ID")' aria-label="Sil">
                                    <span class="trash-icon">&#x1F5D1;&#xFE0F;</span>
                                </li>
                            }
                        }

                        <li><a href="/Kisi/Profil?pId=@StringCipher.Encrypt(item.YazarId.ToString())"><i class="fa fa-user"></i></a></li>
                    </ul>
                </div>

                <div class="product__item__text" style="height:auto">
                    <h6><a href="/Kitaplar/KitapDetay?kitap_id=@StringCipher.Encrypt(item.ID.ToString())">@item.Name</a></h6>
                    <div class="row">
                        <div class="rating hidden-sm col-sm-7">
                            @{
                                var maxStar = (item.BooksStars?.Count > 0) ? item.BooksStars.Max(x => x.StarPuani) : 0;
                            }

                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= maxStar)
                                {
                                    <i class="price-text-color fa fa-star"></i>
                                }
                                else
                                {
                                    <i class="fa fa-star text-secondary"></i>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
       
    }
    catch (Exception ex)
    {
        <div style="border:1px solid red; color:red; margin:5px; padding:5px;">
            <strong>Hata @item.ID:</strong> @ex.Message
        </div>
    }
}
 </div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.7/js/bootstrap.min.js"></script>

<script>

    function KitabiFavorilereEkle(btn, kitapId, tip) {
        const originalIcon = btn.innerHTML; // eski ikon
        console.log("tip: " + tip);
        btn.innerHTML = '<i class="fa fa-spinner fa-spin text-primary"></i>'; 

        $.post(
            "@Url.Action(nameof(KitaplarController.KitabiFavorilereEkle), "Kitaplar")",
            { "id": kitapId },
            function (data) {
                setTimeout(() => {   }, 200); // 200ms beklet
                // Ajax tamamlanınca eski ikon geri dönsün
                btn.innerHTML = originalIcon;

                if (data.state == 1) {
                    $("#basarili-" + tip).css("display", "block");
                    $("#basarili-" + tip + " #mesaj").html("Favorilerinize eklendi");
                } else {
                    $("#uyari-" + tip).css("display", "block");
                    $("#uyari-" + tip + " #mesaj").html(data.message);
                }
            }
        ).fail(function () {
            btn.innerHTML = originalIcon;
            $("#uyari-" + tip).css("display", "block");
            $("#uyari-" + tip + " #mesaj").html("Sunucu hatası.");
        });
    }

 
    function KitabiYayinaGonder(kitapId, tip) {
        console.log("tip: " + tip);
        console.log("kitapId: " + kitapId);
        $.post("@Url.Action(nameof(KitaplarController.KitabiYayinaGonder), "Kitaplar")", { "kitapid": kitapId }, function (data) {
            console.log("data: " + data.state);
            if (data.state == 1) {
                $("#basarili-" + tip).css("display", "block");
                $("#uyari-" + tip + " #mesaj").html("Tebrikler. Kitabınızı yayına alabilirsiniz. Bunun için ödeme sayfasına yönlendirileceksiniz.");
                setTimeout(function () {
                    window.location.href = "/OdemeSayfasi/Odeme?kitapId=" + kitapId;
                }, 3000);
            } else {
                $("#uyari-" + tip).css("display", "block");
                $("#uyari-" + tip + " #mesaj").html(data.message);

            }
        });
    }

     function KitabiSil(encId, tip, realId) {

          console.log("tip: " + tip);
        console.log("kitapId: " + realId);

        const btn = document.getElementById("delBtn_" + realId);
        const originalIcon = btn.innerHTML;

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu kitabı silmek istiyor musunuz?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet',
            cancelButtonText: 'Hayır',
            customClass: {
                confirmButton: 'btn btn-danger',
                cancelButton: 'btn btn-secondary'
            }
        }).then((result) => {

            if (result.isConfirmed) {

                // SPINNER BAŞLASIN
                btn.innerHTML = '<i class="fa fa-spinner fa-spin text-primary"></i>';

                $.post(
                    "@Url.Action(nameof(KitaplarController.KitabiSil), "Kitaplar")",
                    { "kitapid": encId },
                    function (data) {

                        console.log("data: " + data.state);

                        // HER DURUMDA İKONU GERİ GETİR
                        btn.innerHTML = originalIcon;

                        if (data.state == 1) {

                            // Başarılı
                            $("#basarili-" + tip).css("display", "block");
                            $("#uyari-" + tip + " #mesaj").html("Kitap Silindi");

                            setTimeout(function () {
                                window.location.reload();
                            }, 3000);

                        } else {

                            // Hata
                            $("#uyari-" + tip).css("display", "block");
                            $("#uyari-" + tip + " #mesaj").html(data.message);
                        }
                    }
                )
                .fail(function () {

                    // AJAX hata verirse de ikonu geri getir
                    btn.innerHTML = originalIcon;

                    $("#uyari-" + tip).css("display", "block");
                    $("#uyari-" + tip + " #mesaj").html("Sunucu ile bağlantı kurulamadı.");
                });

            } else {
                Swal.fire("İptal Edildi", "Silme işlemi iptal edildi.", "info");
            }
        });
    }
</script>
