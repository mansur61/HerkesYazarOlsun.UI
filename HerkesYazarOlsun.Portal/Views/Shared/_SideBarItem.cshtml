@*
    Başka sayfalarda kullanımak istendiğinde <div class="sidebar"></div> taglarına alınmalıdır. Ek olarak KitapArama.cshtml de js ve css kodları 
    kullanılacak sayfaya aktarılmalıdır. rendersection olarak
*@
@{
}

@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS;
@using HerkesYazarOlsun.Portal.Controllers;

@{
    int sidebardaGosterilecekKayit = 3;

    int sidebarKalan = (@Model.BooksList.Count() % sidebardaGosterilecekKayit);
    int sidebarBolum = (@Model.BooksList.Count() / sidebardaGosterilecekKayit);
    int sidebarSayisi = (@sidebarKalan == 0) ? sidebarBolum : (@sidebarBolum + 1);

   
    int start = 0;
}

<!--slider sidebar-->
<div class="sidebar__item">
    <div class="latest-product__text">
        <h4>En Yeniler </h4>
        <div class="latest-product__slider owl-carousel">

            @for (int i = 0; i < @sidebarSayisi; i++)
            {
                <div class="latest-prdouct__slider__item">


                    @foreach (var item in @Model.BooksList.Take(range: new Range(start, sidebardaGosterilecekKayit)))
                    {
                        <a href="#" class="latest-product__item">
                            <div class="latest-product__item__pic">
                             
                                <img src="~/wowbook/images/cover_last.png" alt="">
                            </div>
                            <div class="latest-product__item__text">
                                <h6>@item.Name </h6>
                                <div class="row">
                                    <div class="rating hidden-sm col-sm-12">
                                        <i class="price-text-color fa fa-star"></i>
                                        <i class="price-text-color fa fa-star"> </i>
                                        <i class="price-text-color fa fa-star"></i>
                                        <i class="price-text-color fa fa-star"> </i>
                                        <i class="price-text-color fa fa-star"> </i>

                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                    @{
                        start = sidebardaGosterilecekKayit;
                        sidebardaGosterilecekKayit = 3 + sidebardaGosterilecekKayit;
                    }
                </div>

            }

        </div>
    </div>
</div>