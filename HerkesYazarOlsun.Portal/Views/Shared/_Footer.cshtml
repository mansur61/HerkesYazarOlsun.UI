@using HerkesYazarOlsun.Portal.Controllers
@using HerkesYazarOlsun.Portal.Helpers.Extensions

<input type="hidden" id="footericin" value="footer" />

@{
    string alertmesajgostermedurumu = "footer";
}

  <link href="~/lib/css/footer.css" rel="stylesheet" />

<footer id="gozukecekMiFooter">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4 mb-4">
                <a class="footer-brand" href="Index">Herkes Yazar Olsun</a>
                <p>
                    Kitap yazarları bir arada topladığımız platformumuzda aynı zamanda, yazarlarımıza anlaşmalı yayın evi sponsorlarıız ile
                    daha uygun maliyetli kitaplarını yayınlayabilecek köprü kuruyoruz. Haydi sizde bu köprüden geçiniz.
                </p>
                <ul class="list-inline d-flex justify-content-center gap-3 social-networks mb-3">
                    <li class="list-inline-item">
                        <a href="https://x.com/kayamansur61" target="_blank" rel="noopener">
                            <span class="icon-social icon-social-twitter">
                                <i class="fab fa-twitter fa-2x"></i>
                            </span>
                        </a>
                    </li>
                    <li class="list-inline-item">
                        <a href="https://www.youtube.com/channel/UCEFPDrpvCY369hiZjx3BZag" target="_blank" rel="noopener">
                            <span class="icon-social icon-social-youtube">
                                <i class="fab fa-youtube fa-2x"></i>
                            </span>
                        </a>
                    </li>
                    <li class="list-inline-item">
                        <a href="https://www.linkedin.com/in/mansur-emin-kaya-b61100141/" target="_blank" rel="noopener">
                            <span class="icon-social icon-social-linkedin">
                                <i class="fab fa-linkedin fa-2x"></i>
                            </span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="col-lg-4 col-md-4 mb-4">
                <h3>İLETİŞİM</h3>
                <address>
                    <i class="fa fa-envelope"></i> info@herkesyazarolsun.com.tr
                </address>
            </div>
            @{
                string isGozlemciMod = User.GetGozlemciMod();
            }

            <div class="col-lg-4 col-md-4 mb-4">
                <h5 class="footer-title">Hızlı Erişim</h5>
                <ul class="footer-links list-unstyled">
                    <li><a href="/Home/Index">Anasayfa</a></li>
                    <li><a href="/Home/Blog">Blog/İçerik Sayfası</a></li>

                    <li><a href="/Home/Hakkimizda">Hakkımızda</a></li>
                    <li><a href="/Home/Iletisim">İletişim</a></li>
                    <li><a href="/Home/Sozlesme">Kullanıcı Sözleşmesi</a></li>
                    <li><a href="/Home/GizlilikSozlezmesi">Gizlilik Politikası</a></li>
                    <li><a href="/Home/YasalUyari">Yasal Uyarı</a></li>
                    
                    
                    @if (!string.IsNullOrEmpty(User.GetEmail()) && isGozlemciMod == "0")
                    {
                        <li><a href="/Kitaplar/TumKitaplar?FavoriKitaplar=true">Favori Kitaplarım</a></li>
                        <li><a href="/Kisi/TumYazarlar?FavoriYazarlar=true">Favori Yazarlarım</a></li>
                        <li><a href="/Kitaplar/TumKitaplar?BitenKitaplar=true">Yazdığım/Tamamlanan Kitaplar</a></li>
                        <li><a href="/Kitaplar/TumKitaplar?DevamEdenKitaplar=true">Henüz Tamamlanmayan Kitaplarım</a></li>
                        <li><a href="/Kitaplar/TumKitaplar?YayinlananKitaplar=true">Yayınlanan Kitaplarım</a></li>
                        <li><a href="/Kisi/Profil">Profil</a></li>
                        <li><a href="/Ayarlar/Ayarlar">Ayarlar</a></li>
                    }
                </ul>
            </div>



        </div>
        @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)
    </div><!-- /.container -->
</footer>

<div class="footer-after" id="gozukecekMiFooterCrypt">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-10 col-md-10 col-12">
                <p class="mb-0">©2025 Tüm hakları saklıdır. <a href="https://www.instagram.com/emin_yazilim/">Emin Yazılım</a> tarafından tasarlanmıştır.</p>
            </div>
            <!--<div class="col-lg-2 col-md-2 col-12 legal text-end">
                <a href="#" rel="nofollow">Yasal Uyarı</a>
            </div>-->
        </div>
    </div>
</div>
