@using HerkesYazarOlsun.Portal.Controllers

<input type="hidden" id="footericin" value="footer" />

@{
    string alertmesajgostermedurumu = "footer";
}


<footer id="gozukecekMiFooter">
    <div class="container">

        <div class="row">
            <div class="col-md-4">
                <a class="footer-brand" href="index.html">Herkes Yazar Olsun</a>
                <p>
                    Kitap yazarları bir arada topladığımız platformumuzda aynı zamanda, yazarlarımıza anlaşmalı yayın evi sponsorlarıız ile
                    daha uygun maliyetli kitaplarını yayınlayabilecek köprü kuruyoruz. Haydi sizde bu köprüden geçiniz.
                </p>
                <ul class="list-inline list-unstyled social-networks">

                    <li>
                        <a href="https://x.com/kayamansur61">
                            <div class="icon-social icon-social-twitter normal">
                                <i class="fa fa-twitter"></i>
                            </div>
                            <div class="icon-social hover">
                                <i class="fa fa-twitter"></i>
                            </div>
                        </a>
                    </li>



                    <li>
                        @* target="_blank" *@
                        <a href="https://www.youtube.com/%40eminyazilim">
                            <div class="icon-social icon-social-youtube normal">
                                <i class="fa fa-youtube-play"></i>
                            </div>
                            <div class="icon-social hover">
                                <i class="fa fa-youtube-play"></i>
                            </div>
                        </a>
                    </li>

                    <li>
                        <a href="https://www.linkedin.com/in/mansur-emin-kaya-b61100141/">
                            <div class="icon-social icon-social-linkedin normal">
                                <i class="fa fa-linkedin"></i>
                            </div>
                            <div class="icon-social hover">
                                <i class="fa fa-linkedin"></i>
                            </div>
                        </a>
                    </li>


                </ul>
            </div>
            <div class="col-md-4">
                <h3>İLETİŞİM</h3>
                <address>                  
                    <i class="fa fa-envelope"></i> info@herkesyazarolsun.com.tr
                </address>
            </div>


            <div class="col-lg-3 col-md-4">
    <h3>Haberdar Olunuz</h3>
    <p>Mailinizi Girerek Geliştirmelerden Sizleri Anında Haberdar Edelim</p>
    <div class="input-group">
        <input type="email" placeholder="Email" id="footerEmail" class="form-control">
        <span class="input-group-btn">
            <button type="button" class="btn btn-primary" id="haberdarBtn">
                Haber Ver
            </button>
        </span>
    </div>
</div>

        </div><!-- /.row -->
        @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)
    </div><!-- /.container -->
</footer>

<div class="footer-after" id="gozukecekMiFooterCrypt">
    <div class="container">
        <div class="row">
            <p class="col-md-10">©2025 Tüm hakları saklıdır. <a href="https://www.instagram.com/eminyazilim/">Emin Yazılım</a> tarafından tasarlanmıştır.</p>
            <p class="col-md-2 legal"><a href="#" rel="nofollow">Yasal Uyarı</a></p>
        </div><!-- /.row -->
    </div>
</div>

<script>
    $(function () {
        var footer = $("#footericin").val();

        $("#haberdarBtn").on("click", function () {
            var mail = $("#footerEmail").val().trim();

            console.log("HaberdarEt :", mail);

            if (!mail) {
                $("#uyari-" + footer).show().find("#mesaj").text("Mail bilginiz boş bırakmayınız.");
                $("#bilgi-" + footer).hide();
                $("#basarili-" + footer).hide();
                return;
            }

            $.post("@Url.Action(nameof(EmailController.MailBilgilendirme), "Email")",
                {
                    kime: mail,
                    konu: "Herkes Yazar Olsun Bülteni",
                    mesaj: "Herkes Yazar Olsun Bültenlerinden, anlık geliştirmelerden sizleri de bilgilendireceğiz.\nİlginiz için teşekkür ederiz"
                }
            ).done(function (data) {
                if (data.state === 1) {
                    $("#basarili-" + footer).show().find("#mesaj").text(data.message);
                    $("#bilgi-" + footer).hide();
                    $("#uyari-" + footer).hide();
                    $("#footerEmail").val("");
                }
                else if (data.state === 3) {
                    $("#bilgi-" + footer).show().find("#mesaj").text(data.message);
                    $("#basarili-" + footer).hide();
                    $("#uyari-" + footer).hide();
                }
                else {
                    $("#uyari-" + footer).show().find("#mesaj").text(data.message);
                    $("#bilgi-" + footer).hide();
                    $("#basarili-" + footer).hide();
                }
            }).fail(function () {
                $("#uyari-" + footer).show().find("#mesaj").text("Bir hata oluştu, lütfen tekrar deneyin.");
                $("#bilgi-" + footer).hide();
                $("#basarili-" + footer).hide();
            });
        });
    });
</script>
