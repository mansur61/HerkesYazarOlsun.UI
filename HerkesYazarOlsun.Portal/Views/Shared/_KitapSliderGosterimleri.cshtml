@model List<HerkesYazarOlsun.Model.Entity.Books>
<!-- Carousel container -->
<div id="my-pics" class="carousel slide" data-ride="carousel" style="width:%100;margin:10px auto;background-color:aliceblue;">

    @{
        int sliderdaGosterilecekKayit = 3;
        int kalan = (@Model.Count() % sliderdaGosterilecekKayit);
        int bolum = (@Model.Count() / sliderdaGosterilecekKayit);

        int sliderSayisi = (@kalan == 0) ? bolum : (@bolum + 1);
    }

    <!-- Indicators -->
    <ol class="carousel-indicators">
        @for (int i = 0; i < @sliderSayisi; i++)
        {
            @if (i == 0)
            {
                <li data-target="#my-pics" data-slide-to="@i" class="active"></li>
            }
            else
            {
                <li data-target="#my-pics" data-slide-to="@i"></li>
            }
        }
        @*<li data-target="#my-pics" data-slide-to="0" class="active"></li>
        <li data-target="#my-pics" data-slide-to="1"></li>
        <li data-target="#my-pics" data-slide-to="2"></li>*@
    </ol>

    <!-- Content -->
    <div class="carousel-inner" role="listbox">

        @for (int i = 0; i < @sliderSayisi; i++)
        {
            @if (i == 0)
            {
                <div class="item active">

                    @foreach (var itemVeriler in @Model.Where(p => p.ID <= sliderdaGosterilecekKayit).ToList())
                    {
                        @Html.Partial("_CarouselItem",@itemVeriler)

                    }
                </div>
            }
            else
            {
                <div class="item">

                    @foreach (var itemVeriler in @Model.Where(p => p.ID > sliderdaGosterilecekKayit).ToList())
                    {
                        @Html.Partial("_CarouselItem",@itemVeriler)

                    }
                </div>
            }

        }
    </div>

    <!-- Previous/Next controls -->
    <a class="left carousel-control" href="#my-pics"  role="button" data-slide="prev">
        <span class="icon-prev" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>
    </a>
    <a class="right carousel-control" href="#my-pics" role="button" data-slide="next">
        <span class="icon-next" aria-hidden="true"></span>
        <span class="sr-only">Next</span>
    </a>

</div>

