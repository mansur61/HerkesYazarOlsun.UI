@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;
@using HerkesYazarOlsun.Portal.Helpers.Extensions; 
@using HerkesYazarOlsun.Model.Utils;

@{
    string isGozlemciMod = User.GetGozlemciMod();
}

    <link href="~/lib/css/kitap_slider_gosterimleri.css"  rel="stylesheet" /> 


<div class="owl-carousel kitap-slider" id="owl-@Model.Tip">

@foreach (var kitap in Model.VMBooksList)
{
   <div class="item">
       @Html.Partial("_KitaplarItem",
        new HerkesYazarOlsun.Model.ViewModel.VM_KitapItem {
            Book = kitap,
            Tip = Model.Tip,
            isAnaSayfa = Model.isAnaSayfa,
            LoginUserId = (int)ViewBag.LOGIN_USER_ID, 
            IsGozlemci = isGozlemciMod
        })

    </div>
}

</div>

@Html.Partial("_AlertMesaj", Model.Tip)
