@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS;
@using HerkesYazarOlsun.Model.Utils;
@using HerkesYazarOlsun.Model.ViewModel;
@using HerkesYazarOlsun.Portal.Controllers;

@{
    //Model.kitapSliderYometimAdi = "index";
    //int sliderSayisi = 0;

    int sliderdaGosterilecekKayit = 5;
    Model.End = sliderdaGosterilecekKayit;
    int kalan = (@Model.VMBooksList.Count() % sliderdaGosterilecekKayit);
    int bolum = (@Model.VMBooksList.Count() / sliderdaGosterilecekKayit);

    int sliderSayisi = (@kalan == 0) ? bolum : (@bolum + 1);
    int start = 0;
    // int end = 5;


    Model.sliderdaGosterilecekKayit = @sliderdaGosterilecekKayit;
    Model.Start = @start;
}

@*@Html.Partial("_KitapSliderItemYonetimleri",@Model)*@

<div id="my-pics-@Model.Tip" class="carousel slide" data-ride="carousel"
     style="width:1050px;margin:5px auto;background-color:aliceblue;height:430px">
   @*  <p>@Model.isAnaSayfa</p> *@

    <ol class="carousel-indicators">
        @for (int i = 0; i < @sliderSayisi; i++)
        {
            @if (i == 0)
            {
                <li data-target="#my-pics-@Model.Tip" data-slide-to="@i" class="active"></li>
            }
            else
            {
                <li data-target="#my-pics-@Model.Tip" data-slide-to="@i"></li>
            }
        }
    </ol>

    <!-- Content -->
    <div class="carousel-inner" role="listbox" style="width:100%">

        @*@Html.Partial("Kitaplar",@Model)*@
        @*@Html.Partial("_PaginationButonlar",@Model.vM_PAGINATION_BUTTONS)*@

        @for (int i = 0; i < @sliderSayisi; i++)
        {

            @if (i == 0)
            {

                <div class="item active">

                    @Html.Partial("_KitaplarItem", @Model)

                </div>
            }
            else
            {
                <div class="item">

                    @Html.Partial("_KitaplarItem", @Model)

                </div>
            }

        }


    </div>

    <!-- Previous/Next controls -->
    <a class="left carousel-control" style="width:80px;color:forestgreen" href="#my-pics-@Model.Tip" role="button" data-slide="prev">
        <span class="icon-prev" aria-hidden="true"></span>
        <span class="sr-only">Previous</span>

    </a>
    <a class="right carousel-control" href="#my-pics-@Model.Tip" style="width:80px;color:forestgreen" role="button" data-slide="next">
        <span class="icon-next" aria-hidden="true"></span>
        <span class="sr-only">Next</span>

    </a>
</div>



@Html.Partial("_AlertMesaj", @Model.Tip)
