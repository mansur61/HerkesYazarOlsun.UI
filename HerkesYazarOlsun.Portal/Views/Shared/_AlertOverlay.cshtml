
<div id="alertOverlay" style="
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,0.55);
    z-index:99999;
    backdrop-filter:blur(2px);
">
    <div id="alertBox" style="
        width:360px;
        margin:15% auto;
        background:white;
        border-radius:12px;
        padding:20px;
        box-shadow:0 6px 20px rgba(0,0,0,0.25);
        text-align:center;
        font-family:Arial;
    ">
        <div id="alertMessage" style="font-size:16px; margin-bottom:20px;"></div>

        <button id="alertOkBtn" style="
            padding:10px 30px;
            background:#3498db;
            color:white;
            border:none;
            border-radius:6px;
            cursor:pointer;
            font-size:15px;
        ">
            Tamam
        </button>
    </div>
</div>
