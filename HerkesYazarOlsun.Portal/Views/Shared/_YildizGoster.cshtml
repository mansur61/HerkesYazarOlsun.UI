@model HerkesYazarOlsun.Model.ViewModel.VM_Stars


@functions {
    private string GetDominantStar(HerkesYazarOlsun.Model.ViewModel.VM_Stars stars)
    {
        var values = new Dictionary<string, int>
        {
            { "yildiz1", stars.BirStarToplam },
            { "yildiz2", stars.IkiStarToplam },
            { "yildiz3", stars.UcStarToplam },
            { "yildiz4", stars.DortStarToplam },
            { "yildiz5", stars.BesStarToplam }
        };
        if (values.All(v => v.Value == 0))
            return "yildiz0";

        int maxValue = values.Max(v => v.Value);
        var maxItems = values.Where(v => v.Value == maxValue).ToList();

        if (maxItems.Count > 1)
            return "yildiz5";

        return maxItems.First().Key;
    }
}

@{
    // HangiStar otomatik hesaplanıyor
    var dominant = GetDominantStar(Model);
}

@if (@Model.isToplam)
{

    <h5>
        <i class="price-text-color fa fa-star"> </i>
        &nbsp;<strong>(@Model.BirStarToplam) </strong>
    </h5>
    <h5>

        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        &nbsp;<strong>(@Model.IkiStarToplam) </strong>
    </h5>
    <h5>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        &nbsp;<strong>(@Model.UcStarToplam) </strong>
    </h5>
    <h5>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        &nbsp;<strong>(@Model.DortStarToplam) </strong>
    </h5>
    <h5>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        &nbsp;<strong>(@Model.BesStarToplam) </strong>
    </h5>
}
else
{
    @if (dominant == "yildiz1")
    {
        @* <i class="price-text-color fa fa-star"> </i> *@
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>

    }
    else @if (dominant == "yildiz2")
    {
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>

    }
    else  @if (dominant == "yildiz3")
    {
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i> 

        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>
       
    }
    else  @if (dominant == "yildiz4")
    {
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="fa fa-star text-secondary"></i> 
    }
    else @if (dominant == "yildiz5")
    {
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
        <i class="price-text-color fa fa-star"> </i>
    }
    else
    {
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>
        <i class="fa fa-star text-secondary"></i>

    }

}
