@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;
@using HerkesYazarOlsun.Model.Entity
@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Portal.Controllers;
@using HerkesYazarOlsun.Portal.Helpers.Extensions

@{
    int gosterilecekKayit = Model.sliderdaGosterilecekKayit ?? 5;
    int start = Model.Start ?? 0;
    int end = (Model.Start  ?? 0)+ gosterilecekKayit;
    var booksList = Model.VMBooksList?.Skip(start).Take(gosterilecekKayit).ToList();//OrderByDescending(p => p.ID).
}

@{
    string isGozlemciMod = User.GetGozlemciMod();
}


@foreach (var item in booksList.Select((value, index) => new { value, index }))
{ 
    <input type="hidden" value="@item.index">
    <input type="hidden" value="@item.value.ID" name="kId">

    <div class="col-lg-4 col-md-6 col-sm-6" style="border: 1px dotted blue;height:auto;width:200px;margin:5px 5px;padding:5px">
        <div class="product__item" style="overflow:hidden;height:360px">
            
            @* style="background-image:url('@backgroundImage')" @backgroundImage*@
            <div class="product__item__pic set-bg" data-setbg="https://herkesyazarolsun.com.tr/Belgeler/@item.value.ONKAPAKFOTOPATH">
                @if (!string.IsNullOrEmpty(@item.value.Categori.Name))
                {
                    <div class="discount-badge" style="position:absolute; top:10px; left:10px; background-color:lightgreen; color:white; padding:5px 10px; font-size:12px; font-weight:bold; border-radius:5px;">
                        @item.value.Categori.Name
                    </div>
                }

                <ul class="product__item__pic__hover">
                    @if (isGozlemciMod == "0")
                    {
                        
                        <li><a onclick='KitabiFavorilereEkle("@StringCipher.Encrypt(@item.value.ID.ToString())", "@Model.Tip")'><i class="fa fa-heart"></i></a></li>
                        @if (!(@Model.isAnaSayfa ?? false)) // ana sayfadan gelemeyecek
                        {
                           
                            if (@item.value.YazarId == @ViewBag.LOGIN_USER_ID) //ilgili giriş yapan kullanıcı yayına gönderebilir veya editlesin
                            {
                                @if ((@item.value.TAMAMLANDIMI))
                                {
                                    @* var yayinAyr = @ViewBag.YayinAyar as YayinAyarlari; *@
                                   
                                    var yayinAyr = (ViewBag.YayinAyar != null && ViewBag.YayinAyar.Count > 0)
                                        ? ViewBag.YayinAyar
                                        : item.value.Categori?.CategoryYayinAyarlari;
                                     

                                    if (yayinAyr != null)
                                    {
                                        
                                        if (@item.value.iSTATISTIK.ToplamBegeni >= yayinAyr.ToplamBegeni
                                        && @item.value.iSTATISTIK.ToplamYorum >= yayinAyr.ToplamYorum
                                        && @item.value.iSTATISTIK.ToplamYildiz >= yayinAyr.ToplamYildiz
                                        && @item.value.iSTATISTIK.ToplamDegerlendirme >= yayinAyr.ToplamDegerlendirme)
                                        {
                                            <li>
                                                <a onclick='KitabiYayinaGonder("@StringCipher.Encrypt(@item.value.ID.ToString())","@Model.Tip")'>
                                                    <i class="fa fa-share"></i>
                                                </a>
                                            </li>
                                        }
                                    }


                                }
                                @* <li><a href="/Kitaplar/KitapGuncelleme?kitap_id=@StringCipher.Encrypt(@item.value.ID.ToString())"><i class="fa fa-edit"></i></a></li> *@
                            }
                           
                        }

                    }

                    <li><a href="/Kisi/Profil?pId=@StringCipher.Encrypt(@item.value.YazarId.ToString())"><i class="fa fa-user"></i></a></li>
                </ul>
            </div>
            <div class="product__item__text" style="height:auto">
                <h6><a href="/Kitaplar/KitapDetay?kitap_id=@StringCipher.Encrypt(@item.value.ID.ToString())">@item.value.Name</a></h6>
                <div class="row">
                    <div class="rating hidden-sm col-sm-7">
                        @* @for (int i = 0; i < @item.value.Stars.EnFazlaSitar; i++)
                        {
                            <i class="price-text-color fa fa-star"></i>
                        } *@
                        @{
                            var maxStar =   0;
                            if (item.value.BooksStars != null && item.value.BooksStars.Count > 0)
                            {
                                maxStar = item.value.BooksStars.Max(x => x.StarPuani);
                            }
                           
                        }

                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= maxStar)
                            {
                               @*  <i class="fa fa-star text-warning"></i>  *@
                                <i class="price-text-color fa fa-star"></i>
                            }
                            else
                            {
                                <i class="fa fa-star text-secondary"></i>  
                            }
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
}

@{
    Model.Start += gosterilecekKayit;
}


<script>
    function KitabiFavorilereEkle(kitapId, tip) {
        console.log("tip: " + tip);
        $.post("@Url.Action(nameof(KitaplarController.KitabiFavorilereEkle), "Kitaplar")", { "id": kitapId }, function (data) {
            if (data.state == 1) {
                $("#basarili-" + tip).css("display", "block");
                $("#basarili-" + tip + " #mesaj").html("Favorilerinize eklendi");
            } else {
                $("#uyari-" + tip).css("display", "block");
                $("#uyari-" + tip + " #mesaj").html(data.message);
            }
        });
    }

    function KitabiYayinaGonder(kitapId, tip) {
        console.log("tip: " + tip);
        console.log("kitapId: " + kitapId);
        $.post("@Url.Action(nameof(KitaplarController.KitabiYayinaGonder), "Kitaplar")", { "kitapid": kitapId }, function (data) {
            console.log("data: " + data.state);
            if (data.state == 1) {
                $("#basarili-" + tip).css("display", "block");
                $("#uyari-" + tip + " #mesaj").html("Tebrikler. Kitabınızı yayına alabilirsiniz. Bunun için ödeme sayfasına yönlendirileceksiniz.");
                setTimeout(function () {
                    window.location.href = "/OdemeSayfasi/Odeme?kitapId=" + kitapId;
                }, 3000);
            } else {
                $("#uyari-" + tip).css("display", "block");
                $("#uyari-" + tip + " #mesaj").html(data.message);
                 
            }
        });
    }


</script>
