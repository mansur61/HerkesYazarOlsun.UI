@model HerkesYazarOlsun.Model.ViewModel.VM_BOOKS_DETAIL;

@using HerkesYazarOlsun.Model.Entity
@using HerkesYazarOlsun.Model.Utils
@using HerkesYazarOlsun.Portal.Controllers;
@using HerkesYazarOlsun.Portal.Helpers.Extensions
 

@{
    string isGozlemciMod = User.GetGozlemciMod();
}

<link href="~/lib/css/kitaplar_item.css"  rel="stylesheet" />

@foreach (var item in Model.VMBooksList)
{
    <div class="item">
        <div class="books-wrapper">

            <input type="hidden" value="@item.ID" name="kId" />

            <div class="book-item">

                <div class="product__item">

                    <div class="product__item__pic set-bg"
                         data-setbg="https://herkesyazarolsun.com.tr/Belgeler/@item.ONKAPAKFOTOPATH">

                        @if (!string.IsNullOrEmpty(item.Categori?.Name))
                        {
                            <div class="discount-badge">
                                @item.Categori.Name
                            </div>
                        }

                        <ul class="product__item__pic__hover">
                            @if (isGozlemciMod == "0")
                            {
                                <li>
                                    <a onclick='KitabiFavorilereEkle(this,"@StringCipher.Encrypt(item.ID.ToString())","@Model.Tip")'>
                                        <i class="fa fa-heart"></i>
                                    </a>
                                </li>
                            }

                            <li>
                                <a href="/Kisi/Profil?pId=@StringCipher.Encrypt(item.YazarId.ToString())">
                                    <i class="fa fa-user"></i>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="product__item__text">
                        <h6>
                            <a href="/Kitaplar/KitapDetay?kitap_id=@StringCipher.Encrypt(item.ID.ToString())">
                                @item.Name
                            </a>
                        </h6>
                    </div>

                </div>
            </div>
        </div>
    </div>
}
<script>

    function KitabiFavorilereEkle(btn, kitapId, tip) {
        const originalIcon = btn.innerHTML; // eski ikon
        console.log("tip: " + tip);
        btn.innerHTML = '<i class="fa fa-spinner fa-spin text-primary"></i>'; 

        $.post(
            "@Url.Action(nameof(KitaplarController.KitabiFavorilereEkle), "Kitaplar")",
            { "id": kitapId },
            function (data) {
                setTimeout(() => {   }, 200); // 200ms beklet
                // Ajax tamamlanınca eski ikon geri dönsün
                btn.innerHTML = originalIcon;

                if (data.state == 1) {
                    $("#basarili-" + tip).css("display", "block");
                    $("#basarili-" + tip + " #mesaj").html("Favorilerinize eklendi");
                } else {
                    $("#uyari-" + tip).css("display", "block");
                    $("#uyari-" + tip + " #mesaj").html(data.message);
                }
            }
        ).fail(function () {
            btn.innerHTML = originalIcon;
            $("#uyari-" + tip).css("display", "block");
            $("#uyari-" + tip + " #mesaj").html("Sunucu hatası.");
        });
    }

 
    function KitabiYayinaGonder(kitapId, tip) {
        console.log("tip: " + tip);
        console.log("kitapId: " + kitapId);
        $.post("@Url.Action(nameof(KitaplarController.KitabiYayinaGonder), "Kitaplar")", { "kitapid": kitapId }, function (data) {
            console.log("data: " + data.state);
            if (data.state == 1) {
                $("#basarili-" + tip).css("display", "block");
                $("#uyari-" + tip + " #mesaj").html("Tebrikler. Kitabınızı yayına alabilirsiniz. Bunun için ödeme sayfasına yönlendirileceksiniz.");
                setTimeout(function () {
                    window.location.href = "/OdemeSayfasi/Odeme?kitapId=" + kitapId;
                }, 3000);
            } else {
                $("#uyari-" + tip).css("display", "block");
                $("#uyari-" + tip + " #mesaj").html(data.message);

            }
        });
    }

     function KitabiSil(encId, tip, realId) {

          console.log("tip: " + tip);
        console.log("kitapId: " + realId);

        const btn = document.getElementById("delBtn_" + realId);
        const originalIcon = btn.innerHTML;

        Swal.fire({
            title: 'Emin misiniz?',
            text: "Bu kitabı silmek istiyor musunuz?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Evet',
            cancelButtonText: 'Hayır',
            customClass: {
                confirmButton: 'btn btn-danger',
                cancelButton: 'btn btn-secondary'
            }
        }).then((result) => {

            if (result.isConfirmed) {

                // SPINNER BAŞLASIN
                btn.innerHTML = '<i class="fa fa-spinner fa-spin text-primary"></i>';

                $.post(
                    "@Url.Action(nameof(KitaplarController.KitabiSil), "Kitaplar")",
                    { "kitapid": encId },
                    function (data) {

                        console.log("data: " + data.state);

                        // HER DURUMDA İKONU GERİ GETİR
                        btn.innerHTML = originalIcon;

                        if (data.state == 1) {

                            // Başarılı
                            $("#basarili-" + tip).css("display", "block");
                            $("#uyari-" + tip + " #mesaj").html("Kitap Silindi");

                            setTimeout(function () {
                                window.location.reload();
                            }, 3000);

                        } else {

                            // Hata
                            $("#uyari-" + tip).css("display", "block");
                            $("#uyari-" + tip + " #mesaj").html(data.message);
                        }
                    }
                )
                .fail(function () {

                    // AJAX hata verirse de ikonu geri getir
                    btn.innerHTML = originalIcon;

                    $("#uyari-" + tip).css("display", "block");
                    $("#uyari-" + tip + " #mesaj").html("Sunucu ile bağlantı kurulamadı.");
                });

            } else {
                Swal.fire("İptal Edildi", "Silme işlemi iptal edildi.", "info");
            }
        });
    }
</script>
