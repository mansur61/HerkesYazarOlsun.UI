@{
    Layout = null;
}
 @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    @{
        var tokens = Antiforgery.GetAndStoreTokens(Context);
    }
<!DOCTYPE html>
<html lang="en">
     
<head>
     <meta name="csrf-token" content="@tokens.RequestToken" />
    <meta charset="utf-8">
    <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Herkes Yazar Olsun</title>
     

    <!-- Font Awesome -->
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet" />
    <!-- Bootstrap core CSS -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Owl Carousel CSS -->
    <link href="~/lib/owlcarousel/dist/assets/owl.carousel.min.css" rel="stylesheet" />
    <!-- Nice Select CSS -->
    <link href="~/lib/nice-select/css/nice-select.css" rel="stylesheet" />
    <!-- noUiSlider CSS -->
    <link href="~/lib/nouislider/nouislider.min.css" rel="stylesheet" />
    
    
    @RenderSection("Styles",false) 
    <!-- Custom CSS (if any) 
    <link href="~/css/herkesyazarolsun-bootstrap.css" rel="stylesheet" />
    <link href="~/css/herkesyazarolsun_style.css" rel="stylesheet" />
-->
    <!-- jQuery -->
    <script src="~/lib/jquery/jquery.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Owl Carousel JS -->
    <script src="~/lib/owlcarousel/dist/owl.carousel.min.js"></script>
    <!-- Nice Select JS -->
    <script src="~/lib/nice-select/js/jquery.nice-select.min.js"></script>
    <!-- noUiSlider JS -->
    <script src="~/lib/nouislider/nouislider.min.js"></script>
     
    
    @RenderSection("scripts",false)

    <style>
        .col-item {
            border: 1px solid #E1E1E1;
            border-radius: 5px;
            background: #FFF;
        }

            .col-item .photo img {
                margin: 0 auto;
                width: 100%;
            }

            .col-item .info {
                padding: 10px;
                border-radius: 0 0 5px 5px;
                margin-top: 1px;
            }

            .col-item:hover .info {
                background-color: #F5F5DC;
            }

            .col-item .price {
                /*width: 50%;*/
                float: left;
                margin-top: 5px;
            }

                .col-item .price h5 {
                    line-height: 20px;
                    margin: 0;
                }

        .price-text-color {
            color: #219FD1;
        }

        .col-item .info .rating {
            color: #777;
        }

        .col-item .rating {
            /*width: 50%;*/
            float: left;
            font-size: 17px;
            text-align: right;
            line-height: 52px;
            margin-bottom: 10px;
            height: 52px;
        }

        .col-item .separator {
            border-top: 1px solid #E1E1E1;
        }

        .clear-left {
            clear: left;
        }

        .col-item .separator p {
            line-height: 20px;
            margin-bottom: 0;
            margin-top: 10px;
            text-align: center;
        }

            .col-item .separator p i {
                margin-right: 5px;
            }

        .col-item .btn-add {
            width: 50%;
            float: left;
        }

        .col-item .btn-add {
            border-right: 1px solid #E1E1E1;
        }

        .col-item .btn-details {
            width: 50%;
            float: left;
            padding-left: 10px;
        }

        .controls {
            margin-top: 20px;
        }

        [data-slide="prev"] {
            margin-right: 10px;
        }


        /* ============================
           ALERT MESAJ KUTULARI
        ============================ */
        .alert-success,
        #basarili-register,
        #basarili-logingiris {
            background: #e8fff7 !important;
            border-left: 6px solid #00C9A7;
            padding: 15px;
        }

        .alert-warning,
        #bilgi-register,
        #bilgi-logingiris {
            background: #fff8e6 !important;
            border-left: 6px solid #ffcc00;
        }

        .alert-danger,
        #uyari-register,
        #uyari-logingiris {
            background: #ffe8e8 !important;
            border-left: 6px solid #e63946;
        }

    </style>
    <link rel="icon" type="image/png" href="@Url.Content( "~/img/stack-of-books.png")" />
     

   
   
     
</head>
<body>
    @if (ViewBag.NavbarGoster != false)
    {
        @Html.Partial("_Navbar")
    }
    <br />
    <div class="container">
        @RenderBody()

    </div>
    @if (ViewBag.FooterGoster != false)
    {
        @Html.Partial("_Footer")
    }
    
   @Html.AntiForgeryToken()

    <script>
    $(function() {
        // Öncelikli olarak formdaki __RequestVerificationToken input'unu kontrol et
        let tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        
        let csrfToken = null;

        if (tokenInput && tokenInput.value) {
            csrfToken = tokenInput.value;
             //console.log("Token formdan alındı:", csrfToken);
        } else {
            // Formda yoksa layout'tan alın
            csrfToken = '@tokens.RequestToken';
            //console.log("Token layout'tan alındı: Form a ekle otomatik", csrfToken);

            // Formlarda eksikse, hidden input olarak ekle
            $('form').each(function() {
                if ($(this).find('input[name="__RequestVerificationToken"]').length === 0) {
                    $('<input>').attr({
                        type: 'hidden',
                        name: '__RequestVerificationToken',
                        value: csrfToken
                    }).appendTo(this);
                }
            });
        }

        // Tüm AJAX çağrılarına token ekle
        $.ajaxSetup({
            headers: { 'RequestVerificationToken': csrfToken }
        });

        // Test
        console.log("AJAX ve form token hazır:", csrfToken);
    });
</script>


</body>
</html>
