@using HerkesYazarOlsun.Model.ViewModel


@if (ViewBag.Duyurular != null && ViewBag.Duyurular.Count > 0)
{
    <div id="myCarousel"
     class="carousel slide"
     data-bs-ride="carousel"
     data-bs-interval="3000"
     style="height:450px">


        <!-- Indicators -->
        <div class="carousel-indicators">
            @{
                int i = 0;
            }
            @foreach (var item in ViewBag.Duyurular)
            {
                <button type="button"
                        data-bs-target="#myCarousel"
                        data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")"
                        aria-current="@(i == 0 ? "true" : "false")">
                </button>
                i++;
            }
        </div>

        <!-- Slides -->
        <div class="carousel-inner h-100">
            @{
                int index = 0;
            }
            @foreach (var item in ViewBag.Duyurular)
            {
                var duyuruItem = item as VM_CAROUSEL_DUYURU;

                <div class="carousel-item @(index == 0 ? "active" : "") h-100">
                    <div class="d-flex align-items-center justify-content-center h-100 text-white"
                         style="@(string.IsNullOrWhiteSpace(duyuruItem?.RENK)
                         ? "background-image:url('/lib/img/slide/slide1.png'); background-size:cover;"
                         : $"background-color:{duyuruItem.RENK};")">
                        <h2>@duyuruItem?.ICERIK</h2>
                    </div>
                </div>

                index++;
            }
        </div>

        <!-- Controls -->
        <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
}
else
{
   <div id="myCarousel"
     class="carousel slide"
     data-bs-ride="carousel"
     data-bs-interval="3000"
     style="height:450px"> 

    <div class="carousel-inner h-100">

        <div class="carousel-item active h-100">
            <div class="d-flex h-100 align-items-center justify-content-center bg-dark text-white">
             
                <h2>Henüz bir duyuru yoktur</h2>
            </div>
        </div>
        </div>

     
</div>


}
