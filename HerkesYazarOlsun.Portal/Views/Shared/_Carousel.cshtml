@using HerkesYazarOlsun.Model.ViewModel

<br />

@{
    int index = 0;
}

@if (@ViewBag.Duyurular != null && @ViewBag.Duyurular.Count > 0)
{

    <div id="myCarousel" class="carousel slide" data-ride="carousel" style="height: 450px">
        <!-- Indicators -->
        <ol class="carousel-indicators">
            @foreach (var item in ViewBag.Duyurular)
            {
                <li data-target="#myCarousel" data-slide-to="@index" class="@(index == 0 ? "active" : "")"></li>
                index++;
            }
        </ol>

        <!-- Wrapper for slides -->
        <div class="carousel-inner">
            @{
                index = 0;
            }
            @foreach (var item in ViewBag.Duyurular)
            {
                var duyuruItem = item as VM_CAROUSEL_DUYURU;
                <div class="item @(index == 0 ? "active" : "")">
                    <div class="fill" style="background-image:url('~/lib/img/slide/slide1.png');"></div>
                    <div class="carousel-caption">
                        <h2>@duyuruItem?.ICERIK</h2>
                    </div>
                </div>
                index++;
            }
        </div>

        <!-- Controls -->
        <a class="left carousel-control" href="#myCarousel" data-slide="prev">
            <i class="fa fa-angle-left"></i>
        </a>
        <a class="right carousel-control" href="#myCarousel" data-slide="next">
            <i class="fa fa-angle-right"></i>
        </a>
    </div>
}
else
{
    <div id="myCarousel" class="carousel slide" style="height:450px">
        <!-- Wrapper for slides -->
        <div class="carousel-inner">
            <div class="item active">
                <div class="fill" style="background-image:url('~/lib/img/slide/slide1.png');"></div>
                <div class="carousel-caption">
                    <h2>Henüz bir duyuru yoktur</h2>
                </div>
            </div>

        </div>
    </div>
}
