@{
    ViewData["Title"] = "Sms Doğrulama";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
 
@using HerkesYazarOlsun.Portal.Controllers;

 
@{
    string tip = "email";
}
<input type="hidden" id="tip" value="@tip" />

@section Styles {
    <link href="~/lib/css/giris_kayit_dogrulama.css" rel="stylesheet" />
}

<section  >
    <div class="container">
        <div class="row"> 
            <div class="col-lg-6 mb-4">
                <div id="title-container">
                    <h4>Herkes Yazar Olsun' da,  Sms Doğrulama İşlemi </h4>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="login_form_inner register_form_inner">
                    <h3>Sms Doğrulama</h3>


                    <div id="register_form" class="row login_form">
                        <div class="col-md-12 form-group">
                            <input type="number" class="form-control" id="sms" name="TELNO" placeholder="Telefon No" 
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Telefon No'">
                        </div>
                       
                        <div class="col-md-12 form-group">
                            <button type="submit" class="auth-primary-btn flex-fill text-center" onclick="SmsGonder()">Sms Gönder</button>
                        </div>
                    </div>
                    @Html.Partial("_AlertMesaj",@tip)

                </div>
            </div>
        </div>
    </div>
</section>

<div id="otp"></div>

<div style="height:150px"></div>

<script>
    function SmsGonder() {

        var sms = $("#sms").val();
        var tip = $("#tip").val();
