@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model HerkesYazarOlsun.Model.ViewModel.VM_USERS;
@using HerkesYazarOlsun.Portal.Controllers;
@section Styles {

    <link href="~/lib/bootstrap/dist/css/style_aroma_template.css" rel="stylesheet" />
}

<input type="hidden" id="registericin" value="register" />

@{
    string alertmesajgostermedurumu = "register";
}

<section class="login_box_area section-margin">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="login_box_img">
                    <div class="hover">
                        <h4>Herkes Yazar Olsun' da Kaydın Var Mı? </h4>
                        <p>Giriş ve Kayıt işlemlerinizi gerçekleştiriniz. Sizinle danışmaktan mutluluk duyuyaoruz.</p>
                        <a class="button button-account" href="/Account/Login">Giriş Yap</a>
                        <a class="button button-account" href="/Home/Dogrulama">Kaydınızı Doğrulayınız </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="login_form_inner register_form_inner">
                    <h3>Kayıt Olunuz</h3>


                    <div id="register_form" class="row login_form">
                        <div class="col-md-12 form-group">
                            <input type="text" class="form-control" id="username" name="USERNAME" placeholder="Kullanici Adi" asp-for="USERNAME"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Kullanici Adi'">
                        </div>
                        <div class="col-md-12 form-group">
                            <input type="number" class="form-control" id="telno" name="TELNO" placeholder="Tel No" asp-for="TELNO"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Tel No'">
                        </div>
                        <div class="col-md-12 form-group">
                            <input type="text" class="form-control" id="reg_email" name="EMAIL" placeholder="Email Adres" asp-for="EMAIL"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Email Adres'">
                        </div>
                        <div class="col-md-12 form-group">
                            <input type="text" class="form-control" id="password" name="PASSWORD" placeholder="Şifre" asp-for="PASSWORD"
                                   onfocus="this.placeholder = ''" onblur="this.placeholder = 'Şifre'">
                        </div>
                        @*<div class="col-md-12 form-group">
                        <input type="text" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Şifre Tekrar" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Şifre Tekrar'">
                        </div>*@

                        <div class="col-md-12 form-group">
                            <input type="checkbox" id="termsCheckbox">
                            <label for="termsCheckbox">
                                <a href="/Home/Sozlesme" target="_blank">Kullanıcı Sözleşmesini</a> okudum ve kabul ediyorum.
                            </label>
                        </div>


                        <div class="col-md-12 form-group">
                            <button type="submit" class="button button-register w-100" onclick="KayitOl()">Kayıt Ol</button>
                        </div>
                        <div id="loading" style="display: none; text-align: center;">
                            <img src="https://i.gifer.com/ZZ5H.gif" alt="loading..." style="width: 50px; height: 50px;" />
                        </div>
                    </div>
                    @Html.Partial("_AlertMesaj", @alertmesajgostermedurumu)

                </div>
            </div>
        </div>
    </div>
</section>
@*
@section scripts{

    <script src="~/lib/bootstrap/dist/js/main_aroma_template.js"></script>
}
*@

<script>
    function KayitOl() {

        var uername = $("#username").val();
        var email = $("#reg_email").val();
        var password = $("#password").val();
        var telno = $("#telno").val();

        var register = $("#registericin").val();
        console.log("register :" + register);
        $("#loading").css("display", "block");

        var isSozlesmeOnay = $("#termsCheckbox").is(":checked") ? 1 : 0;

        if (isSozlesmeOnay === 0) {
            $("#bilgi-" + register).css("display", "block");
            $("#bilgi-" + register + " #mesaj").html("Devam edebilmek için Kullanıcı Sözleşmesini kabul etmelisiniz.");
            $("#loading").css("display", "none");
            return;
        }

        $.post("@Url.Action(nameof(HomeController.SaveRegister), "Home")", {
            "username": uername,
            "email": email,
            "password": password,
            "telno": telno,
            "isSozlesmeOnay": isSozlesmeOnay
        }, function (data) {
            console.log(data);
            $("#loading").css("display", "none");
            if (data.state == 1) {
                $("#basarili-" + register).css("display", "block");
                $("#basarili-" + register + " #mesaj").html(data.message);

                $("#bilgi-" + register).css("display", "none");
                $("#uyari-" + register).css("display", "none");

                // setTimeout(function () {
                //     window.location.href = "/Home/Index";
                // }, 3000);
            }
            else if (data.state == 3) {
                $("#bilgi-" + register).css("display", "block");
                $("#bilgi-" + register + " #mesaj").html(data.message);

                $("#basarili-" + register).css("display", "none");
                $("#uyari-" + register).css("display", "none");
            }
            else {
                $("#uyari-" + register).css("display", "block");
                $("#bilgi-" + register).css("display", "none");
                $("#basarili-" + register).css("display", "none");
                $("#uyari-" + register + " #mesaj").html(data.message);
            }

        });


    }

    function Register_Failed() {
        alert("hata");
    }
</script>